---
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/common/SiteHeader.astro";
import AtmosphereBackground from "../../components/intro/AtmosphereBackground.astro";
import type { SupportedLang } from "../../i18n/ui";
import { useTranslations } from "../../i18n/ui";
import {
  EQUIPMENT_CATALOG,
  CATEGORIES,
  LOCATION_ZONES,
  PRESETS,
  LABOR_RATES,
  VAT_RATE,
} from "../../data/quoteConfig";
import { SITE_CONTACTS } from "../../data/contacts";
import type { EquipmentCategory } from "../../types/quote";

interface Props {
  lang: SupportedLang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const canonicalPath = lang === "en" ? "/quote" : `/${lang}/quote`;
const pageTitle = `${t("quotePageTitle")} — DJ Dima Minka`;
const pageDescription = t("quotePageSubtitle");

const categoriesOrder: EquipmentCategory[] = [
  "sound",
  "retro",
  "moving_heads",
  "wash_fx",
  "stands",
];

// Initial serializable config for the client-side calculator
const clientConfig = {
  lang,
  catalog: EQUIPMENT_CATALOG,
  categories: CATEGORIES,
  zones: LOCATION_ZONES,
  presets: PRESETS,
  rates: LABOR_RATES,
  vatRate: VAT_RATE,
  whatsappNumber: SITE_CONTACTS.whatsappRaw,
  labels: {
    copiedLink: t("quoteLinkCopied"),
    copiedJson: t("quoteJsonCopied"),
    included: t("quoteIncludedBadge"),
    addBtn: t("quoteAddBtn"),
    removeBtn: t("quoteRemoveBtn"),
    subtotalBeforeVat: t("quoteSubtotalBeforeVat"),
    vat18: t("quoteVat18"),
    grandTotal: t("quoteGrandTotal"),
  },
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  lang={lang}
  canonicalPath={canonicalPath}
>
  <!-- Dedicated typography for RU (Unbounded) and HE (Rubik) -->
  {lang === "ru" && (
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Unbounded:wght@400;500;600;700;800&display=swap"
      slot="head"
    />
  )}
  {lang === "he" && (
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700;800&display=swap"
      slot="head"
    />
  )}

  <main class="quote-viewport pt-safe pb-safe" id="quoteApp" data-config={JSON.stringify(clientConfig)}>
    <AtmosphereBackground />
    <SiteHeader lang={lang} currentSection="quote" />

    <div class="quote-container">
      <!-- 1. Header Banner -->
      <header class="quote-header">
        <div class="badge-row">
          <span class="badge-pill" id="quoteStatusBadge">{t("quoteBadge")}</span>
          <span class="badge-subtle" id="viewModeIndicator">PRODUCER / BUILDER</span>
        </div>
        <h1 class="quote-title" id="pageMainHeading">{t("quotePageTitle")}</h1>
        <p class="quote-subtitle">{t("quotePageSubtitle")}</p>
      </header>

      <!-- 2. CLIENT PRESENTATION VIEW (Shown when a quote is loaded via URL hash or previewed) -->
      <section class="client-proposal-view hidden" id="clientProposalSection">
        <div class="proposal-card">
          <div class="proposal-top-header">
            <div>
              <span class="proposal-meta-tag">{t("quoteClientViewBadge")}</span>
              <h2 class="proposal-event-name" id="propEventName">Bespoke Event Production</h2>
              <div class="proposal-event-meta">
                <span id="propVenue">Dalton Winery</span>
                <span class="sep">•</span>
                <span id="propDate">2026-10-24</span>
                <span class="sep">•</span>
                <span id="propZone">Upper Galilee</span>
              </div>
            </div>
            <button type="button" class="btn-switch-mode" id="btnEditQuote">
              <span class="icon">tune</span>
              <span>{t("quoteEditMode")}</span>
            </button>
          </div>

          <!-- Production Iceberg Meter -->
          <div class="iceberg-panel">
            <div class="iceberg-header">
              <span class="iceberg-title">{t("quoteIcebergTitle")}</span>
              <span class="iceberg-total" id="propTotalHoursVal">22.5h</span>
            </div>
            <div class="iceberg-bar">
              <div class="iceberg-segment stage" id="propStageSegment" style="width: 16%;"></div>
              <div class="iceberg-segment behind" id="propBehindSegment" style="width: 84%;"></div>
            </div>
            <div class="iceberg-legend">
              <div class="legend-item">
                <span class="dot stage"></span>
                <span>{t("quoteStageHours")}: <strong id="propStageHoursVal">3.5h</strong></span>
              </div>
              <div class="legend-item">
                <span class="dot behind"></span>
                <span>{t("quoteBehindHours")}: <strong id="propBehindHoursVal">19.0h</strong></span>
              </div>
            </div>
          </div>

          <!-- Itemized Equipment List -->
          <div class="proposal-section">
            <h3 class="section-heading">{t("quoteEquipSection")}</h3>
            <p class="section-notice">
              <span class="icon">cable</span>
              <span>{t("quoteCustomSetupNotice")}</span>
            </p>
            <div class="itemized-equipment" id="propEquipmentList">
              <!-- Dynamically rendered -->
            </div>
          </div>

          <!-- Services Breakdown -->
          <div class="proposal-section">
            <h3 class="section-heading">{t("quoteLaborSection")}</h3>
            <p class="section-notice">
              <span class="icon">music_cast</span>
              <span>{t("quoteLiveRequestsNotice")}</span>
            </p>
            <div class="services-list" id="propServicesList">
              <!-- Dynamically rendered -->
            </div>
          </div>

          <!-- Financial Summary -->
          <div class="proposal-financials">
            <div class="financial-row">
              <span>{t("quoteSubtotalBeforeVat")}</span>
              <span class="val"><bdi id="propSubtotalVal">0 ₪</bdi></span>
            </div>
            <div class="financial-row discount-row hidden" id="propDiscountRow">
              <span id="propDiscountLabel">{t("quoteDiscountLabel")}</span>
              <span class="val discount-val">- <bdi id="propDiscountVal">0 ₪</bdi></span>
            </div>
            <div class="financial-row vat-row" id="propVatRow">
              <span>{t("quoteVat18")}</span>
              <span class="val">+ <bdi id="propVatVal">0 ₪</bdi></span>
            </div>
            <div class="financial-row total-row">
              <span id="propTotalLabel">{t("quoteGrandTotal")}</span>
              <span class="grand-val"><bdi id="propGrandTotalVal">0 ₪</bdi></span>
            </div>
          </div>

          <!-- Proposal Call To Actions -->
          <div class="proposal-actions">
            <a href="#" class="btn-primary-action" id="propWhatsAppConfirmBtn" target="_blank" rel="noopener noreferrer">
              <span class="icon">check_circle</span>
              <span>{t("quoteConfirmWhatsApp")}</span>
            </a>
            <div class="aux-actions">
              <button type="button" class="btn-secondary-action" id="propShareLinkBtn">
                <span class="icon">share</span>
                <span>{t("quoteShareLink")}</span>
              </button>
              <button type="button" class="btn-secondary-action" id="propCopyJsonBtn">
                <span class="icon">content_copy</span>
                <span>{t("quoteCopyJson")}</span>
              </button>
            </div>
          </div>
        </div>
      </section>

      <!-- 3. CONSTRUCTOR / BUILDER VIEW -->
      <section class="builder-view" id="builderSection">
        <!-- Presets Row -->
        <div class="presets-bar">
          <span class="presets-label">{t("quotePresetLabel")}:</span>
          <div class="presets-pills">
            {PRESETS.map((preset) => (
              <button
                type="button"
                class={`preset-pill ${preset.featured ? "featured" : ""}`}
                data-preset-id={preset.id}
              >
                <span>{preset.name[lang]}</span>
              </button>
            ))}
          </div>
        </div>

        <div class="builder-layout">
          <!-- Left Column: Controls & Configuration Cards -->
          <div class="builder-controls">
            <!-- Event & Client Details Card -->
            <div class="control-card">
              <div class="card-header">
                <span class="icon">event</span>
                <h2>{t("quoteEventDetails")}</h2>
              </div>
              <div class="form-grid">
                <div class="form-field">
                  <label for="inputEventName">{t("quoteVenueLabel")}</label>
                  <input
                    type="text"
                    id="inputEventName"
                    placeholder="e.g. Ben Zimra Winery / Private Villa"
                    value=""
                  />
                </div>
                <div class="form-field">
                  <label for="inputClientName">{t("quoteClientNameLabel")}</label>
                  <input
                    type="text"
                    id="inputClientName"
                    placeholder="e.g. Daniel & Maya"
                    value=""
                  />
                </div>
                <div class="form-field">
                  <label for="inputEventDate">{t("quoteDateLabel")}</label>
                  <input
                    type="date"
                    id="inputEventDate"
                    value={new Date().toISOString().split("T")[0]}
                  />
                </div>
                <div class="form-field">
                  <label for="selectLocationZone">{t("quoteZoneLabel")}</label>
                  <select id="selectLocationZone">
                    {LOCATION_ZONES.map((zone) => (
                      <option value={zone.id}>
                        {zone.name[lang]} ({zone.defaultDurationMin} min)
                      </option>
                    ))}
                  </select>
                </div>
              </div>
            </div>

            <!-- Labor & Production Card -->
            <div class="control-card">
              <div class="card-header">
                <span class="icon">headphones</span>
                <h2>{t("quoteLaborSection")}</h2>
              </div>

              <!-- Live DJ Hours -->
              <div class="slider-group">
                <div class="slider-top">
                  <span class="slider-title">{t("quoteStageHours")}</span>
                  <span class="rate-badge"><bdi>{LABOR_RATES.djPerHour} ₪ / h</bdi></span>
                  <span class="slider-val" id="djHoursVal">3.5h</span>
                </div>
                <input
                  type="range"
                  id="sliderDjHours"
                  min="1"
                  max="8"
                  step="0.5"
                  value="3.5"
                />
                <div class="slider-sub">
                  <span>1h</span>
                  <span class="highlight-cost" id="djCostVal"><bdi>1,400 ₪</bdi></span>
                  <span>8h</span>
                </div>
              </div>

              <!-- Pre-Production Hours -->
              <div class="slider-group">
                <div class="slider-top">
                  <span class="slider-title">Music Pre-Production & SoundSwitch</span>
                  <span class="rate-badge"><bdi>{LABOR_RATES.preprodPerHour} ₪ / h</bdi></span>
                  <span class="slider-val" id="preprodHoursVal">5.0h</span>
                </div>
                <input
                  type="range"
                  id="sliderPreprodHours"
                  min="0"
                  max="8"
                  step="0.5"
                  value="5.0"
                />
                <div class="slider-sub">
                  <span>0h</span>
                  <span class="highlight-cost" id="preprodCostVal"><bdi>750 ₪</bdi></span>
                  <span>8h</span>
                </div>
              </div>

              <div class="callout-box">
                <span class="icon">music_cast</span>
                <p>{t("quoteLiveRequestsNotice")}</p>
              </div>
            </div>

            <!-- Equipment Catalog Card -->
            <div class="control-card">
              <div class="card-header">
                <span class="icon">light</span>
                <h2>{t("quoteEquipSection")}</h2>
              </div>

              <!-- Days multiplier selector -->
              <div class="rental-days-selector">
                <span class="field-title">{t("quoteDaysCountLabel")}:</span>
                <div class="days-toggle-group">
                  <button type="button" class="day-toggle-btn active" data-days="1">
                    <span>{t("quoteDayOne")}</span>
                    <span class="mult-tag">1.0x</span>
                  </button>
                  <button type="button" class="day-toggle-btn" data-days="2">
                    <span>{t("quoteDayWeekend")}</span>
                    <span class="mult-tag">1.6x</span>
                  </button>
                </div>
              </div>

              <div class="callout-box">
                <span class="icon">cable</span>
                <p>{t("quoteCustomSetupNotice")}</p>
              </div>

              <!-- Equipment Categories Accordion / Lists -->
              <div class="catalog-categories">
                {categoriesOrder.map((catKey) => {
                  const catItems = EQUIPMENT_CATALOG.filter((i) => i.category === catKey);
                  return (
                    <div class="category-block">
                      <div class="category-header">
                        <span class="category-title">{CATEGORIES[catKey][lang]}</span>
                        <span class="category-count">{catItems.length} items</span>
                      </div>
                      <div class="items-list">
                        {catItems.map((item) => {
                          const isMandatory = item.id === 'denon_prime' || item.id === 'udg_stand';
                          return (
                            <div class={`item-row ${isMandatory ? 'mandatory-item' : ''}`} data-item-id={item.id} data-price={item.dailyRentalPrice}>
                              <div class="item-info">
                                <span class="item-name">{item.name[lang]}</span>
                                <span class="item-rate">
                                  <bdi>{item.dailyRentalPrice} ₪</bdi> / day
                                </span>
                              </div>
                              <div class="item-toggle-action">
                                {isMandatory ? (
                                  <span class="badge-mandatory" title={t("quoteAlwaysIncluded")}>
                                    <span class="icon">lock</span>
                                    <span>{t("quoteIncludedBadge")}</span>
                                  </span>
                                ) : (
                                  <button
                                    type="button"
                                    class="toggle-equip-btn active"
                                    data-id={item.id}
                                    data-qty={item.defaultQty}
                                    aria-pressed="true"
                                  >
                                    <span class="toggle-icon">check</span>
                                    <span class="toggle-text">{t("quoteRemoveBtn")}</span>
                                  </button>
                                )}
                              </div>
                            </div>
                          );
                        })}
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>

            <!-- Logistics & Setup Card -->
            <div class="control-card">
              <div class="card-header">
                <span class="icon">local_shipping</span>
                <h2>{t("quoteLogisticsSection")}</h2>
              </div>

              <!-- Trips Selector -->
              <div class="trips-selector-block">
                <span class="field-title">{t("quoteTripsCountLabel")}:</span>
                <div class="trips-toggle-group">
                  <button type="button" class="trip-toggle-btn active" data-trips="1">
                    <span class="trip-badge">1×</span>
                    <span>{t("quoteTripOne")}</span>
                  </button>
                  <button type="button" class="trip-toggle-btn" data-trips="2">
                    <span class="trip-badge">2×</span>
                    <span>{t("quoteTripTwo")}</span>
                  </button>
                  <button type="button" class="trip-toggle-btn" data-trips="3">
                    <span class="trip-badge">3×</span>
                    <span>{t("quoteTripThree")}</span>
                  </button>
                </div>
              </div>

              <div class="form-grid">
                <div class="form-field">
                  <label for="inputSetupFee">{t("quoteSetupFeeLabel")}</label>
                  <input
                    type="number"
                    id="inputSetupFee"
                    min="0"
                    step="50"
                    value="500"
                  />
                  <span class="field-hint">{t("quoteSetupFeeHint")}</span>
                </div>
                <div class="form-field">
                  <label>{t("quoteLogisticsFeeLabel")}</label>
                  <div class="computed-logistics-box">
                    <span class="computed-val" id="computedLogisticsVal"><bdi>100 ₪</bdi></span>
                    <span class="computed-calc-hint" id="computedLogisticsHint">1 trip × 100 ₪</span>
                  </div>
                  <span class="field-hint">{t("quoteLogisticsFeeHint")}</span>
                </div>
              </div>
            </div>

            <!-- Financial Settings (Discount & VAT) Card -->
            <div class="control-card">
              <div class="card-header">
                <span class="icon">payments</span>
                <h2>{t("quoteFinancialsSection")}</h2>
              </div>

              <!-- Discount Configuration -->
              <div class="discount-block">
                <span class="field-title">{t("quoteDiscountLabel")}:</span>
                <div class="discount-type-tabs">
                  <button type="button" class="tab-btn" data-type="percentage">
                    {t("quoteDiscountPercent")}
                  </button>
                  <button type="button" class="tab-btn" data-type="fixed">
                    {t("quoteDiscountFixed")}
                  </button>
                </div>
                <div class="discount-inputs hidden" id="discountInputsRow">
                  <div class="form-field">
                    <label for="inputDiscountVal" id="discountValLabel">{t("quoteDiscountValLabel")}</label>
                    <input type="number" id="inputDiscountVal" min="0" value="10" />
                  </div>
                  <div class="form-field">
                    <label for="inputDiscountReason">{t("quoteDiscountReasonLabel")}</label>
                    <input
                      type="text"
                      id="inputDiscountReason"
                      placeholder={t("quoteDiscountReasonPlaceholder")}
                    />
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Right Column: Sticky Live Receipt & Actions -->
          <aside class="builder-receipt-col">
            <div class="receipt-card sticky-receipt">
              <div class="receipt-header">
                <span class="receipt-badge">{t("quoteLiveEstimateBadge")}</span>
                <h3 class="receipt-title">{t("quoteSummaryTitle")}</h3>
              </div>

              <!-- Iceberg Indicator inside Receipt -->
              <div class="receipt-iceberg">
                <div class="iceberg-top">
                  <span>{t("quoteTotalHours")}: <strong id="recTotalHours">22.5h</strong></span>
                  <span class="iceberg-ratio">1 : 5.4</span>
                </div>
                <div class="iceberg-bar">
                  <div class="iceberg-segment stage" id="recStageBar" style="width: 16%;"></div>
                  <div class="iceberg-segment behind" id="recBehindBar" style="width: 84%;"></div>
                </div>
                <div class="iceberg-legend">
                  <span class="tag-stage">{t("quoteStageHours")}: <strong id="recStageHours">3.5h</strong></span>
                  <span class="tag-behind">{t("quoteBehindHours")}: <strong id="recBehindHours">19.0h</strong></span>
                </div>
              </div>

              <!-- Itemized Receipt Lines -->
              <div class="receipt-lines">
                <div class="rec-line">
                  <span>{t("quoteEquipRentalLabel")}</span>
                  <span class="rec-val"><bdi id="recEquipSubtotal">2,950 ₪</bdi></span>
                </div>
                <div class="rec-line">
                  <span>{t("quoteMusicServicesLabel")}</span>
                  <span class="rec-val"><bdi id="recServicesSubtotal">2,800 ₪</bdi></span>
                </div>
                <div class="rec-line gross-line">
                  <span>{t("quoteGrossSubtotalLabel")}</span>
                  <span class="rec-val"><bdi id="recGrossTotal">5,750 ₪</bdi></span>
                </div>
                <div class="rec-line discount-line hidden" id="recDiscountLine">
                  <span>{t("quoteDiscountLabel")}</span>
                  <span class="rec-val discount-val">- <bdi id="recDiscountAmount">0 ₪</bdi></span>
                </div>
                <div class="rec-line net-line">
                  <span>{t("quoteSubtotalBeforeVat")}</span>
                  <span class="rec-val"><bdi id="recNetTotal">5,750 ₪</bdi></span>
                </div>
                <div class="rec-line vat-line" id="recVatLine">
                  <span>{t("quoteVat18")}</span>
                  <span class="rec-val">+ <bdi id="recVatAmount">1,035 ₪</bdi></span>
                </div>
                <div class="rec-total-line">
                  <span id="recTotalLabel">{t("quoteGrandTotal")}</span>
                  <span class="grand-price"><bdi id="recGrandTotal">6,785 ₪</bdi></span>
                </div>
              </div>

              <!-- Quick Action Buttons -->
              <div class="receipt-actions">
                <button type="button" class="btn-copy-link" id="btnShareClientLink">
                  <span class="icon">share</span>
                  <span>{t("quoteShareLink")}</span>
                </button>
                <button type="button" class="btn-preview-prop" id="btnPreviewProposal">
                  <span class="icon">visibility</span>
                  <span>{t("quotePreviewClientBtn")}</span>
                </button>
                <a href="#" class="btn-whatsapp-send" id="btnWhatsAppDirect" target="_blank" rel="noopener noreferrer">
                  <span class="icon">send</span>
                  <span>{t("quoteDiscussWhatsAppBtn")}</span>
                </a>
                <button type="button" class="btn-copy-json" id="btnCopyJsonSnapshot">
                  <span class="icon">data_object</span>
                  <span>{t("quoteCopyJson")}</span>
                </button>
              </div>

              <!-- Toast notification -->
              <div class="toast-bubble hidden" id="toastMessage">
                <span class="icon">check</span>
                <span id="toastText">Copied!</span>
              </div>
            </div>
          </aside>
        </div>
      </section>
    </div>
  </main>
</Layout>

<script>
  import { calculateQuote, formatCurrency } from '../../utils/quoteCalculator';
  import { encodeQuoteToHash, decodeQuoteFromHash, generateQuoteWhatsAppUrl, getShareableQuoteUrl } from '../../utils/quoteEncoder';

  const appEl = document.getElementById('quoteApp');
  if (appEl) {
    const rawConfig = appEl.getAttribute('data-config');
    const config = rawConfig ? JSON.parse(rawConfig) : null;

    if (config) {
      // Internal Reactive State
      const state = {
        eventName: '',
        clientName: '',
        eventDate: new Date().toISOString().split('T')[0],
        locationZone: 'upper_galilee',
        tripsCount: 1,
        djHours: 3.5,
        preprodHours: 5.0,
        setupFee: 500,
        daysCount: 1,
        itemsQty: {} as Record<string, number>,
        discountType: 'none' as 'none' | 'percentage' | 'fixed',
        discountVal: 0,
        discountReason: '',
        applyVat: true,
        viewMode: 'builder' as 'builder' | 'client',
      };

      // Populate default quantities from catalog
      config.catalog.forEach((item: any) => {
        state.itemsQty[item.id] = item.defaultQty;
      });

      // DOM Elements Cache
      const builderSection = document.getElementById('builderSection');
      const clientProposalSection = document.getElementById('clientProposalSection');
      const viewModeIndicator = document.getElementById('viewModeIndicator');
      const quoteStatusBadge = document.getElementById('quoteStatusBadge');
      const pageMainHeading = document.getElementById('pageMainHeading');

      // Proposal Elements
      const propEventName = document.getElementById('propEventName');
      const propVenue = document.getElementById('propVenue');
      const propDate = document.getElementById('propDate');
      const propZone = document.getElementById('propZone');
      const propTotalHoursVal = document.getElementById('propTotalHoursVal');
      const propStageHoursVal = document.getElementById('propStageHoursVal');
      const propBehindHoursVal = document.getElementById('propBehindHoursVal');
      const propStageSegment = document.getElementById('propStageSegment');
      const propBehindSegment = document.getElementById('propBehindSegment');
      const propEquipmentList = document.getElementById('propEquipmentList');
      const propServicesList = document.getElementById('propServicesList');
      const propSubtotalVal = document.getElementById('propSubtotalVal');
      const propDiscountRow = document.getElementById('propDiscountRow');
      const propDiscountLabel = document.getElementById('propDiscountLabel');
      const propDiscountVal = document.getElementById('propDiscountVal');
      const propVatRow = document.getElementById('propVatRow');
      const propVatVal = document.getElementById('propVatVal');
      const propTotalLabel = document.getElementById('propTotalLabel');
      const propGrandTotalVal = document.getElementById('propGrandTotalVal');
      const propWhatsAppConfirmBtn = document.getElementById('propWhatsAppConfirmBtn') as HTMLAnchorElement;

      // Builder Elements
      const inputEventName = document.getElementById('inputEventName') as HTMLInputElement;
      const inputClientName = document.getElementById('inputClientName') as HTMLInputElement;
      const inputEventDate = document.getElementById('inputEventDate') as HTMLInputElement;
      const selectLocationZone = document.getElementById('selectLocationZone') as HTMLSelectElement;
      const sliderDjHours = document.getElementById('sliderDjHours') as HTMLInputElement;
      const djHoursVal = document.getElementById('djHoursVal');
      const djCostVal = document.getElementById('djCostVal');
      const sliderPreprodHours = document.getElementById('sliderPreprodHours') as HTMLInputElement;
      const preprodHoursVal = document.getElementById('preprodHoursVal');
      const preprodCostVal = document.getElementById('preprodCostVal');
      const inputSetupFee = document.getElementById('inputSetupFee') as HTMLInputElement;
      const computedLogisticsVal = document.getElementById('computedLogisticsVal');
      const computedLogisticsHint = document.getElementById('computedLogisticsHint');
      const discountInputsRow = document.getElementById('discountInputsRow');
      const inputDiscountVal = document.getElementById('inputDiscountVal') as HTMLInputElement;
      const inputDiscountReason = document.getElementById('inputDiscountReason') as HTMLInputElement;

      // Receipt Elements
      const recTotalHours = document.getElementById('recTotalHours');
      const recStageBar = document.getElementById('recStageBar');
      const recBehindBar = document.getElementById('recBehindBar');
      const recStageHours = document.getElementById('recStageHours');
      const recBehindHours = document.getElementById('recBehindHours');
      const recEquipSubtotal = document.getElementById('recEquipSubtotal');
      const recServicesSubtotal = document.getElementById('recServicesSubtotal');
      const recGrossTotal = document.getElementById('recGrossTotal');
      const recDiscountLine = document.getElementById('recDiscountLine');
      const recDiscountAmount = document.getElementById('recDiscountAmount');
      const recNetTotal = document.getElementById('recNetTotal');
      const recVatLine = document.getElementById('recVatLine');
      const recVatAmount = document.getElementById('recVatAmount');
      const recTotalLabel = document.getElementById('recTotalLabel');
      const recGrandTotal = document.getElementById('recGrandTotal');
      const btnWhatsAppDirect = document.getElementById('btnWhatsAppDirect') as HTMLAnchorElement;

      const toastMessage = document.getElementById('toastMessage');
      const toastText = document.getElementById('toastText');

      function showToast(msg: string) {
        if (!toastMessage || !toastText) return;
        toastText.textContent = msg;
        toastMessage.classList.remove('hidden');
        setTimeout(() => {
          toastMessage.classList.add('hidden');
        }, 2500);
      }

      function computeCurrentQuote() {
        const items = config.catalog.map((catItem: any) => ({
          id: catItem.id,
          name: catItem.name,
          category: catItem.category,
          unitPrice: catItem.dailyRentalPrice,
          quantity: state.itemsQty[catItem.id] || 0,
        }));

        const matchedZone = config.zones.find((z: any) => z.id === state.locationZone) || config.zones[0];
        const computedLogisticsFee = (matchedZone.defaultFee || 100) * (state.tripsCount || 1);

        const discountVal =
          state.discountType === 'none' ? 0 : Number(state.discountVal) || 0;

        return calculateQuote({
          client: {
            name: state.clientName,
            eventDate: state.eventDate,
            venueName: state.eventName,
            locationZone: state.locationZone as any,
          },
          language: config.lang,
          items,
          daysCount: state.daysCount,
          djPerformanceHours: state.djHours,
          djRatePerHour: config.rates.djPerHour,
          preprodHours: state.preprodHours,
          preprodRatePerHour: config.rates.preprodPerHour,
          setupTeardownFee: state.setupFee,
          logisticsFee: computedLogisticsFee,
          discount: {
            type: state.discountType === 'percentage' ? 'percentage' : 'fixed',
            value: discountVal,
            reason: state.discountReason,
          },
          applyVat: state.applyVat,
        });
      }

      function renderApp() {
        const quote = computeCurrentQuote();

        // 1. Time / Iceberg calculation
        const stageH = quote.services.djPerformanceHours;
        const behindH =
          quote.services.preprodHours +
          2.0 + // On-site rigging & soundcheck
          1.5 + // Teardown & packing
          1.5;  // Warehouse / cable management
        const totalH = stageH + behindH;
        const stagePct = Math.round((stageH / Math.max(1, totalH)) * 100);
        const behindPct = 100 - stagePct;

        // Render Builder Sliders & Live Costs
        if (djHoursVal) djHoursVal.textContent = `${stageH.toFixed(1)}h`;
        if (djCostVal) djCostVal.textContent = `${formatCurrency(stageH * config.rates.djPerHour)} ₪`;
        if (preprodHoursVal) preprodHoursVal.textContent = `${quote.services.preprodHours.toFixed(1)}h`;
        if (preprodCostVal) preprodCostVal.textContent = `${formatCurrency(quote.services.preprodHours * config.rates.preprodPerHour)} ₪`;

        // Render Computed Logistics in Builder
        if (computedLogisticsVal) computedLogisticsVal.innerHTML = `<bdi>${formatCurrency(quote.services.logisticsFee)} ₪</bdi>`;
        if (computedLogisticsHint) {
          const matchedZone = config.zones.find((z: any) => z.id === state.locationZone) || config.zones[0];
          computedLogisticsHint.textContent = `${state.tripsCount || 1} × ${matchedZone.defaultFee} ₪ (${matchedZone.defaultDurationMin} min)`;
        }

        // Render Live Receipt
        if (recTotalHours) recTotalHours.textContent = `${totalH.toFixed(1)}h`;
        if (recStageHours) recStageHours.textContent = `${stageH.toFixed(1)}h`;
        if (recBehindHours) recBehindHours.textContent = `${behindH.toFixed(1)}h`;
        if (recStageBar) recStageBar.style.width = `${stagePct}%`;
        if (recBehindBar) recBehindBar.style.width = `${behindPct}%`;

        if (recEquipSubtotal) recEquipSubtotal.textContent = `${formatCurrency(quote.equipment.subtotal)} ₪`;
        if (recServicesSubtotal) recServicesSubtotal.textContent = `${formatCurrency(quote.services.subtotal)} ₪`;
        if (recGrossTotal) recGrossTotal.textContent = `${formatCurrency(quote.financials.grossTotal)} ₪`;

        if (recDiscountLine) {
          if (quote.financials.discount.amount > 0) {
            recDiscountLine.classList.remove('hidden');
            if (recDiscountAmount) recDiscountAmount.textContent = `${formatCurrency(quote.financials.discount.amount)} ₪`;
          } else {
            recDiscountLine.classList.add('hidden');
          }
        }

        if (recNetTotal) recNetTotal.textContent = `${formatCurrency(quote.financials.netTotal)} ₪`;
        if (recVatAmount) recVatAmount.textContent = `${formatCurrency(quote.financials.vatAmount)} ₪`;
        if (recTotalLabel) recTotalLabel.textContent = config.labels.grandTotal;
        if (recGrandTotal) recGrandTotal.textContent = `${formatCurrency(quote.financials.grandTotal)} ₪`;

        // Direct WhatsApp link in receipt
        if (btnWhatsAppDirect) {
          const directUrl = generateQuoteWhatsAppUrl(quote, config.lang);
          btnWhatsAppDirect.href = directUrl;
        }

        // Render Proposal View Elements
        if (propEventName) propEventName.textContent = quote.client.venueName || 'Bespoke Event Production';
        if (propVenue) propVenue.textContent = quote.client.venueName || 'Venue';
        if (propDate) propDate.textContent = quote.client.eventDate || new Date().toISOString().split('T')[0];
        if (propZone) {
          const matchedZone = config.zones.find((z: any) => z.id === quote.client.locationZone);
          propZone.textContent = matchedZone ? matchedZone.name[config.lang] : quote.client.locationZone;
        }

        if (propTotalHoursVal) propTotalHoursVal.textContent = `${totalH.toFixed(1)}h`;
        if (propStageHoursVal) propStageHoursVal.textContent = `${stageH.toFixed(1)}h`;
        if (propBehindHoursVal) propBehindHoursVal.textContent = `${behindH.toFixed(1)}h`;
        if (propStageSegment) propStageSegment.style.width = `${stagePct}%`;
        if (propBehindSegment) propBehindSegment.style.width = `${behindPct}%`;

        // Render Equipment in Proposal
        if (propEquipmentList) {
          const activeItems = quote.equipment.items.filter((i) => i.quantity > 0);
          propEquipmentList.innerHTML = activeItems
            .map(
              (item) => `
              <div class="prop-item-row">
                <span class="prop-item-qty">${item.quantity}×</span>
                <span class="prop-item-name">${item.name[config.lang] || item.name.en}</span>
                <span class="prop-item-price"><bdi>${formatCurrency(item.totalPrice)} ₪</bdi></span>
              </div>
            `
            )
            .join('');
        }

        // Render Services in Proposal
        if (propServicesList) {
          propServicesList.innerHTML = `
            <div class="prop-service-row">
              <span class="service-name">Live DJ Set (${stageH.toFixed(1)}h @ ${config.rates.djPerHour} ₪/h)</span>
              <span class="service-price"><bdi>${formatCurrency(stageH * config.rates.djPerHour)} ₪</bdi></span>
            </div>
            ${
              quote.services.preprodHours > 0
                ? `
              <div class="prop-service-row">
                <span class="service-name">Music Pre-Production & SoundSwitch (${quote.services.preprodHours.toFixed(1)}h)</span>
                <span class="service-price"><bdi>${formatCurrency(quote.services.preprodHours * config.rates.preprodPerHour)} ₪</bdi></span>
              </div>
            `
                : ''
            }
            <div class="prop-service-row">
              <span class="service-name">Site Rigging, Discreet Cabling & Teardown</span>
              <span class="service-price"><bdi>${formatCurrency(quote.services.setupTeardownFee)} ₪</bdi></span>
            </div>
            <div class="prop-service-row">
              <span class="service-name">Logistics & Travel (${quote.client.locationZone})</span>
              <span class="service-price"><bdi>${formatCurrency(quote.services.logisticsFee)} ₪</bdi></span>
            </div>
          `;
        }

        if (propSubtotalVal) propSubtotalVal.textContent = `${formatCurrency(quote.financials.grossTotal)} ₪`;

        if (propDiscountRow) {
          if (quote.financials.discount.amount > 0) {
            propDiscountRow.classList.remove('hidden');
            if (propDiscountVal) propDiscountVal.textContent = `${formatCurrency(quote.financials.discount.amount)} ₪`;
            if (propDiscountLabel && quote.financials.discount.reason) {
              propDiscountLabel.textContent = `Discount (${quote.financials.discount.reason})`;
            }
          } else {
            propDiscountRow.classList.add('hidden');
          }
        }

        if (propVatVal) propVatVal.textContent = `${formatCurrency(quote.financials.vatAmount)} ₪`;
        if (propTotalLabel) propTotalLabel.textContent = config.labels.grandTotal;
        if (propGrandTotalVal) propGrandTotalVal.textContent = `${formatCurrency(quote.financials.grandTotal)} ₪`;

        // WhatsApp Confirmation CTA in proposal
        if (propWhatsAppConfirmBtn) {
          propWhatsAppConfirmBtn.href = generateQuoteWhatsAppUrl(quote, config.lang);
        }

        // View Mode Toggle Display
        if (state.viewMode === 'client') {
          builderSection?.classList.add('hidden');
          clientProposalSection?.classList.remove('hidden');
          if (viewModeIndicator) viewModeIndicator.textContent = 'CLIENT PRESENTATION';
          if (quoteStatusBadge) quoteStatusBadge.textContent = config.labels.grandTotal;
          if (pageMainHeading) pageMainHeading.textContent = quote.client.venueName || 'Production Quote';
        } else {
          clientProposalSection?.classList.add('hidden');
          builderSection?.classList.remove('hidden');
          if (viewModeIndicator) viewModeIndicator.textContent = 'PRODUCER / BUILDER';
          if (quoteStatusBadge) quoteStatusBadge.textContent = 'ESTIMATE BUILDER';
        }
      }

      // Check if URL hash contains a saved quote
      function initFromUrlHash() {
        const hash = window.location.hash;
        if (hash && hash.includes('q=')) {
          const decoded = decodeQuoteFromHash(hash);
          if (decoded) {
            state.eventName = decoded.client.venueName || '';
            state.clientName = decoded.client.name || '';
            state.eventDate = decoded.client.eventDate || state.eventDate;
            state.locationZone = decoded.client.locationZone || 'upper_galilee';
            state.djHours = decoded.services.djPerformanceHours;
            state.preprodHours = decoded.services.preprodHours || 0;
            state.setupFee = decoded.services.setupTeardownFee;
            state.logisticsFee = decoded.services.logisticsFee;
            state.daysCount = decoded.equipment.daysCount || 1;
            state.applyVat = decoded.financials.applyVat;

            if (decoded.financials.discount) {
              state.discountType = decoded.financials.discount.type || 'none';
              state.discountVal = decoded.financials.discount.value || 0;
              state.discountReason = decoded.financials.discount.reason || '';
            }

            // Sync equipment quantities
            decoded.equipment.items.forEach((item) => {
              state.itemsQty[item.id] = item.quantity;
            });

            // Automatically switch to client view
            state.viewMode = 'client';
          }
        }
      }

      // Event Listeners for Builder Controls
      inputEventName?.addEventListener('input', (e) => {
        state.eventName = (e.target as HTMLInputElement).value;
        renderApp();
      });

      inputClientName?.addEventListener('input', (e) => {
        state.clientName = (e.target as HTMLInputElement).value;
        renderApp();
      });

      inputEventDate?.addEventListener('change', (e) => {
        state.eventDate = (e.target as HTMLInputElement).value;
        renderApp();
      });

      selectLocationZone?.addEventListener('change', (e) => {
        const zoneId = (e.target as HTMLSelectElement).value;
        state.locationZone = zoneId;
        renderApp();
      });

      // Trips Count Toggle Buttons
      document.querySelectorAll('.trip-toggle-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.trip-toggle-btn').forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          state.tripsCount = Number(btn.getAttribute('data-trips') || 1);
          renderApp();
        });
      });

      sliderDjHours?.addEventListener('input', (e) => {
        state.djHours = Number((e.target as HTMLInputElement).value);
        renderApp();
      });

      sliderPreprodHours?.addEventListener('input', (e) => {
        state.preprodHours = Number((e.target as HTMLInputElement).value);
        renderApp();
      });

      inputSetupFee?.addEventListener('input', (e) => {
        state.setupFee = Math.max(0, Number((e.target as HTMLInputElement).value) || 0);
        renderApp();
      });

      // Toggle buttons for Equipment Catalog (Add / Remove)
      document.querySelectorAll('.toggle-equip-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const itemId = btn.getAttribute('data-id');
          if (!itemId) return;
          const defaultQty = Number(btn.getAttribute('data-qty') || 1);
          const current = state.itemsQty[itemId] || 0;

          if (current > 0) {
            // Remove
            state.itemsQty[itemId] = 0;
            btn.classList.remove('active');
            btn.setAttribute('aria-pressed', 'false');
            const icon = btn.querySelector('.toggle-icon');
            const text = btn.querySelector('.toggle-text');
            if (icon) icon.textContent = 'add';
            if (text) text.textContent = config.labels.addBtn;
          } else {
            // Add
            state.itemsQty[itemId] = defaultQty;
            btn.classList.add('active');
            btn.setAttribute('aria-pressed', 'true');
            const icon = btn.querySelector('.toggle-icon');
            const text = btn.querySelector('.toggle-text');
            if (icon) icon.textContent = 'check';
            if (text) text.textContent = config.labels.removeBtn;
          }

          renderApp();
        });
      });

      // Days rental selector
      document.querySelectorAll('.day-toggle-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.day-toggle-btn').forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          state.daysCount = Number(btn.getAttribute('data-days') || 1);
          renderApp();
        });
      });

      // Presets Selector
      document.querySelectorAll('.preset-pill').forEach((btn) => {
        btn.addEventListener('click', () => {
          const presetId = btn.getAttribute('data-preset-id');
          const matched = config.presets.find((p: any) => p.id === presetId);
          if (!matched) return;

          document.querySelectorAll('.preset-pill').forEach((p) => p.classList.remove('active'));
          btn.classList.add('active');

          state.djHours = matched.djHours;
          state.preprodHours = matched.preprodHours;
          state.setupFee = matched.setupFee;
          state.daysCount = matched.daysCount;
          state.locationZone = matched.locationZone;

          if (sliderDjHours) sliderDjHours.value = String(matched.djHours);
          if (sliderPreprodHours) sliderPreprodHours.value = String(matched.preprodHours);
          if (inputSetupFee) inputSetupFee.value = String(matched.setupFee);
          if (selectLocationZone) selectLocationZone.value = matched.locationZone;

          // Reset all equipment quantities and apply preset items
          config.catalog.forEach((item: any) => {
            state.itemsQty[item.id] = 0;
          });
          matched.equipmentItemIds.forEach((spec: any) => {
            state.itemsQty[spec.id] = spec.qty ?? 1;
          });

          // Sync toggle buttons in DOM
          document.querySelectorAll('.toggle-equip-btn').forEach((btn) => {
            const itemId = btn.getAttribute('data-id');
            if (!itemId) return;
            const hasItem = (state.itemsQty[itemId] || 0) > 0;
            const icon = btn.querySelector('.toggle-icon');
            const text = btn.querySelector('.toggle-text');

            if (hasItem) {
              btn.classList.add('active');
              btn.setAttribute('aria-pressed', 'true');
              if (icon) icon.textContent = 'check';
              if (text) text.textContent = config.labels.removeBtn;
            } else {
              btn.classList.remove('active');
              btn.setAttribute('aria-pressed', 'false');
              if (icon) icon.textContent = 'add';
              if (text) text.textContent = config.labels.addBtn;
            }
          });

          renderApp();
          showToast(`Preset loaded: ${matched.name[config.lang]}`);
        });
      });

      // Discount Tabs (Toggle on / off)
      document.querySelectorAll('.discount-type-tabs .tab-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const type = (btn.getAttribute('data-type') || 'percentage') as any;
          const wasActive = btn.classList.contains('active');

          if (wasActive) {
            // Unselect discount
            btn.classList.remove('active');
            state.discountType = 'none';
            state.discountVal = 0;
            discountInputsRow?.classList.add('hidden');
          } else {
            // Select this discount type
            document.querySelectorAll('.discount-type-tabs .tab-btn').forEach((b) => b.classList.remove('active'));
            btn.classList.add('active');
            state.discountType = type;
            discountInputsRow?.classList.remove('hidden');
            if (!state.discountVal) {
              state.discountVal = type === 'percentage' ? 10 : 200;
              if (inputDiscountVal) inputDiscountVal.value = String(state.discountVal);
            }
          }
          renderApp();
        });
      });

      inputDiscountVal?.addEventListener('input', (e) => {
        state.discountVal = Math.max(0, Number((e.target as HTMLInputElement).value) || 0);
        renderApp();
      });

      inputDiscountReason?.addEventListener('input', (e) => {
        state.discountReason = (e.target as HTMLInputElement).value;
        renderApp();
      });

      // VAT Buttons
      document.querySelectorAll('.vat-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.vat-btn').forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          state.applyVat = btn.getAttribute('data-vat') === 'true';
          renderApp();
        });
      });

      // Action: Copy Shareable Link for Client
      async function copyShareableLink() {
        const quote = computeCurrentQuote();
        const fullUrl = getShareableQuoteUrl(quote, window.location.origin);
        try {
          await navigator.clipboard.writeText(fullUrl);
          showToast(config.labels.copiedLink);
        } catch {
          prompt('Copy link:', fullUrl);
        }
      }

      document.getElementById('btnShareClientLink')?.addEventListener('click', copyShareableLink);
      document.getElementById('propShareLinkBtn')?.addEventListener('click', copyShareableLink);

      // Action: Copy JSON snapshot
      async function copyJsonSnapshot() {
        const quote = computeCurrentQuote();
        const jsonStr = JSON.stringify(quote, null, 2);
        try {
          await navigator.clipboard.writeText(jsonStr);
          showToast(config.labels.copiedJson);
        } catch {
          prompt('Copy JSON:', jsonStr);
        }
      }

      document.getElementById('btnCopyJsonSnapshot')?.addEventListener('click', copyJsonSnapshot);
      document.getElementById('propCopyJsonBtn')?.addEventListener('click', copyJsonSnapshot);

      // Action: Switch view modes
      document.getElementById('btnPreviewProposal')?.addEventListener('click', () => {
        state.viewMode = 'client';
        renderApp();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });

      document.getElementById('btnEditQuote')?.addEventListener('click', () => {
        state.viewMode = 'builder';
        renderApp();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });

      // Initial boot
      initFromUrlHash();
      renderApp();

      // Listen to popstate / hashchange for back/forward navigation
      window.addEventListener('hashchange', () => {
        initFromUrlHash();
        renderApp();
      });
    }
  }
</script>

<style>
  .quote-viewport {
    position: relative;
    min-height: 100vh;
    width: 100%;
    color: var(--color-text-main);
    box-sizing: border-box;
    padding-block-end: 6rem;
    overflow-x: hidden;
  }

  .quote-container {
    position: relative;
    z-index: 10;
    max-width: 1140px;
    width: 100%;
    margin-inline: auto;
    padding-inline: 1.25rem;
    box-sizing: border-box;
  }

  /* Header */
  .quote-header {
    text-align: center;
    padding-block-start: 2rem;
    padding-block-end: 2rem;
  }

  .badge-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-block-end: 0.75rem;
  }

  .badge-pill {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-primary);
    background: var(--color-surface-glass);
    border: 1px solid var(--color-glass-border);
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
  }

  .badge-subtle {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: var(--color-text-subtle);
  }

  .quote-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 700;
    line-height: 1.2;
    margin: 0;
    color: var(--color-text-main);
  }

  .quote-subtitle {
    font-size: clamp(0.95rem, 1.8vw, 1.1rem);
    color: var(--color-text-muted);
    max-width: 680px;
    margin-inline: auto;
    margin-block-start: 0.75rem;
    line-height: 1.5;
  }

  /* Presets Bar */
  .presets-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    background: var(--color-surface-glass);
    border: 1px solid var(--color-glass-border);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    padding: 0.85rem 1.25rem;
    border-radius: var(--radius-lg);
    margin-block-end: 2rem;
  }

  .presets-label {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .presets-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .preset-pill {
    background: transparent;
    border: 1px solid var(--color-glass-border);
    color: var(--color-text-main);
    font-family: var(--font-body);
    font-size: 0.85rem;
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .preset-pill:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .preset-pill.featured {
    border-color: var(--color-primary);
    background: var(--color-primary-glow);
  }

  .preset-pill.active {
    background: var(--color-primary);
    color: var(--color-on-primary);
    border-color: var(--color-primary);
  }

  /* Builder Layout */
  .builder-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: start;
  }

  @media (min-width: 960px) {
    .builder-layout {
      grid-template-columns: 1fr 380px;
    }
  }

  .builder-controls {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    min-width: 0;
  }

  /* Card Styles */
  .control-card {
    background: var(--color-surface-glass);
    border: 1px solid var(--color-glass-border);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
