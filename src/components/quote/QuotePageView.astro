---
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/common/SiteHeader.astro";
import AtmosphereBackground from "../../components/intro/AtmosphereBackground.astro";
import type { SupportedLang } from "../../i18n/ui";
import { useTranslations } from "../../i18n/ui";
import {
  EQUIPMENT_CATALOG,
  CATEGORIES,
  LOCATION_ZONES,
  PRESETS,
  DEFAULT_PRESET,
  LABOR_RATES,
  VAT_RATE,
} from "../../data/quoteConfig";
import { SITE_CONTACTS } from "../../data/contacts";
import { calculateQuote, formatCurrency } from "../../utils/quoteCalculator";
import { generateQuoteWhatsAppUrl, getShortQuoteUrl } from "../../utils/quoteEncoder";
import QuoteProposalView from "./proposal/QuoteProposalView.astro";
import QuotePresetsBar from "./builder/QuotePresetsBar.astro";
import QuoteEventCard from "./builder/QuoteEventCard.astro";
import QuoteLaborCard from "./builder/QuoteLaborCard.astro";
import QuoteCatalogCard from "./builder/QuoteCatalogCard.astro";
import QuoteLogisticsCard from "./builder/QuoteLogisticsCard.astro";
import QuoteFinancialsCard from "./builder/QuoteFinancialsCard.astro";
import QuoteStickyReceipt from "./builder/QuoteStickyReceipt.astro";
import type { QuoteSnapshot } from "../../types/quote";

interface Props {
  lang: SupportedLang;
  initialSavedQuote?: QuoteSnapshot;
  shortId?: string;
}

const { lang, initialSavedQuote, shortId } = Astro.props;
const t = useTranslations(lang);

const isClientView = Boolean(initialSavedQuote);
const canonicalPath = shortId
  ? (lang === "en" ? `/q/${shortId}` : `/${lang}/q/${shortId}`)
  : (lang === "en" ? "/quote" : `/${lang}/quote`);

const pageTitle = initialSavedQuote?.client?.venueName
  ? `${initialSavedQuote.client.venueName} — DJ Dima Minka`
  : `${t("quotePageTitle")} — DJ Dima Minka`;
const pageDescription = initialSavedQuote?.client?.venueName
  ? `${t("quoteBadgeClientView")}: ${initialSavedQuote.client.venueName}`
  : t("quotePageSubtitle");

const initialPreset = DEFAULT_PRESET;
const matchedZone =
  LOCATION_ZONES.find((z) => z.id === initialPreset.locationZone) || LOCATION_ZONES[0];
const initialLogisticsFee = (matchedZone.defaultFee || 100) * (initialPreset.tripsCount || 1);

let initialQuote: QuoteSnapshot;

if (initialSavedQuote) {
  initialQuote = initialSavedQuote;
} else {
  // Calculate server-side initial quote strictly from the default preset (Sunset & Cocktail)
  const initialItems = initialPreset.equipmentItemIds.map((spec) => {
    const catItem = EQUIPMENT_CATALOG.find((c) => c.id === spec.id)!;
    return {
      id: catItem.id,
      name: catItem.name,
      category: catItem.category,
      unitPrice: catItem.dailyRentalPrice,
      quantity: spec.qty,
    };
  });

  initialQuote = calculateQuote({
    client: {
      name: '',
      eventDate: new Date().toISOString().split('T')[0],
      venueName: '',
      locationZone: initialPreset.locationZone,
    },
    language: lang,
    items: initialItems,
    daysCount: initialPreset.daysCount,
    djPerformanceHours: initialPreset.djHours,
    djRatePerHour: LABOR_RATES.djPerHour,
    preprodHours: initialPreset.preprodHours,
    preprodRatePerHour: LABOR_RATES.preprodPerHour,
    setupTeardownFee: initialPreset.setupFee,
    logisticsFee: initialLogisticsFee,
    discount: { type: 'fixed', value: 0 },
    applyVat: true,
  });
}

const initialShortUrl = shortId ? getShortQuoteUrl(shortId, lang) : undefined;
const initialQuoteWhatsAppUrl = generateQuoteWhatsAppUrl(initialQuote, lang, initialShortUrl);
const totalHours = (initialQuote.services.djPerformanceHours + initialQuote.services.preprodHours + 4.0).toFixed(1);

// Serializable config for the client-side calculator
const clientConfig = {
  lang,
  catalog: EQUIPMENT_CATALOG,
  categories: CATEGORIES,
  zones: LOCATION_ZONES,
  presets: PRESETS,
  rates: LABOR_RATES,
  vatRate: VAT_RATE,
  whatsappNumber: SITE_CONTACTS.whatsappRaw,
  labels: {
    copiedLink: t("quoteLinkCopied"),
    copiedJson: t("quoteJsonCopied"),
    included: t("quoteIncludedBadge"),
    addBtn: t("quoteAddBtn"),
    removeBtn: t("quoteRemoveBtn"),
    subtotalBeforeVat: t("quoteSubtotalBeforeVat"),
    vat18: t("quoteVat18"),
    grandTotal: t("quoteGrandTotal"),
    icebergTooltipTemplate: t("quoteIcebergTooltip"),
    minTripsWarning: t("quoteMinTripsWarning"),
    badgeProducer: t("quoteBadgeProducer"),
    badgeClientView: t("quoteBadgeClientView"),
    badgeEstimate: t("quoteBadge"),
    defaultHeading: t("quoteDefaultHeading"),
    defaultEventName: t("quoteDefaultEventName"),
    defaultVenue: t("quoteDefaultVenue"),
    quotePageSubtitle: t("quotePageSubtitle"),
    serviceDjSet: t("quoteServiceDjSet"),
    servicePreprod: t("quoteServicePreprod"),
    serviceSetup: t("quoteServiceSetup"),
    serviceLogistics: t("quoteServiceLogistics"),
    tripsUnit: t("quoteTripsUnit"),
    presetLoadedToast: t("quotePresetLoadedToast"),
    minutesUnit: t("quoteMinutesUnit"),
  },
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  lang={lang}
  canonicalPath={canonicalPath}
>
  <!-- Typography for RU (Unbounded) and HE (Rubik) -->
  {lang === "ru" && (
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Unbounded:wght@400;500;600;700;800&display=swap"
      slot="head"
    />
  )}
  {lang === "he" && (
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700;800&display=swap"
      slot="head"
    />
  )}

  <main
    class="quote-viewport pt-safe pb-safe"
    id="quoteApp"
    data-config={JSON.stringify(clientConfig)}
    data-initial-quote={initialSavedQuote ? JSON.stringify(initialSavedQuote) : undefined}
    data-short-id={shortId || undefined}
  >
    <AtmosphereBackground />
    <SiteHeader lang={lang} currentSection="quote" />

    <div class="quote-container">
      <!-- 1. Header Banner -->
      <header class="quote-header">
        <div class="badge-row">
          <span class="badge-pill" id="quoteStatusBadge">
            {isClientView ? (shortId ? `#${shortId}` : t("quoteBadgeClientView")) : t("quoteBadge")}
          </span>
          <span class="badge-subtle" id="viewModeIndicator">
            {isClientView ? t("quoteBadgeClientView") : t("quoteBadgeProducer")}
          </span>
        </div>
        <h1 class="quote-title" id="pageMainHeading">
          {isClientView ? (initialQuote.client.venueName || t("quoteDefaultHeading")) : t("quotePageTitle")}
        </h1>
        <p class="quote-subtitle" id="pageMainSubtitle">
          {isClientView
            ? (initialQuote.client.name ? `${initialQuote.client.name}${initialQuote.client.eventDate ? ` • ${initialQuote.client.eventDate}` : ''}` : t("quotePageSubtitle"))
            : t("quotePageSubtitle")}
        </p>
      </header>

      <!-- 2. CLIENT PRESENTATION VIEW (Proposal) -->
      <QuoteProposalView initialQuote={initialQuote} lang={lang} isClientView={isClientView} shortId={shortId} />

      <!-- 3. CONSTRUCTOR / BUILDER VIEW -->
      <section class={`builder-view ${isClientView ? 'hidden' : ''}`} id="builderSection">
        <QuotePresetsBar
          presets={PRESETS}
          activePresetId={initialPreset.id}
          lang={lang}
        />

        <div class="builder-layout">
          <!-- Left Column: Controls & Configuration Cards -->
          <div class="builder-controls">
            <QuoteEventCard
              zones={LOCATION_ZONES}
              selectedZoneId={initialPreset.locationZone}
              lang={lang}
            />
            <QuoteLaborCard
              initialDjHours={initialPreset.djHours}
              initialPreprodHours={initialPreset.preprodHours}
              lang={lang}
            />
            <QuoteCatalogCard
              initialActiveItemIds={initialPreset.equipmentItemIds.map((i) => i.id)}
              initialDaysCount={initialPreset.daysCount}
              lang={lang}
            />
            <QuoteLogisticsCard
              initialTripsCount={initialPreset.tripsCount}
              initialMinTripsCount={initialPreset.minTripsCount}
              initialSetupFee={initialPreset.setupFee}
              initialSetupHours={initialPreset.setupFee / 120}
              initialLogisticsFee={initialLogisticsFee}
              lang={lang}
            />
            <QuoteFinancialsCard lang={lang} />
          </div>

          <!-- Right Column: Sticky Live Receipt -->
          <QuoteStickyReceipt initialQuote={initialQuote} lang={lang} initialWhatsAppUrl={initialQuoteWhatsAppUrl} />
        </div>
      </section>

      <!-- Globally Fixed Toast Notification -->
      <div class="toast-bubble hidden" id="toastMessage" role="status" aria-live="polite">
        <span class="icon">check</span>
        <span id="toastText">Copied!</span>
      </div>

      <!-- Mobile Sticky Bottom Bar (Builder View Only) -->
      <div class={`mobile-sticky-bar ${isClientView ? 'hidden' : ''}`} id="mobileStickyBar">
        <div class="msb-summary">
          <div class="msb-price" id="mobileGrandTotal"><bdi>{formatCurrency(initialQuote.financials.grandTotal)} ₪</bdi></div>
          <div class="msb-hours" id="mobileTotalHours">{totalHours}h</div>
        </div>
        <div class="msb-actions">
          <button type="button" class="msb-btn-preview" id="mobilePreviewBtn">
            <span class="material-symbols-outlined" aria-hidden="true">visibility</span>
            <span>{t("quotePreviewClientBtn")}</span>
          </button>
          <a
            href={initialQuoteWhatsAppUrl}
            class="msb-btn-wa"
            id="mobileWhatsAppBtn"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="WhatsApp"
          >
            <span class="material-symbols-outlined" aria-hidden="true">chat</span>
          </a>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  import { initQuoteApp } from './controller/quoteController';
  initQuoteApp();
</script>

<style>
  .quote-viewport {
    position: relative;
    min-height: 100vh;
    width: 100%;
    color: var(--color-text-main);
    box-sizing: border-box;
    padding-block-end: 6rem;
    overflow-x: hidden;
  }

  .quote-container {
    position: relative;
    z-index: 10;
    max-width: 1140px;
    width: 100%;
    margin-inline: auto;
    padding-inline: clamp(0.75rem, 3vw, 1.25rem);
    box-sizing: border-box;
    min-width: 0;
  }

  /* Header */
  .quote-header {
    text-align: center;
    padding-block-start: 2rem;
    padding-block-end: 2rem;
  }

  .badge-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-block-end: 0.75rem;
  }

  .badge-pill {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-primary);
    background: var(--color-surface-glass);
    border: 1px solid var(--color-glass-border);
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
  }

  .badge-subtle {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: var(--color-text-subtle);
  }

  .quote-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 700;
    line-height: 1.2;
    margin: 0;
    color: var(--color-text-main);
  }

  .quote-subtitle {
    font-size: clamp(0.95rem, 1.8vw, 1.1rem);
    color: var(--color-text-muted);
    max-width: 680px;
    margin-inline: auto;
    margin-block-start: 0.75rem;
    line-height: 1.5;
  }

  /* Builder Layout */
  .builder-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: start;
  }

  @media (min-width: 960px) {
    .builder-layout {
      grid-template-columns: 1fr 380px;
    }
  }

  .builder-controls {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    min-width: 0;
  }

  /* Globally Fixed Toast bubble */
  .toast-bubble {
    position: fixed;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-primary);
    color: var(--color-on-primary);
    padding: 0.6rem 1rem;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.8rem;
    font-weight: 600;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
    z-index: 100;
    animation: fadeInToast 0.25s ease;
    white-space: nowrap;
    max-width: calc(100vw - 32px);
    box-sizing: border-box;
  }

  @media (max-width: 959px) {
    .toast-bubble {
      bottom: 0.65rem;
      z-index: 110;
      padding: 0.55rem 0.95rem;
      font-size: 0.76rem;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.5);
    }
  }

  @keyframes fadeInToast {
    from {
      opacity: 0;
      transform: translateX(-50%) translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }
  }

  .icon {
    font-family: 'Material Symbols Outlined', sans-serif;
    font-size: 1.2rem;
    vertical-align: middle;
  }

  .hidden {
    display: none !important;
  }

  /* Mobile Sticky Bottom Bar (Screens < 960px) */
  .mobile-sticky-bar {
    display: none;
  }

  @media (max-width: 959px) {
    .mobile-sticky-bar {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 95;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      padding: 0.75rem 1rem calc(0.75rem + env(safe-area-inset-bottom, 0px));
      background: rgba(18, 14, 28, 0.88);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-top: 1px solid var(--color-glass-border);
      box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.4);
    }

    :global([data-theme="light"]) .mobile-sticky-bar {
      background: rgba(255, 255, 255, 0.92);
      border-top-color: rgba(0, 0, 0, 0.08);
      box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.08);
    }

    .msb-summary {
      display: flex;
      flex-direction: column;
      min-width: 0;
    }

    .msb-price {
      font-family: var(--font-mono);
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--color-primary);
      line-height: 1.1;
      white-space: nowrap;
    }

    .msb-hours {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      color: var(--color-text-subtle);
      margin-block-start: 0.15rem;
      white-space: nowrap;
    }

    .msb-actions {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      flex-shrink: 0;
    }

    .msb-btn-preview {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      padding: 0.55rem 0.95rem;
      background: var(--color-primary);
      color: var(--color-on-primary);
      border: 1px solid transparent;
      border-radius: var(--radius-full);
      font-size: 0.82rem;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
      white-space: nowrap;
      transition: background 0.2s ease, box-shadow 0.2s ease, transform 0.15s ease, border-color 0.2s ease;
    }

    .msb-btn-preview:hover,
    .msb-btn-preview:active {
      background: var(--color-primary-container);
      box-shadow: 0 0 16px var(--color-primary-glow);
      transform: translateY(-1px);
    }

    :global(html[data-theme="day"]:not(.dark)) .msb-btn-preview {
      background: var(--color-primary);
      color: #ffffff;
      box-shadow: 0 2px 8px rgba(217, 119, 6, 0.2);
    }

    :global(html[data-theme="day"]:not(.dark)) .msb-btn-preview:hover,
    :global(html[data-theme="day"]:not(.dark)) .msb-btn-preview:active {
      background: var(--color-primary-container);
      box-shadow: 0 4px 14px rgba(180, 83, 9, 0.35);
    }

    .msb-btn-preview .material-symbols-outlined {
      font-size: 1.05rem;
    }

    .msb-btn-wa {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.3rem;
      height: 2.3rem;
      background: rgba(37, 211, 102, 0.18);
      color: #25d366;
      border: 1px solid rgba(37, 211, 102, 0.35);
      border-radius: var(--radius-full);
      cursor: pointer;
      text-decoration: none;
      flex-shrink: 0;
      transition: background 0.15s ease, transform 0.15s ease;
    }

    .msb-btn-wa:hover {
      background: rgba(37, 211, 102, 0.28);
      transform: translateY(-1px);
    }

    .msb-btn-wa .material-symbols-outlined {
      font-size: 1.15rem;
    }
  }
</style>
