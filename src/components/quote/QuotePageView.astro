---
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/common/SiteHeader.astro";
import AtmosphereBackground from "../../components/intro/AtmosphereBackground.astro";
import type { SupportedLang } from "../../i18n/ui";
import { useTranslations } from "../../i18n/ui";
import {
  EQUIPMENT_CATALOG,
  CATEGORIES,
  LOCATION_ZONES,
  PRESETS,
  DEFAULT_PRESET,
  LABOR_RATES,
  VAT_RATE,
} from "../../data/quoteConfig";
import { SITE_CONTACTS } from "../../data/contacts";
import { calculateQuote } from "../../utils/quoteCalculator";
import QuoteProposalView from "./proposal/QuoteProposalView.astro";
import QuotePresetsBar from "./builder/QuotePresetsBar.astro";
import QuoteEventCard from "./builder/QuoteEventCard.astro";
import QuoteLaborCard from "./builder/QuoteLaborCard.astro";
import QuoteCatalogCard from "./builder/QuoteCatalogCard.astro";
import QuoteLogisticsCard from "./builder/QuoteLogisticsCard.astro";
import QuoteFinancialsCard from "./builder/QuoteFinancialsCard.astro";
import QuoteStickyReceipt from "./builder/QuoteStickyReceipt.astro";

interface Props {
  lang: SupportedLang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const canonicalPath = lang === "en" ? "/quote" : `/${lang}/quote`;
const pageTitle = `${t("quotePageTitle")} — DJ Dima Minka`;
const pageDescription = t("quotePageSubtitle");

// Calculate server-side initial quote strictly from the default preset (Sunset & Cocktail)
const initialPreset = DEFAULT_PRESET;
const initialItems = initialPreset.equipmentItemIds.map((spec) => {
  const catItem = EQUIPMENT_CATALOG.find((c) => c.id === spec.id)!;
  return {
    id: catItem.id,
    name: catItem.name,
    category: catItem.category,
    unitPrice: catItem.dailyRentalPrice,
    quantity: spec.qty,
  };
});

const matchedZone =
  LOCATION_ZONES.find((z) => z.id === initialPreset.locationZone) || LOCATION_ZONES[0];
const initialLogisticsFee = (matchedZone.defaultFee || 100) * (initialPreset.tripsCount || 1);

const initialQuote = calculateQuote({
  client: {
    name: '',
    eventDate: new Date().toISOString().split('T')[0],
    venueName: '',
    locationZone: initialPreset.locationZone,
  },
  language: lang,
  items: initialItems,
  daysCount: initialPreset.daysCount,
  djPerformanceHours: initialPreset.djHours,
  djRatePerHour: LABOR_RATES.djPerHour,
  preprodHours: initialPreset.preprodHours,
  preprodRatePerHour: LABOR_RATES.preprodPerHour,
  setupTeardownFee: initialPreset.setupFee,
  logisticsFee: initialLogisticsFee,
  discount: { type: 'fixed', value: 0 },
  applyVat: true,
});

// Serializable config for the client-side calculator
const clientConfig = {
  lang,
  catalog: EQUIPMENT_CATALOG,
  categories: CATEGORIES,
  zones: LOCATION_ZONES,
  presets: PRESETS,
  rates: LABOR_RATES,
  vatRate: VAT_RATE,
  whatsappNumber: SITE_CONTACTS.whatsappRaw,
  labels: {
    copiedLink: t("quoteLinkCopied"),
    copiedJson: t("quoteJsonCopied"),
    included: t("quoteIncludedBadge"),
    addBtn: t("quoteAddBtn"),
    removeBtn: t("quoteRemoveBtn"),
    subtotalBeforeVat: t("quoteSubtotalBeforeVat"),
    vat18: t("quoteVat18"),
    grandTotal: t("quoteGrandTotal"),
    icebergTooltipTemplate: t("quoteIcebergTooltip"),
    minTripsWarning: t("quoteMinTripsWarning"),
    badgeProducer: t("quoteBadgeProducer"),
    badgeClientView: t("quoteBadgeClientView"),
    badgeEstimate: t("quoteBadge"),
    defaultHeading: t("quoteDefaultHeading"),
    defaultEventName: t("quoteDefaultEventName"),
    defaultVenue: t("quoteDefaultVenue"),
    serviceDjSet: t("quoteServiceDjSet"),
    servicePreprod: t("quoteServicePreprod"),
    serviceSetup: t("quoteServiceSetup"),
    serviceLogistics: t("quoteServiceLogistics"),
    tripsUnit: t("quoteTripsUnit"),
    presetLoadedToast: t("quotePresetLoadedToast"),
  },
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  lang={lang}
  canonicalPath={canonicalPath}
>
  <!-- Typography for RU (Unbounded) and HE (Rubik) -->
  {lang === "ru" && (
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Unbounded:wght@400;500;600;700;800&display=swap"
      slot="head"
    />
  )}
  {lang === "he" && (
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700;800&display=swap"
      slot="head"
    />
  )}

  <main class="quote-viewport pt-safe pb-safe" id="quoteApp" data-config={JSON.stringify(clientConfig)}>
    <AtmosphereBackground />
    <SiteHeader lang={lang} currentSection="quote" />

    <div class="quote-container">
      <!-- 1. Header Banner -->
      <header class="quote-header">
        <div class="badge-row">
          <span class="badge-pill" id="quoteStatusBadge">{t("quoteBadge")}</span>
          <span class="badge-subtle" id="viewModeIndicator">{t("quoteBadgeProducer")}</span>
        </div>
        <h1 class="quote-title" id="pageMainHeading">{t("quotePageTitle")}</h1>
        <p class="quote-subtitle">{t("quotePageSubtitle")}</p>
      </header>

      <!-- 2. CLIENT PRESENTATION VIEW (Proposal) -->
      <QuoteProposalView initialQuote={initialQuote} lang={lang} />

      <!-- 3. CONSTRUCTOR / BUILDER VIEW -->
      <section class="builder-view" id="builderSection">
        <QuotePresetsBar
          presets={PRESETS}
          activePresetId={initialPreset.id}
          lang={lang}
        />

        <div class="builder-layout">
          <!-- Left Column: Controls & Configuration Cards -->
          <div class="builder-controls">
            <QuoteEventCard
              zones={LOCATION_ZONES}
              selectedZoneId={initialPreset.locationZone}
              lang={lang}
            />
            <QuoteLaborCard
              initialDjHours={initialPreset.djHours}
              initialPreprodHours={initialPreset.preprodHours}
              lang={lang}
            />
            <QuoteCatalogCard
              initialActiveItemIds={initialPreset.equipmentItemIds.map((i) => i.id)}
              initialDaysCount={initialPreset.daysCount}
              lang={lang}
            />
            <QuoteLogisticsCard
              initialTripsCount={initialPreset.tripsCount}
              initialMinTripsCount={initialPreset.minTripsCount}
              initialSetupFee={initialPreset.setupFee}
              initialSetupHours={initialPreset.setupFee / 120}
              initialLogisticsFee={initialLogisticsFee}
              lang={lang}
            />
            <QuoteFinancialsCard lang={lang} />
          </div>

          <!-- Right Column: Sticky Live Receipt -->
          <QuoteStickyReceipt initialQuote={initialQuote} lang={lang} />
        </div>
      </section>

      <!-- Globally Fixed Toast Notification -->
      <div class="toast-bubble hidden" id="toastMessage" role="status" aria-live="polite">
        <span class="icon">check</span>
        <span id="toastText">Copied!</span>
      </div>
    </div>
  </main>
</Layout>

<script>
  import { initQuoteApp } from './controller/quoteController';
  initQuoteApp();
</script>

<style>
  .quote-viewport {
    position: relative;
    min-height: 100vh;
    width: 100%;
    color: var(--color-text-main);
    box-sizing: border-box;
    padding-block-end: 6rem;
  }

  .quote-container {
    position: relative;
    z-index: 10;
    max-width: 1140px;
    width: 100%;
    margin-inline: auto;
    padding-inline: 1.25rem;
    box-sizing: border-box;
  }

  /* Header */
  .quote-header {
    text-align: center;
    padding-block-start: 2rem;
    padding-block-end: 2rem;
  }

  .badge-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-block-end: 0.75rem;
  }

  .badge-pill {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-primary);
    background: var(--color-surface-glass);
    border: 1px solid var(--color-glass-border);
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
  }

  .badge-subtle {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: var(--color-text-subtle);
  }

  .quote-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 700;
    line-height: 1.2;
    margin: 0;
    color: var(--color-text-main);
  }

  .quote-subtitle {
    font-size: clamp(0.95rem, 1.8vw, 1.1rem);
    color: var(--color-text-muted);
    max-width: 680px;
    margin-inline: auto;
    margin-block-start: 0.75rem;
    line-height: 1.5;
  }

  /* Builder Layout */
  .builder-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: start;
  }

  @media (min-width: 960px) {
    .builder-layout {
      grid-template-columns: 1fr 380px;
    }
  }

  .builder-controls {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    min-width: 0;
  }

  /* Globally Fixed Toast bubble */
  .toast-bubble {
    position: fixed;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-primary);
    color: var(--color-on-primary);
    padding: 0.75rem 1.25rem;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    font-weight: 600;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    z-index: 100;
    animation: fadeInToast 0.25s ease;
  }

  @keyframes fadeInToast {
    from {
      opacity: 0;
      transform: translateX(-50%) translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }
  }

  .icon {
    font-family: 'Material Symbols Outlined', sans-serif;
    font-size: 1.2rem;
    vertical-align: middle;
  }

  .hidden {
    display: none !important;
  }
</style>
