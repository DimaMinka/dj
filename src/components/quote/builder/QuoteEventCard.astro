---
import type { SupportedLang } from '../../../i18n/ui';
import { useTranslations } from '../../../i18n/ui';
import type { LocationZoneConfig } from '../../../types/quote';

interface Props {
  zones: LocationZoneConfig[];
  selectedZoneId?: string;
  lang: SupportedLang;
}

const { zones, selectedZoneId = 'upper_galilee', lang } = Astro.props;
const t = useTranslations(lang);
---

<div class="control-card">
  <div class="card-header">
    <span class="icon">event</span>
    <h2>{t("quoteEventDetails")}</h2>
  </div>
  <div class="form-grid">
    <div class="form-field">
      <label for="inputEventName">{t("quoteVenueLabel")}</label>
      <input
        type="text"
        id="inputEventName"
        placeholder={t("quoteVenuePlaceholder")}
        value=""
      />
    </div>
    <div class="form-field">
      <label for="inputClientName">{t("quoteClientNameLabel")}</label>
      <input
        type="text"
        id="inputClientName"
        placeholder={t("quoteClientNamePlaceholder")}
        value=""
      />
    </div>
    <div class="form-field">
      <label for="inputEventDate">{t("quoteDateLabel")}</label>
      <input
        type="date"
        id="inputEventDate"
        value={new Date().toISOString().split("T")[0]}
      />
    </div>
    <div class="form-field">
      <label for="selectLocationZone">{t("quoteZoneLabel")}</label>
      <select id="selectLocationZone">
        {zones.map((zone) => (
          <option value={zone.id} selected={zone.id === selectedZoneId}>
            {zone.name[lang]} ({zone.defaultDurationMin} {t("quoteMinutesUnit")})
          </option>
        ))}
      </select>
    </div>
  </div>
</div>

<style>
  .control-card {
    background: var(--color-surface-glass);
    border: 1px solid var(--color-glass-border);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-radius: var(--radius-lg);
    padding: clamp(1rem, 3.5vw, 1.75rem);
    box-sizing: border-box;
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-block-end: 1.25rem;
    border-block-end: 1px solid var(--color-glass-border);
    padding-block-end: 0.85rem;
  }

  .card-header .icon {
    font-family: 'Material Symbols Outlined', sans-serif;
    color: var(--color-primary);
    font-size: 1.5rem;
  }

  .card-header h2 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    margin: 0;
    color: var(--color-text-main);
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 600px) {
    .form-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-width: 0;
  }

  .form-field label {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .form-field input,
  .form-field select {
    font-family: var(--font-body);
    font-size: 1rem; /* 16px to prevent iOS Safari auto-zoom */
    padding: 0.65rem 0.85rem;
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text-main);
    border: 1px solid var(--color-glass-border);
    outline: none;
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    transition: border-color 0.2s;
    -webkit-appearance: none;
    appearance: none;
  }

  /* iOS Safari native date input fixes */
  .form-field input[type="date"] {
    position: relative;
    display: block;
    -webkit-appearance: none;
    appearance: none;
    min-height: 2.75rem;
    line-height: normal;
  }

  /* Normalize WebKit internal shadow dom date edit controls */
  .form-field input[type="date"]::-webkit-date-and-time-value {
    text-align: start;
    min-height: 1.2em;
    margin: 0;
  }

  .form-field input:focus,
  .form-field select:focus {
    border-color: var(--color-primary);
  }
</style>
