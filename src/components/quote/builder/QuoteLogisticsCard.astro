---
import type { SupportedLang } from '../../../i18n/ui';
import { useTranslations } from '../../../i18n/ui';
import { formatCurrency } from '../../../utils/quoteCalculator';

interface Props {
  initialTripsCount?: number;
  initialMinTripsCount?: number;
  initialSetupFee?: number;
  initialSetupHours?: number;
  initialLogisticsFee?: number;
  lang: SupportedLang;
}

const {
  initialTripsCount = 1,
  initialMinTripsCount = 1,
  initialSetupFee = 480,
  initialSetupHours = 4.0,
  initialLogisticsFee = 100,
  lang,
} = Astro.props;

const t = useTranslations(lang);
const isTrip1Locked = initialMinTripsCount >= 2;
---

<div class="control-card">
  <div class="card-header">
    <span class="icon">local_shipping</span>
    <h2>{t("quoteLogisticsSection")}</h2>
  </div>

  <!-- Trips Selector -->
  <div class="trips-selector-block">
    <span class="field-title">{t("quoteTripsCountLabel")}:</span>
    <div class="trips-toggle-group">
      <button
        type="button"
        class={`trip-toggle-btn ${initialTripsCount === 1 ? 'active' : ''} ${isTrip1Locked ? 'disabled-preset' : ''}`}
        data-trips="1"
        id="tripBtn1"
        title={t("quoteAlwaysIncluded")}
      >
        <span class="trip-badge">1×</span>
        <span class="trip-title-text">{t("quoteTripOne")}</span>
        <span class={`trip-lock-badge ${isTrip1Locked ? '' : 'hidden'}`}>
          <span class="icon">lock</span>
          <span>{t("quoteIncludedBadge")}</span>
        </span>
      </button>
      <button
        type="button"
        class={`trip-toggle-btn ${initialTripsCount === 2 ? 'active' : ''}`}
        data-trips="2"
        id="tripBtn2"
      >
        <span class="trip-badge">2×</span>
        <span class="trip-title-text">{t("quoteTripTwo")}</span>
      </button>
      <button
        type="button"
        class={`trip-toggle-btn ${initialTripsCount === 3 ? 'active' : ''}`}
        data-trips="3"
        id="tripBtn3"
      >
        <span class="trip-badge">3×</span>
        <span class="trip-title-text">{t("quoteTripThree")}</span>
      </button>
    </div>
  </div>

  <div class="form-grid">
    <div class="form-field">
      <label>{t("quoteSetupFeeLabel")}</label>
      <div class="computed-logistics-box">
        <span class="computed-val" id="computedSetupVal">
          <bdi>{formatCurrency(initialSetupFee)} ₪</bdi>
        </span>
        <span class="computed-calc-hint" id="computedSetupHint">
          {initialSetupHours.toFixed(1)}h × 120 ₪/h
        </span>
      </div>
      <span class="field-hint">{t("quoteSetupFeeHint")}</span>
    </div>
    <div class="form-field">
      <label>{t("quoteLogisticsFeeLabel")}</label>
      <div class="computed-logistics-box">
        <span class="computed-val" id="computedLogisticsVal">
          <bdi>{formatCurrency(initialLogisticsFee)} ₪</bdi>
        </span>
        <span class="computed-calc-hint" id="computedLogisticsHint">
          {initialTripsCount} × 100 ₪
        </span>
      </div>
      <span class="field-hint">{t("quoteLogisticsFeeHint")}</span>
    </div>
  </div>
</div>

<style>
  .control-card {
    background: var(--color-surface-glass);
    border: 1px solid var(--color-glass-border);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-radius: var(--radius-lg);
    padding: clamp(1rem, 3.5vw, 1.75rem);
    box-sizing: border-box;
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-block-end: 1.25rem;
    border-block-end: 1px solid var(--color-glass-border);
    padding-block-end: 0.85rem;
  }

  .card-header .icon {
    font-family: 'Material Symbols Outlined', sans-serif;
    color: var(--color-primary);
    font-size: 1.5rem;
  }

  .card-header h2 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    margin: 0;
    color: var(--color-text-main);
  }

  .trips-selector-block {
    margin-block-end: 1.25rem;
  }

  .field-title {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-muted);
    margin-block-end: 0.5rem;
  }

  .trips-toggle-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .trip-toggle-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: clamp(0.55rem, 2vw, 0.65rem) clamp(0.65rem, 2vw, 1rem);
    background: var(--color-surface);
    border: 1px solid var(--color-glass-border);
    color: var(--color-text-main);
    border-radius: var(--radius-md);
    font-family: var(--font-body);
    font-size: 0.85rem;
    cursor: pointer;
    text-align: start;
    transition: all 0.2s;
    box-sizing: border-box;
  }

  .trip-toggle-btn.active {
    background: var(--color-primary-glow);
    border-color: var(--color-primary);
    color: var(--color-primary);
    font-weight: 600;
  }

  .trip-toggle-btn.disabled-preset {
    opacity: 0.65;
    background: rgba(229, 169, 60, 0.04);
    cursor: not-allowed;
    border-color: rgba(229, 169, 60, 0.25);
  }

  .trip-title-text {
    flex: 1 1 auto;
    min-width: 0;
    font-size: clamp(0.8rem, 2.5vw, 0.85rem);
    line-height: 1.35;
  }

  .trip-lock-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--color-primary);
    background: var(--color-primary-glow);
    border: 1px solid var(--color-primary);
    padding: 0.15rem 0.4rem;
    border-radius: var(--radius-full);
    flex-shrink: 0;
    white-space: nowrap;
  }

  .trip-lock-badge .icon {
    font-size: 0.75rem;
  }

  .trip-badge {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    background: var(--color-surface-container);
    padding: 0.2rem 0.45rem;
    border-radius: var(--radius-md);
    flex-shrink: 0;
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 600px) {
    .form-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-field label {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .field-hint {
    font-size: 0.75rem;
    color: var(--color-text-subtle);
  }

  .computed-logistics-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--color-surface);
    border: 1px solid var(--color-glass-border);
    border-radius: var(--radius-md);
    padding: 0.65rem 0.85rem;
    box-sizing: border-box;
    width: 100%;
    gap: 0.5rem;
  }

  .computed-val {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--color-primary);
    font-size: clamp(0.95rem, 3vw, 1.05rem);
    white-space: nowrap;
  }

  .computed-calc-hint {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-subtle);
    white-space: nowrap;
  }

  .computed-calc-hint {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-subtle);
  }

  .hidden {
    display: none !important;
  }
</style>
