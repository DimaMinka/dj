---
import type { SupportedLang } from '../../../i18n/ui';
import { useTranslations } from '../../../i18n/ui';
import {
  EQUIPMENT_CATALOG,
  CATEGORIES,
} from '../../../data/quoteConfig';
import type { EquipmentCategory } from '../../../types/quote';

interface Props {
  initialActiveItemIds?: string[];
  initialDaysCount?: number;
  lang: SupportedLang;
}

const {
  initialActiveItemIds = ['denon_prime', 'udg_stand', 'sound_column', 'retro_center', 'retro_side_round'],
  initialDaysCount = 1,
  lang,
} = Astro.props;

const t = useTranslations(lang);

const categoriesOrder: EquipmentCategory[] = [
  'sound',
  'retro',
  'moving_heads',
  'wash_fx',
  'stands',
];

function formatItemsCount(count: number, currentLang: SupportedLang): string {
  if (currentLang === 'ru') {
    const mod10 = count % 10;
    const mod100 = count % 100;
    if (mod10 === 1 && mod100 !== 11) {
      return `${count} ${t('quoteItemsCountOne')}`;
    }
    if (mod10 >= 2 && mod10 <= 4 && (mod100 < 10 || mod100 >= 20)) {
      return `${count} ${t('quoteItemsCountFew')}`;
    }
    return `${count} ${t('quoteItemsCountMany')}`;
  }
  if (currentLang === 'he') {
    return `${count} ${count === 1 ? t('quoteItemsCountOne') : t('quoteItemsCountMany')}`;
  }
  return `${count} ${count === 1 ? t('quoteItemsCountOne') : t('quoteItemsCountMany')}`;
}
---

<div class="control-card">
  <div class="card-header">
    <span class="icon">light</span>
    <h2>{t("quoteEquipSection")}</h2>
  </div>

  <!-- Days Multiplier Selector -->
  <div class="rental-days-selector">
    <span class="field-title">{t("quoteDaysCountLabel")}:</span>
    <div class="days-toggle-group">
      <button
        type="button"
        class={`day-toggle-btn ${initialDaysCount === 1 ? 'active' : ''}`}
        data-days="1"
      >
        <span>{t("quoteDayOne")}</span>
        <span class="mult-tag">1.0x</span>
      </button>
      <button
        type="button"
        class={`day-toggle-btn ${initialDaysCount === 2 ? 'active' : ''}`}
        data-days="2"
      >
        <span>{t("quoteDayWeekend")}</span>
        <span class="mult-tag">1.6x</span>
      </button>
    </div>
  </div>

  <div class="callout-box">
    <span class="icon">cable</span>
    <p>{t("quoteCustomSetupNotice")}</p>
  </div>

  <!-- Equipment Categories Accordion / Lists -->
  <div class="catalog-categories">
    {categoriesOrder.map((catKey) => {
      const catItems = EQUIPMENT_CATALOG.filter((i) => i.category === catKey);
      return (
        <div class="category-block">
          <div class="category-header">
            <span class="category-title">{CATEGORIES[catKey][lang]}</span>
            <span class="category-count">{formatItemsCount(catItems.length, lang)}</span>
          </div>
          <div class="items-list">
            {catItems.map((item) => {
              const isMandatory = item.id === 'denon_prime' || item.id === 'udg_stand';
              const isInitiallyActive = initialActiveItemIds.includes(item.id);
              return (
                <div
                  class={`item-row ${isMandatory ? 'mandatory-item' : ''}`}
                  data-item-id={item.id}
                  data-price={item.dailyRentalPrice}
                >
                  <div class="item-info">
                    <span class="item-name">{item.name[lang]}</span>
                    <span class="item-rate">
                      {isMandatory ? (
                        <span class="rate-included">{t("quoteIncludedBadge")} (0 ₪)</span>
                      ) : (
                        <>
                          <bdi>{item.dailyRentalPrice} ₪</bdi> / day
                        </>
                      )}
                    </span>
                  </div>
                  <div class="item-toggle-action">
                    {isMandatory ? (
                      <span class="badge-mandatory" title={t("quoteAlwaysIncluded")}>
                        <span class="icon">lock</span>
                        <span>{t("quoteIncludedBadge")}</span>
                      </span>
                    ) : (
                      <button
                        type="button"
                        class={`toggle-equip-btn ${isInitiallyActive ? 'active' : ''}`}
                        data-id={item.id}
                        data-qty={item.defaultQty}
                        aria-pressed={isInitiallyActive ? 'true' : 'false'}
                        aria-label={isInitiallyActive ? t("quoteRemoveBtn") : t("quoteAddBtn")}
                        title={isInitiallyActive ? t("quoteRemoveBtn") : t("quoteAddBtn")}
                      >
                        <span class="toggle-icon">{isInitiallyActive ? 'close' : 'add'}</span>
                        <span class="toggle-text">
                          {isInitiallyActive ? t("quoteRemoveBtn") : t("quoteAddBtn")}
                        </span>
                      </button>
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      );
    })}
  </div>
</div>

<style>
  .control-card {
    background: var(--color-surface-glass);
    border: 1px solid var(--color-glass-border);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-radius: var(--radius-lg);
    padding: clamp(1rem, 3.5vw, 1.75rem);
    box-sizing: border-box;
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-block-end: 1.25rem;
    border-block-end: 1px solid var(--color-glass-border);
    padding-block-end: 0.85rem;
  }

  .card-header .icon {
    font-family: 'Material Symbols Outlined', sans-serif;
    color: var(--color-primary);
    font-size: 1.5rem;
  }

  .card-header h2 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    margin: 0;
    color: var(--color-text-main);
  }

  /* Rental days selector */
  .rental-days-selector {
    margin-block-end: 1.25rem;
  }

  .field-title {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-muted);
    margin-block-end: 0.5rem;
  }

  .days-toggle-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  @media (max-width: 480px) {
    .days-toggle-group {
      flex-direction: column;
    }
  }

  .day-toggle-btn {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 0.85rem;
    background: var(--color-surface);
    border: 1px solid var(--color-glass-border);
    color: var(--color-text-main);
    border-radius: var(--radius-md);
    font-family: var(--font-body);
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.2s;
    gap: 0.5rem;
  }

  .day-toggle-btn.active {
    background: var(--color-primary-glow);
    border-color: var(--color-primary);
    color: var(--color-primary);
    font-weight: 600;
  }

  .mult-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    background: var(--color-surface-container);
    padding: 0.2rem 0.4rem;
    border-radius: var(--radius-md);
    flex-shrink: 0;
  }

  /* Callout box */
  .callout-box {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    background: var(--color-surface);
    border-inline-start: 3px solid var(--color-primary);
    padding: 0.85rem 1rem;
    border-radius: var(--radius-md);
    margin-block-start: 0.75rem;
  }

  .callout-box .icon {
    font-family: 'Material Symbols Outlined', sans-serif;
    color: var(--color-primary);
    font-size: 1.25rem;
    flex-shrink: 0;
    margin-block-start: 0.1rem;
  }

  .callout-box p {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  /* Catalog Categories */
  .catalog-categories {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-block-start: 1.5rem;
  }

  .category-block {
    background: var(--color-surface);
    border: 1px solid var(--color-glass-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .category-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1rem;
    background: var(--color-surface-container);
    border-block-end: 1px solid var(--color-glass-border);
  }

  .category-title {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-text-main);
  }

  .category-count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-subtle);
  }

  .items-list {
    display: flex;
    flex-direction: column;
  }

  .item-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: clamp(0.6rem, 2vw, 0.75rem) clamp(0.65rem, 2.5vw, 1rem);
    border-block-end: 1px solid var(--color-glass-border);
    gap: 0.5rem;
  }

  .item-row:last-child {
    border-block-end: none;
  }

  .item-info {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    flex: 1 1 auto;
    min-width: 0;
  }

  .item-name {
    font-size: clamp(0.85rem, 2.6vw, 0.9rem);
    font-weight: 500;
    color: var(--color-text-main);
    word-break: break-word;
    line-height: 1.35;
  }

  .item-rate {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-primary);
    white-space: nowrap;
  }

  .item-toggle-action {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .badge-mandatory {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-primary);
    background: var(--color-primary-glow);
    border: 1px solid var(--color-primary);
    padding: 0.3rem 0.55rem;
    border-radius: var(--radius-full);
    white-space: nowrap;
  }

  .badge-mandatory .icon {
    font-size: 0.85rem;
  }

  .toggle-equip-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 600;
    padding: 0.35rem clamp(0.55rem, 2vw, 0.85rem);
    border-radius: var(--radius-full);
    cursor: pointer;
    background: var(--color-surface-container);
    border: 1px solid var(--color-glass-border);
    color: var(--color-text-subtle);
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .toggle-equip-btn {
      width: 2.1rem;
      height: 2.1rem;
      padding: 0;
      border-radius: var(--radius-full);
    }

    .toggle-equip-btn .toggle-text {
      display: none;
    }

    .toggle-equip-btn .toggle-icon {
      font-size: 1.15rem;
      margin: 0;
    }
  }

  .toggle-equip-btn .toggle-icon {
    font-family: 'Material Symbols Outlined', sans-serif;
    font-size: 1rem;
  }

  .toggle-equip-btn:hover {
    border-color: var(--color-glass-border);
    color: var(--color-text-main);
  }

  .toggle-equip-btn.active {
    background: rgba(220, 76, 76, 0.12);
    border-color: rgba(220, 76, 76, 0.35);
    color: #e06c75;
  }

  .toggle-equip-btn.active:hover {
    background: rgba(220, 76, 76, 0.2);
    border-color: rgba(220, 76, 76, 0.5);
    color: #ef8b93;
  }

  .mandatory-item {
    background: rgba(229, 169, 60, 0.03);
  }

  .rate-included {
    font-family: var(--font-mono);
    color: var(--color-primary);
    font-weight: 600;
  }
</style>
