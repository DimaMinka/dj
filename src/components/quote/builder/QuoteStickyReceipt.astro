---
import type { SupportedLang } from '../../../i18n/ui';
import { useTranslations } from '../../../i18n/ui';
import type { QuoteSnapshot } from '../../../types/quote';
import { formatCurrency } from '../../../utils/quoteCalculator';
import QuoteIcebergWidget from '../shared/QuoteIcebergWidget.astro';

interface Props {
  initialQuote: QuoteSnapshot;
  lang: SupportedLang;
}

const { initialQuote, lang } = Astro.props;
const t = useTranslations(lang);
---

<aside class="builder-receipt-col">
  <div class="receipt-card sticky-receipt">
    <div class="receipt-header">
      <span class="receipt-badge">{t("quoteLiveEstimateBadge")}</span>
      <div class="receipt-title-row">
        <h3 class="receipt-title">{t("quoteSummaryTitle")}</h3>
        <!-- Iceberg Ratio Box in Title Row -->
        <div class="iceberg-ratio-box" id="recIcebergRatioBox" tabindex="0" role="button" aria-label={t("quoteIcebergTitle")}>
          <span class="iceberg-ratio-tag">1 : <span id="recIcebergRatioVal">2.5</span></span>
          <span class="material-symbols-outlined ratio-info-icon" aria-hidden="true">info</span>
          <div class="ratio-tooltip" id="recIcebergTooltip" role="tooltip">
            {t("quoteIcebergTooltip").replace("{ratio}", "2.5")}
          </div>
        </div>
      </div>
    </div>

    <!-- Iceberg Indicator inside Receipt -->
    <QuoteIcebergWidget
      variant="receipt"
      stageHours={initialQuote.services.djPerformanceHours}
      behindHours={initialQuote.services.preprodHours + 4.0}
      lang={lang}
    />

    <!-- Itemized Receipt Lines -->
    <div class="receipt-lines">
      <div class="rec-line">
        <span>{t("quoteEquipRentalLabel")}</span>
        <span class="rec-val" id="recEquipSubtotal">
          <bdi>{formatCurrency(initialQuote.equipment.subtotal)} ₪</bdi>
        </span>
      </div>
      <div class="rec-line">
        <span>{t("quoteMusicServicesLabel")}</span>
        <span class="rec-val" id="recServicesSubtotal">
          <bdi>{formatCurrency(initialQuote.services.subtotal)} ₪</bdi>
        </span>
      </div>
      <div class="rec-line gross-line">
        <span>{t("quoteGrossSubtotalLabel")}</span>
        <span class="rec-val" id="recGrossTotal">
          <bdi>{formatCurrency(initialQuote.financials.grossTotal)} ₪</bdi>
        </span>
      </div>
      <div class="rec-line discount-line hidden" id="recDiscountLine">
        <span>{t("quoteDiscountLabel")}</span>
        <span class="rec-val discount-val">- <span id="recDiscountAmount"><bdi>0 ₪</bdi></span></span>
      </div>
      <div class="rec-line net-line">
        <span>{t("quoteSubtotalBeforeVat")}</span>
        <span class="rec-val" id="recNetTotal">
          <bdi>{formatCurrency(initialQuote.financials.netTotal)} ₪</bdi>
        </span>
      </div>
      <div class="rec-line vat-line" id="recVatLine">
        <span>{t("quoteVat18")}</span>
        <span class="rec-val">+ <span id="recVatAmount"><bdi>{formatCurrency(initialQuote.financials.vatAmount)} ₪</bdi></span></span>
      </div>
      <div class="rec-total-line">
        <span id="recTotalLabel">{t("quoteGrandTotal")}</span>
        <span class="grand-price" id="recGrandTotal">
          <bdi>{formatCurrency(initialQuote.financials.grandTotal)} ₪</bdi>
        </span>
      </div>
    </div>

    <!-- Quick Action Buttons -->
    <div class="receipt-actions">
      <button type="button" class="btn-copy-link" id="btnShareClientLink">
        <span class="icon">share</span>
        <span>{t("quoteShareLink")}</span>
      </button>
      <button type="button" class="btn-preview-prop" id="btnPreviewProposal">
        <span class="icon">visibility</span>
        <span>{t("quotePreviewClientBtn")}</span>
      </button>
      <a href="#" class="btn-whatsapp-send" id="btnWhatsAppDirect" target="_blank" rel="noopener noreferrer">
        <span class="material-symbols-outlined cta-wa-icon" aria-hidden="true">chat</span>
        <span class="cta-wa-text">{t("quoteDiscussWhatsAppBtn")}</span>
        <span class="material-symbols-outlined cta-arrow-icon" aria-hidden="true">arrow_forward</span>
      </a>
      <button type="button" class="btn-copy-json" id="btnCopyJsonSnapshot">
        <span class="icon">data_object</span>
        <span>{t("quoteCopyJson")}</span>
      </button>
    </div>
  </div>
</aside>

<style>
  .builder-receipt-col {
    position: relative;
    height: 100%;
  }

  .sticky-receipt {
    position: sticky;
    top: 5.5rem;
    z-index: 25;
    background: var(--color-surface-glass);
    border: 1px solid var(--color-glass-border);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-radius: var(--radius-lg);
    padding: clamp(1rem, 3vw, 1.5rem);
    box-sizing: border-box;
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.25);
  }

  .receipt-header {
    border-block-end: 1px solid var(--color-glass-border);
    padding-block-end: 1rem;
    margin-block-end: 1rem;
  }

  .receipt-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-block-start: 0.35rem;
  }

  .receipt-badge {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    color: var(--color-primary);
  }

  .receipt-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    margin: 0;
  }

  /* Iceberg ratio box in header */
  .iceberg-ratio-box {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.2rem 0.55rem;
    background: rgba(147, 197, 253, 0.08);
    border: 1px solid rgba(147, 197, 253, 0.25);
    border-radius: var(--radius-full);
    cursor: help;
    user-select: none;
    transition: all 0.2s ease;
  }

  .iceberg-ratio-box:hover,
  .iceberg-ratio-box:focus-visible {
    background: rgba(147, 197, 253, 0.16);
    border-color: var(--color-resonance);
    outline: none;
  }

  .iceberg-ratio-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-resonance);
    letter-spacing: 0.04em;
  }

  .ratio-info-icon {
    font-size: 0.95rem;
    color: var(--color-resonance);
    opacity: 0.85;
  }

  .ratio-tooltip {
    position: absolute;
    bottom: calc(100% + 8px);
    right: 50%;
    transform: translateX(50%) translateY(4px);
    width: max-content;
    max-width: min(280px, calc(100vw - 32px));
    padding: 0.65rem 0.85rem;
    background: rgba(15, 17, 23, 0.96);
    border: 1px solid var(--color-glass-border);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-radius: var(--radius-md);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
    color: var(--color-text-main);
    font-family: var(--font-body);
    font-size: 0.75rem;
    line-height: 1.45;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
    z-index: 50;
    text-align: start;
  }

  :global([dir="rtl"]) .ratio-tooltip {
    right: auto;
    left: 50%;
    transform: translateX(-50%) translateY(4px);
    text-align: start;
  }

  .iceberg-ratio-box:hover .ratio-tooltip,
  .iceberg-ratio-box:focus-visible .ratio-tooltip {
    opacity: 1;
    visibility: visible;
    transform: translateX(50%) translateY(0);
  }

  :global([dir="rtl"]) .iceberg-ratio-box:hover .ratio-tooltip,
  :global([dir="rtl"]) .iceberg-ratio-box:focus-visible .ratio-tooltip {
    transform: translateX(-50%) translateY(0);
  }

  :global(html[data-theme="day"]:not(.dark)) .ratio-tooltip {
    background: rgba(255, 255, 255, 0.96);
    border-color: rgba(0, 0, 0, 0.12);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
    color: #1a1a1a;
  }

  /* Receipt Lines */
  .receipt-lines {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    font-size: 0.9rem;
    border-block-end: 1px solid var(--color-glass-border);
    padding-block-end: 1rem;
    margin-block-end: 1.25rem;
  }

  .rec-line {
    display: flex;
    justify-content: space-between;
    color: var(--color-text-muted);
  }

  .rec-line.gross-line {
    border-block-start: 1px dashed var(--color-glass-border);
    padding-block-start: 0.5rem;
  }

  .rec-line.net-line {
    font-weight: 600;
    color: var(--color-text-main);
  }

  .rec-val {
    font-family: var(--font-mono);
  }

  .discount-val {
    color: #10b981;
  }

  .rec-total-line {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--color-text-main);
    padding-block-start: 0.5rem;
  }

  .grand-price {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    color: var(--color-primary);
  }

  /* Actions */
  .receipt-actions {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .btn-copy-link,
  .btn-preview-prop,
  .btn-copy-json {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 600;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    cursor: pointer;
    text-decoration: none;
    transition: all 0.2s;
    box-sizing: border-box;
    width: 100%;
  }

  .btn-copy-link {
    background: var(--color-primary);
    color: var(--color-on-primary);
    border: none;
  }

  .btn-copy-link:hover {
    background: var(--color-primary-container);
    box-shadow: 0 0 16px var(--color-primary-glow);
  }

  .btn-preview-prop {
    background: var(--color-surface);
    border: 1px solid var(--color-glass-border);
    color: var(--color-text-main);
  }

  .btn-preview-prop:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .btn-whatsapp-send {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    width: 100%;
    padding-block: 0.85rem;
    padding-inline: 1.25rem;
    border-radius: var(--radius-full);
    background: rgba(37, 211, 102, 0.12);
    border: 1px solid rgba(37, 211, 102, 0.32);
    color: #25d366;
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    box-shadow: 0 2px 12px rgba(37, 211, 102, 0.1);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-sizing: border-box;
    cursor: pointer;
    transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease, color 0.2s ease;
  }

  .btn-whatsapp-send:hover {
    transform: translateY(-1px);
    background: rgba(37, 211, 102, 0.18);
    border-color: rgba(37, 211, 102, 0.5);
    box-shadow: 0 4px 18px rgba(37, 211, 102, 0.2);
    color: #34e77a;
  }

  :global(html[data-theme="day"]:not(.dark)) .btn-whatsapp-send {
    background: rgba(26, 158, 76, 0.1);
    border-color: rgba(26, 158, 76, 0.3);
    color: #1a9e4c;
    box-shadow: 0 2px 10px rgba(26, 158, 76, 0.08);
  }

  :global(html[data-theme="day"]:not(.dark)) .btn-whatsapp-send:hover {
    background: rgba(26, 158, 76, 0.16);
    border-color: rgba(26, 158, 76, 0.45);
    color: #127a38;
    box-shadow: 0 4px 14px rgba(26, 158, 76, 0.15);
  }

  .cta-wa-icon {
    font-size: 1.15rem;
    flex-shrink: 0;
    font-variation-settings: 'FILL' 1;
  }

  .cta-wa-text {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cta-arrow-icon {
    font-size: 1rem;
    flex-shrink: 0;
    opacity: 0.85;
    transition: transform 0.2s ease;
  }

  :global([dir="rtl"]) .cta-arrow-icon {
    transform: rotate(180deg);
  }

  .btn-whatsapp-send:hover .cta-arrow-icon {
    transform: translateX(3px);
  }

  :global([dir="rtl"]) .btn-whatsapp-send:hover .cta-arrow-icon {
    transform: rotate(180deg) translateX(-3px);
  }

  .btn-copy-json {
    background: transparent;
    border: 1px dashed var(--color-glass-border);
    color: var(--color-text-subtle);
    font-size: 0.8rem;
  }

  .btn-copy-json:hover {
    color: var(--color-text-main);
    border-color: var(--color-text-muted);
  }

  .icon {
    font-family: 'Material Symbols Outlined', sans-serif;
    font-size: 1.2rem;
    vertical-align: middle;
  }

  .hidden {
    display: none !important;
  }
</style>
