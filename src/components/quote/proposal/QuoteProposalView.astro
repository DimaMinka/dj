---
import type { SupportedLang } from '../../../i18n/ui';
import { useTranslations } from '../../../i18n/ui';
import type { QuoteSnapshot } from '../../../types/quote';
import { formatCurrency } from '../../../utils/quoteCalculator';
import QuoteIcebergWidget from '../shared/QuoteIcebergWidget.astro';

interface Props {
  initialQuote: QuoteSnapshot;
  lang: SupportedLang;
}

const { initialQuote, lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="client-proposal-view hidden" id="clientProposalSection">
  <div class="proposal-card">
    <div class="proposal-top-header">
      <div>
        <span class="proposal-meta-tag">{t("quoteClientViewBadge")}</span>
        <h2 class="proposal-event-name" id="propEventName">
          {initialQuote.client.venueName || t("quoteDefaultEventName")}
        </h2>
        <div class="proposal-event-meta">
          <span id="propVenue">{initialQuote.client.venueName || t("quoteDefaultVenue")}</span>
          <span class="sep">•</span>
          <span id="propDate">{initialQuote.client.eventDate}</span>
          <span class="sep">•</span>
          <span id="propZone">{initialQuote.client.locationZone}</span>
        </div>
      </div>
    </div>

    <!-- Production Iceberg Meter -->
    <QuoteIcebergWidget
      variant="proposal"
      stageHours={initialQuote.services.djPerformanceHours}
      behindHours={initialQuote.services.preprodHours + 4.0}
      lang={lang}
    />

    <!-- Itemized Equipment List Accordion -->
    <div class="proposal-section">
      <button type="button" class="proposal-accordion-toggle" id="togglePropEquip" aria-expanded="false">
        <div class="accordion-title-col">
          <div class="accordion-heading-row">
            <span class="icon section-icon">light</span>
            <h3 class="section-heading">{t("quoteEquipSection")}</h3>
          </div>
          <p class="section-notice">
            <span class="icon">cable</span>
            <span>{t("quoteCustomSetupNotice")}</span>
          </p>
        </div>
        <div class="accordion-meta-col">
          <span class="accordion-price" id="propEquipTotalVal">
            <bdi>{formatCurrency(initialQuote.equipment.subtotal)} ₪</bdi>
          </span>
          <span class="material-symbols-outlined accordion-arrow" aria-hidden="true">expand_more</span>
        </div>
      </button>
      <div class="proposal-accordion-content hidden" id="propEquipContent">
        <div class="prop-modern-list" id="propEquipmentList">
          <!-- Dynamically rendered as modern grid cards -->
        </div>
      </div>
    </div>

    <!-- Services Breakdown Accordion -->
    <div class="proposal-section">
      <button type="button" class="proposal-accordion-toggle" id="togglePropServices" aria-expanded="false">
        <div class="accordion-title-col">
          <div class="accordion-heading-row">
            <span class="icon section-icon">headphones</span>
            <h3 class="section-heading">{t("quoteLaborSection")}</h3>
          </div>
          <p class="section-notice">
            <span class="icon">music_cast</span>
            <span>{t("quoteLiveRequestsNotice")}</span>
          </p>
        </div>
        <div class="accordion-meta-col">
          <span class="accordion-price" id="propServicesTotalVal">
            <bdi>{formatCurrency(initialQuote.services.subtotal)} ₪</bdi>
          </span>
          <span class="material-symbols-outlined accordion-arrow" aria-hidden="true">expand_more</span>
        </div>
      </button>
      <div class="proposal-accordion-content hidden" id="propServicesContent">
        <div class="prop-modern-list" id="propServicesList">
          <!-- Dynamically rendered as modern grid cards -->
        </div>
      </div>
    </div>

    <!-- Financial Summary -->
    <div class="proposal-financials">
      <div class="financial-row">
        <span>{t("quoteSubtotalBeforeVat")}</span>
        <span class="val" id="propSubtotalVal"><bdi>{formatCurrency(initialQuote.financials.grossTotal)} ₪</bdi></span>
      </div>
      <div class="financial-row discount-row hidden" id="propDiscountRow">
        <span id="propDiscountLabel">{t("quoteDiscountLabel")}</span>
        <span class="val discount-val">- <span id="propDiscountVal"><bdi>0 ₪</bdi></span></span>
      </div>
      <div class="financial-row vat-row" id="propVatRow">
        <span>{t("quoteVat18")}</span>
        <span class="val" id="propVatVal"><bdi>+ {formatCurrency(initialQuote.financials.vatAmount)} ₪</bdi></span>
      </div>
      <div class="financial-row total-row">
        <span id="propTotalLabel">{t("quoteGrandTotal")}</span>
        <span class="grand-val" id="propGrandTotalVal"><bdi>{formatCurrency(initialQuote.financials.grandTotal)} ₪</bdi></span>
      </div>
    </div>

    <!-- Proposal Call To Actions -->
    <div class="proposal-actions">
      <a href="#" class="btn-primary-action btn-whatsapp-send" id="propWhatsAppConfirmBtn" target="_blank" rel="noopener noreferrer">
        <span class="material-symbols-outlined cta-wa-icon" aria-hidden="true">chat</span>
        <span class="cta-wa-text">{t("quoteConfirmWhatsApp")}</span>
        <span class="material-symbols-outlined cta-arrow-icon" aria-hidden="true">arrow_forward</span>
      </a>
      <div class="aux-actions">
        <button type="button" class="btn-secondary-action" id="btnEditQuote">
          <span class="icon">tune</span>
          <span>{t("quoteEditMode")}</span>
        </button>
        <button type="button" class="btn-secondary-action" id="propShareLinkBtn">
          <span class="icon">share</span>
          <span>{t("quoteShareLink")}</span>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .client-proposal-view {
    max-width: 840px;
    margin-inline: auto;
  }

  .proposal-card {
    background: var(--color-surface-glass);
    border: 1px solid var(--color-glass-border);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-radius: var(--radius-xl);
    padding: clamp(1rem, 3.5vw, 2.75rem);
    box-sizing: border-box;
  }

  .proposal-top-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    border-block-end: 1px solid var(--color-glass-border);
    padding-block-end: 1.5rem;
    margin-block-end: 1.75rem;
  }

  .proposal-meta-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    color: var(--color-primary);
    text-transform: uppercase;
  }

  .proposal-event-name {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    margin: 0.35rem 0;
    color: var(--color-text-main);
  }

  .proposal-event-meta {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .sep {
    color: var(--color-text-subtle);
  }

  .proposal-section {
    margin-block-end: 1.5rem;
    border: 1px solid var(--color-glass-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    overflow: hidden;
    transition: border-color 0.2s ease;
  }

  .proposal-section:hover {
    border-color: rgba(229, 169, 60, 0.3);
  }

  .proposal-accordion-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: clamp(0.75rem, 2.5vw, 1.15rem) clamp(0.75rem, 3vw, 1.25rem);
    background: transparent;
    border: none;
    color: inherit;
    cursor: pointer;
    text-align: start;
    gap: 0.65rem;
    transition: background 0.2s ease;
    box-sizing: border-box;
  }

  .proposal-accordion-toggle:hover {
    background: rgba(255, 255, 255, 0.02);
  }

  .accordion-title-col {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
    flex: 1 1 auto;
  }

  .accordion-heading-row {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .section-icon {
    font-size: 1.2rem;
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .section-heading {
    font-family: var(--font-display);
    font-size: clamp(0.92rem, 3vw, 1.15rem);
    color: var(--color-text-main);
    margin: 0;
    line-height: 1.3;
    word-break: break-word;
  }

  .section-notice {
    display: flex;
    align-items: flex-start;
    gap: 0.35rem;
    font-size: clamp(0.72rem, 2.2vw, 0.78rem);
    color: var(--color-text-subtle);
    margin: 0.15rem 0 0 0;
    line-height: 1.35;
  }

  .section-notice .icon {
    font-family: 'Material Symbols Outlined', sans-serif;
    color: var(--color-primary);
    font-size: 0.9rem;
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .accordion-meta-col {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
  }

  .accordion-price {
    font-family: var(--font-mono);
    font-size: clamp(0.95rem, 3.2vw, 1.25rem);
    font-weight: 700;
    color: var(--color-primary);
    white-space: nowrap;
    text-align: end;
  }

  :global([dir="rtl"]) .accordion-price {
    text-align: start;
  }

  .accordion-arrow {
    font-size: 1.25rem;
    color: var(--color-text-subtle);
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  .proposal-accordion-content {
    border-block-start: 1px solid var(--color-glass-border);
    background: var(--color-surface-dim);
    padding: clamp(0.35rem, 1.5vw, 0.5rem);
  }

  :global(html[data-theme="day"]:not(.dark)) .proposal-accordion-content {
    background: #faf6f8;
    border-block-start-color: rgba(217, 119, 6, 0.2);
  }

  .prop-modern-list {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  /* Global rules for dynamically injected cards */
  :global(.prop-modern-list .prop-card-row) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 0.75rem;
    padding: clamp(0.55rem, 2vw, 0.75rem) clamp(0.65rem, 2.5vw, 1rem);
    background: var(--color-surface);
    border: 1px solid var(--color-glass-border);
    border-radius: var(--radius-md);
    transition: all 0.2s ease;
    box-sizing: border-box;
  }

  :global(.prop-modern-list .prop-card-row:hover) {
    border-color: rgba(229, 169, 60, 0.35);
    background: var(--color-surface-container);
  }

  :global(html[data-theme="day"]:not(.dark) .prop-modern-list .prop-card-row) {
    background: #ffffff;
    border-color: rgba(217, 119, 6, 0.15);
  }

  :global(html[data-theme="day"]:not(.dark) .prop-modern-list .prop-card-row:hover) {
    border-color: rgba(217, 119, 6, 0.35);
    background: #fffdf9;
  }

  :global(.prop-modern-list .prop-card-main) {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    flex: 1 1 auto;
    min-width: 0;
  }

  :global(.prop-modern-list .prop-card-name) {
    font-weight: 600;
    font-size: clamp(0.82rem, 2.5vw, 0.92rem);
    color: var(--color-text-main);
    line-height: 1.35;
    word-break: break-word;
  }

  :global(.prop-modern-list .prop-card-sub) {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-text-subtle);
    word-break: break-word;
    line-height: 1.3;
  }

  :global(.prop-modern-list .prop-card-aside) {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
  }

  :global(.prop-modern-list .prop-qty-pill) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 22px;
    height: 20px;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.7rem;
    color: var(--color-primary);
    background: var(--color-primary-glow);
    border: 1px solid var(--color-primary);
    padding: 0 0.35rem;
    border-radius: var(--radius-full);
    flex-shrink: 0;
  }

  :global(.prop-modern-list .prop-card-price) {
    font-family: var(--font-mono);
    font-size: clamp(0.82rem, 2.6vw, 0.95rem);
    font-weight: 700;
    color: var(--color-text-main);
    white-space: nowrap;
    text-align: end;
    flex-shrink: 0;
  }

  :global([dir="rtl"] .prop-modern-list .prop-card-price) {
    text-align: start;
  }

  :global(.prop-modern-list .rate-included) {
    font-family: var(--font-mono);
    color: var(--color-primary);
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    white-space: nowrap;
    flex-shrink: 0;
  }

  @media (max-width: 380px) {
    :global(.prop-modern-list .prop-card-row) {
      padding: 0.55rem 0.65rem;
      gap: 0.4rem;
    }

    :global(.prop-modern-list .prop-card-aside) {
      gap: 0.3rem;
    }
  }

  /* Proposal Financials */
  .proposal-financials {
    background: var(--color-surface);
    border: 1px solid var(--color-glass-border);
    border-radius: var(--radius-lg);
    padding: clamp(0.85rem, 3vw, 1.5rem);
    margin-block-end: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .financial-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.95rem;
    color: var(--color-text-muted);
    gap: 0.5rem;
  }

  .financial-row .val {
    white-space: nowrap;
    flex-shrink: 0;
  }

  .financial-row.total-row {
    border-block-start: 1px solid var(--color-glass-border);
    padding-block-start: 0.85rem;
    font-weight: 700;
    font-size: clamp(1rem, 3.5vw, 1.25rem);
    color: var(--color-text-main);
  }

  .financial-row .grand-val {
    font-family: var(--font-mono);
    font-size: clamp(1.4rem, 5.5vw, 1.75rem);
    color: var(--color-primary);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .discount-val {
    color: #10b981;
  }

  /* Actions */
  .proposal-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .aux-actions {
    display: flex;
    gap: 0.75rem;
  }

  @media (max-width: 420px) {
    .aux-actions {
      flex-direction: column;
    }
  }

  .btn-secondary-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 600;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    cursor: pointer;
    background: var(--color-surface);
    border: 1px solid var(--color-glass-border);
    color: var(--color-text-main);
    transition: all 0.2s;
    flex: 1;
  }

  .btn-secondary-action:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  /* WhatsApp CTA Button */
  .btn-whatsapp-send {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    padding-block: 0.85rem;
    padding-inline: clamp(0.75rem, 3vw, 1.25rem);
    border-radius: var(--radius-full);
    background: rgba(37, 211, 102, 0.12);
    border: 1px solid rgba(37, 211, 102, 0.32);
    color: #25d366;
    font-family: var(--font-body);
    font-size: clamp(0.76rem, 2.5vw, 0.85rem);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    box-shadow: 0 2px 12px rgba(37, 211, 102, 0.1);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-sizing: border-box;
    cursor: pointer;
    transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease, color 0.2s ease;
  }

  .btn-whatsapp-send:hover {
    transform: translateY(-1px);
    background: rgba(37, 211, 102, 0.18);
    border-color: rgba(37, 211, 102, 0.5);
    box-shadow: 0 4px 18px rgba(37, 211, 102, 0.2);
    color: #34e77a;
  }

  :global(html[data-theme="day"]:not(.dark)) .btn-whatsapp-send {
    background: rgba(26, 158, 76, 0.1);
    border-color: rgba(26, 158, 76, 0.3);
    color: #1a9e4c;
    box-shadow: 0 2px 10px rgba(26, 158, 76, 0.08);
  }

  :global(html[data-theme="day"]:not(.dark)) .btn-whatsapp-send:hover {
    background: rgba(26, 158, 76, 0.16);
    border-color: rgba(26, 158, 76, 0.45);
    color: #127a38;
    box-shadow: 0 4px 14px rgba(26, 158, 76, 0.15);
  }

  .cta-wa-icon {
    font-size: 1.15rem;
    flex-shrink: 0;
    font-variation-settings: 'FILL' 1;
  }

  .cta-wa-text {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 380px) {
    .cta-wa-text {
      white-space: normal;
      text-align: center;
      line-height: 1.25;
    }
  }

  .cta-arrow-icon {
    font-size: 1rem;
    flex-shrink: 0;
    opacity: 0.85;
    transition: transform 0.2s ease;
  }

  :global([dir="rtl"]) .cta-arrow-icon {
    transform: rotate(180deg);
  }

  .btn-whatsapp-send:hover .cta-arrow-icon {
    transform: translateX(3px);
  }

  :global([dir="rtl"]) .btn-whatsapp-send:hover .cta-arrow-icon {
    transform: rotate(180deg) translateX(-3px);
  }

  .icon {
    font-family: 'Material Symbols Outlined', sans-serif;
    font-size: 1.2rem;
    vertical-align: middle;
  }

  .hidden {
    display: none !important;
  }
</style>
