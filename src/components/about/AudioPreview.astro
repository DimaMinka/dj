---
import type { SupportedLang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/ui';

interface Props {
  id?: string;
  trackId?: string;
  lang?: SupportedLang;
  badgeTag?: string;
  badgeBpm?: string;
  trackTitle?: string;
  trackSubtitle?: string;
  ariaLabel?: string;
  audioSrc?: string;
  baseFreq?: number;
  subFreq?: number;
}

const {
  id = 'aboutAudioPreview',
  trackId = 'default',
  lang = 'en',
  badgeTag,
  badgeBpm,
  trackTitle,
  trackSubtitle,
  ariaLabel,
  audioSrc,
  baseFreq = 432,
  subFreq = 216,
} = Astro.props;

const t = useTranslations(lang);
const displayTag = badgeTag || t("audioBadgeTag") || "SUNSET SESSION";
const displayBpm = badgeBpm || t("audioBadgeBpm") || "122 BPM MELODIC";
const displayTitle = trackTitle || t("audioTrackTitle") || "Galilee Sunset Resonance";
const displaySubtitle = trackSubtitle || t("audioTrackSubtitle") || "Organic House • Live recorded for hillside terraces & wine evenings";
const displayAria = ariaLabel || t("audioPlayAria") || "Play Sunset & Organic House soundscape preview";
---

<div
  class="audio-preview-card"
  id={id}
  data-audio-card
  data-track-id={trackId}
  data-audio-src={audioSrc || ""}
  data-base-freq={baseFreq}
  data-sub-freq={subFreq}
>
  <div class="audio-glow" aria-hidden="true"></div>

  <div class="audio-content">
    <div class="audio-header">
      <div class="audio-badge-group">
        <span class="freq-pill">
          <span class="live-dot" aria-hidden="true"></span>
          <span>{displayTag}</span>
        </span>
        <span class="bpm-pill">{displayBpm}</span>
      </div>

      <div class="eq-bars" data-eq-bars aria-hidden="true">
        <span class="bar bar-1"></span>
        <span class="bar bar-2"></span>
        <span class="bar bar-3"></span>
        <span class="bar bar-4"></span>
        <span class="bar bar-5"></span>
        <span class="bar bar-6"></span>
      </div>
    </div>

    <div class="track-row">
      <button
        type="button"
        class="play-btn"
        data-play-btn
        aria-label={displayAria}
      >
        <span class="material-symbols-outlined play-icon" data-play-icon aria-hidden="true">play_arrow</span>
      </button>

      <div class="track-meta">
        <span class="track-title">{displayTitle}</span>
        <span class="track-subtitle">{displaySubtitle}</span>
      </div>
    </div>

    <!-- Audio element for MP3 playback -->
    <audio data-audio-element src={audioSrc || undefined} preload="metadata" aria-hidden="true"></audio>
  </div>
</div>

<script>
  (function initAudioCards() {
    // Shared audio context and registry so multiple cards coordinate smoothly
    let audioCtx: AudioContext | null = null;
    let osc1: OscillatorNode | null = null;
    let osc2: OscillatorNode | null = null;
    let gainNode: GainNode | null = null;
    let activeCard: HTMLElement | null = null;
    let eqInterval: ReturnType<typeof setInterval> | null = null;

    const cards = document.querySelectorAll<HTMLElement>('[data-audio-card]');
    if (!cards.length) return;

    let currentAudioEl: HTMLAudioElement | null = null;

    function stopPlayback() {
      if (currentAudioEl) {
        try {
          currentAudioEl.pause();
          currentAudioEl.currentTime = 0;
        } catch (e) {}
        currentAudioEl = null;
      }

      if (gainNode && audioCtx) {
        try {
          const ct = audioCtx.currentTime;
          gainNode.gain.cancelScheduledValues(ct);
          gainNode.gain.setValueAtTime(gainNode.gain.value, ct);
          gainNode.gain.exponentialRampToValueAtTime(0.0001, ct + 0.35);
          setTimeout(() => {
            if (osc1) {
              try { osc1.stop(); osc1.disconnect(); } catch (e) {}
              osc1 = null;
            }
            if (osc2) {
              try { osc2.stop(); osc2.disconnect(); } catch (e) {}
              osc2 = null;
            }
            if (gainNode) {
              try { gainNode.disconnect(); } catch (e) {}
              gainNode = null;
            }
          }, 400);
        } catch (e) {
          console.warn('Error stopping synth:', e);
        }
      }

      if (eqInterval) {
        clearInterval(eqInterval);
        eqInterval = null;
      }

      cards.forEach((card) => {
        card.classList.remove('is-playing');
        const icon = card.querySelector('[data-play-icon]');
        if (icon) icon.textContent = 'play_arrow';
        const bars = card.querySelectorAll<HTMLElement>('[data-eq-bars] .bar');
        bars.forEach((b) => (b.style.height = '4px'));
      });

      activeCard = null;

      window.dispatchEvent(
        new CustomEvent('dj:about-audio-change', {
          detail: { isPlaying: false, activeTrackId: null }
        })
      );
    }

    function startPlayback(card: HTMLElement) {
      if (activeCard && activeCard !== card) {
        stopPlayback();
      }

      const audioSrc = card.dataset.audioSrc;
      const audioEl = card.querySelector<HTMLAudioElement>('audio[data-audio-element]');

      activeCard = card;
      card.classList.add('is-playing');
      const icon = card.querySelector('[data-play-icon]');
      if (icon) icon.textContent = 'pause';

      const bars = card.querySelectorAll<HTMLElement>('[data-eq-bars] .bar');
      if (!eqInterval) {
        eqInterval = setInterval(() => {
          bars.forEach((bar) => {
            const h = Math.floor(Math.random() * 18) + 4;
            bar.style.height = `${h}px`;
          });
        }, 180);
      }

      if (audioSrc && audioEl) {
        currentAudioEl = audioEl;
        audioEl.play().catch((err) => {
          console.warn('HTML5 audio play error, falling back to synth:', err);
          playSynth(card);
        });

        audioEl.onended = () => {
          stopPlayback();
        };
      } else {
        playSynth(card);
      }

      window.dispatchEvent(
        new CustomEvent('dj:about-audio-change', {
          detail: { isPlaying: true, activeTrackId: card.dataset.trackId || null }
        })
      );
    }

    function playSynth(card: HTMLElement) {
      try {
        const AudioContextClass = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
        if (!audioCtx) {
          audioCtx = new AudioContextClass();
        }
        if (audioCtx.state === 'suspended') {
          audioCtx.resume();
        }

        const baseF = Number(card.dataset.baseFreq) || 432;
        const subF = Number(card.dataset.subFreq) || 216;

        const ct = audioCtx.currentTime;
        gainNode = audioCtx.createGain();
        gainNode.gain.setValueAtTime(0.0001, ct);
        gainNode.gain.exponentialRampToValueAtTime(0.05, ct + 0.45);

        osc1 = audioCtx.createOscillator();
        osc1.type = 'sine';
        osc1.frequency.setValueAtTime(baseF, ct);

        osc2 = audioCtx.createOscillator();
        osc2.type = 'triangle';
        osc2.frequency.setValueAtTime(subF, ct);

        const filter = audioCtx.createBiquadFilter();
        filter.type = 'lowpass';
        filter.frequency.setValueAtTime(780, ct);

        osc1.connect(gainNode);
        osc2.connect(filter);
        filter.connect(gainNode);
        gainNode.connect(audioCtx.destination);

        osc1.start(ct);
        osc2.start(ct);
      } catch (err) {
        console.warn('Web Audio playback failed:', err);
      }
    }

    cards.forEach((card) => {
      const btn = card.querySelector('[data-play-btn]');
      btn?.addEventListener('click', () => {
        if (activeCard === card) {
          stopPlayback();
        } else {
          startPlayback(card);
        }
      });
    });

    // Sync with external triggers (e.g. sticky action bar toggles primary card)
    window.addEventListener('dj:toggle-about-audio', (() => {
      if (activeCard) {
        stopPlayback();
      } else {
        const firstCard = cards[0];
        if (firstCard) startPlayback(firstCard);
      }
    }) as EventListener);
  })();
</script>

<style>
  .audio-preview-card {
    position: relative;
    width: 100%;
    max-width: 640px;
    margin-inline: auto;
    border-radius: var(--radius-lg);
    background: var(--color-surface-glass);
    border: 1px solid var(--color-glass-border);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    padding: clamp(1rem, 3.5vw, 1.35rem);
    box-sizing: border-box;
    overflow: hidden;
    min-width: 0;
    transition: var(--transition-theme), border-color 0.3s ease, box-shadow 0.3s ease;
  }

  @media (min-width: 840px) {
    .audio-preview-card {
      display: flex;
      flex-direction: column;
      justify-content: center;
      flex: 1;
      height: 100%;
    }
  }

  .audio-preview-card.is-playing {
    border-color: var(--color-primary);
    box-shadow: 0 8px 32px var(--color-primary-glow);
  }

  .audio-glow {
    position: absolute;
    inset: -20%;
    background: radial-gradient(circle at 30% 50%, var(--color-primary-glow) 0%, transparent 70%);
    opacity: 0.15;
    pointer-events: none;
    transition: opacity 0.5s ease;
  }

  .audio-preview-card.is-playing .audio-glow {
    opacity: 0.35;
  }

  .audio-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
    min-width: 0;
  }

  .audio-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    width: 100%;
    min-width: 0;
  }

  .audio-badge-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
    min-width: 0;
    flex: 1;
  }

  .freq-pill,
  .bpm-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: clamp(0.5625rem, 2vw, 0.6875rem);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding-inline: 0.5rem;
    padding-block: 0.25rem;
    border-radius: var(--radius-full);
    background: var(--color-surface-glass);
    border: 1px solid var(--color-glass-border);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    color: var(--color-primary);
    max-width: 100%;
    box-sizing: border-box;
  }

  .bpm-pill {
    color: var(--color-text-muted);
  }

  .live-dot {
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: var(--color-primary);
    box-shadow: 0 0 6px var(--color-primary-glow);
    flex-shrink: 0;
  }

  .eq-bars {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 20px;
    flex-shrink: 0;
  }

  .bar {
    width: 3px;
    height: 4px;
    background: var(--color-primary);
    border-radius: 2px;
    transition: height 0.18s ease;
    opacity: 0.85;
  }

  .track-row {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    width: 100%;
    min-width: 0;
  }

  .play-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--color-primary);
    color: var(--color-on-primary);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    box-shadow: 0 4px 16px var(--color-primary-glow);
  }

  .play-btn:hover {
    transform: scale(1.06);
    box-shadow: 0 6px 20px var(--color-primary-glow);
  }

  .play-btn:active {
    transform: scale(0.96);
  }

  .play-icon {
    font-size: 24px;
  }

  .track-meta {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
    flex: 1;
    overflow: hidden;
  }

  .track-title {
    font-family: var(--font-display);
    font-size: clamp(0.875rem, 2.5vw, 1rem);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-text-main);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }

  .track-subtitle {
    font-family: var(--font-mono);
    font-size: clamp(0.6875rem, 2vw, 0.75rem);
    color: var(--color-text-muted);
    letter-spacing: 0.02em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }

  :global([lang="ru"]) .track-title {
    font-family: 'Unbounded', 'Syne', sans-serif;
    font-weight: 400;
    font-size: 0.95rem;
    letter-spacing: 0.01em;
  }

  :global([dir="rtl"]) .track-title {
    font-family: 'Rubik', 'Heebo', sans-serif;
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  :global([dir="rtl"]) .track-subtitle {
    font-family: 'Heebo', sans-serif;
  }

  :global([dir="rtl"]) .play-icon {
    transform: scaleX(-1);
  }
</style>
