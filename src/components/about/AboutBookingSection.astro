---
import BookingBriefForm from "./BookingBriefForm.astro";
import type { SupportedLang } from "../../i18n/ui";
import { useTranslations, getWhatsAppLink, SITE_CONTACTS } from "../../i18n/ui";

interface Props {
  lang: SupportedLang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const waLink = getWhatsAppLink(lang);
---

<section class="about-section booking-section" id="booking-brief">
  <div class="section-container">
    <div class="section-header">
      <span class="section-badge"
        >{t("bookingBadge") || "CONNECT & INQUIRE"}</span
      >
      <h2 class="section-title">
        {t("bookingTitle") || "Reserve a Date or Inquire"}
      </h2>
      <p class="section-subtitle">{t("bookingSubtitle")}</p>
    </div>

    <div class="booking-grid">
      <!-- Direct Channels & Social Column -->
      <div class="direct-channels-card">
        <h3 class="channels-title">
          {t("contactDirectHeading") || "Direct Artist Channels"}
        </h3>

        <div class="channels-list">
          <a
            href={waLink}
            target="_blank"
            rel="noopener noreferrer"
            class="channel-link whatsapp-channel"
          >
            <span
              class="material-symbols-outlined channel-icon"
              aria-hidden="true">chat</span
            >
            <div class="channel-info">
              <span class="channel-label">{t("contactDirectWhatsApp")}</span>
              <span class="channel-val">{SITE_CONTACTS.phone}</span>
            </div>
          </a>

          <a
            href={`mailto:${SITE_CONTACTS.email}`}
            class="channel-link email-channel"
          >
            <span
              class="material-symbols-outlined channel-icon"
              aria-hidden="true">mail</span
            >
            <div class="channel-info">
              <span class="channel-label">{t("contactDirectEmail")}</span>
              <span class="channel-val">{SITE_CONTACTS.email}</span>
            </div>
          </a>

          <a
            href={SITE_CONTACTS.telegramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="channel-link telegram-channel"
          >
            <span
              class="material-symbols-outlined channel-icon"
              aria-hidden="true">send</span
            >
            <div class="channel-info">
              <span class="channel-label">{t("contactDirectTelegram")}</span>
              <span class="channel-val">@{SITE_CONTACTS.telegramUser}</span>
            </div>
          </a>

          <a
            href={SITE_CONTACTS.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="channel-link instagram-channel"
          >
            <span
              class="material-symbols-outlined channel-icon"
              aria-hidden="true">photo_camera</span
            >
            <div class="channel-info">
              <span class="channel-label">{t("contactDirectInstagram")}</span>
              <span class="channel-val">@{SITE_CONTACTS.instagramUser}</span>
            </div>
          </a>
        </div>
      </div>

      <!-- Express Brief Form Column -->
      <div class="brief-form-column">
        <BookingBriefForm lang={lang} />
      </div>
    </div>
  </div>
</section>

<style>
  .about-section {
    position: relative;
    z-index: 10;
    width: 100%;
    padding-inline: 1.25rem;
    padding-block: 4rem;
    box-sizing: border-box;
  }

  .section-container {
    max-width: 1080px;
    width: 100%;
    margin-inline: auto;
    box-sizing: border-box;
  }

  .section-header {
    text-align: center;
    margin-block-end: 2.5rem;
  }

  .section-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-block-end: 0.85rem;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.8vw, 2.5rem);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-main);
    line-height: 1.2;
    margin: 0;
  }

  .section-subtitle {
    font-family: var(--font-body);
    font-size: clamp(0.9375rem, 2vw, 1.125rem);
    color: var(--color-text-muted);
    max-width: 640px;
    margin-inline: auto;
    margin-block-start: 0.75rem;
    line-height: 1.5;
  }

  .booking-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 860px) {
    .booking-grid {
      grid-template-columns: 340px 1fr;
    }
  }

  .direct-channels-card {
    background: var(--color-surface-glass);
    border: 1px solid var(--color-glass-border);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-radius: var(--radius-lg);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    height: fit-content;
  }

  .channels-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text-main);
    margin: 0;
  }

  .channels-list {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .channel-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.875rem 1rem;
    border-radius: var(--radius-md);
    background: var(--color-surface-container);
    border: 1px solid var(--color-glass-border);
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      transform 0.2s ease,
      background 0.2s ease;
  }

  .channel-link:hover {
    border-color: var(--color-primary);
    background: var(--color-surface-container-high);
    transform: translateX(4px);
  }

  :global([dir="rtl"]) .channel-link:hover {
    transform: translateX(-4px);
  }

  .channel-icon {
    font-size: 1.5rem;
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .channel-info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .channel-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .channel-val {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--color-text-main);
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Russian Support: Unbounded */
  :global([lang="ru"]) .section-title {
    font-family: 'Unbounded', 'Syne', sans-serif;
    font-weight: 400;
    font-size: clamp(1.25rem, 2.8vw, 1.85rem);
    letter-spacing: 0.02em;
  }

  :global([lang="ru"]) .channels-title {
    font-family: 'Unbounded', 'Syne', sans-serif;
    font-weight: 400;
    font-size: 1.125rem;
    letter-spacing: 0.01em;
  }

  :global([lang="ru"]) .section-badge {
    font-family: 'Unbounded', 'Syne', sans-serif;
    font-weight: 500;
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
  }

  /* RTL Support */
  :global([dir="rtl"]) .section-title,
  :global([dir="rtl"]) .channels-title {
    font-family: 'Rubik', 'Heebo', sans-serif;
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  :global([dir="rtl"]) .section-subtitle {
    font-family: 'Heebo', sans-serif;
  }

  :global([dir="rtl"]) .section-badge,
  :global([dir="rtl"]) .channel-label {
    font-family: 'Heebo', sans-serif;
    font-weight: 500;
    font-size: 0.875rem;
    letter-spacing: 0.08em;
  }

  :global([dir="rtl"]) .telegram-channel .channel-icon {
    transform: scaleX(-1);
  }
</style>
