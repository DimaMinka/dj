---
import type { SupportedLang } from "../../i18n/ui";
import { useTranslations } from "../../i18n/ui";
import { specCards, hardwareRider } from "../../data/about";

interface Props {
  lang: SupportedLang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="about-section specs-section" id="specifications">
  <div class="section-container">
    <div class="section-header">
      <span class="section-badge"
        >{t("specsBadge") || "TECHNICAL SPECIFICATIONS"}</span
      >
      <h2 class="section-title">
        {t("specsTitle") || "Engineered Precision & Seamless Aesthetics"}
      </h2>
      <p class="section-subtitle">{t("specsSubtitle")}</p>
    </div>

    <div class="specs-grid">
      {specCards.map((card) => (
        <div class="spec-card">
          <div class="spec-card-icon" aria-hidden="true">
            <span class="material-symbols-outlined">{card.icon}</span>
          </div>
          <h3 class="spec-card-title">{card.title[lang]}</h3>
          <p class="spec-card-desc">{card.desc[lang]}</p>
          <ul class="spec-card-list">
            {card.items[lang].map((item) => (
              <li>
                <span
                  class="material-symbols-outlined check-icon"
                  aria-hidden="true">check</span
                >
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Collapsible Detailed Rider for Producers & Sound Techs -->
    <details class="specs-rider-details">
      <summary class="rider-summary">
        <span class="rider-summary-text"
          >{
            t("specsRiderToggle") || "View Complete Hardware & DJ Rider"
          }</span
        >
        <span
          class="material-symbols-outlined rider-arrow"
          aria-hidden="true">expand_more</span
        >
      </summary>
      <div class="rider-content">
        {hardwareRider.map((rider) => (
          <div class="rider-item">
            <span class="rider-label">{rider.label[lang]}</span>
            <span class="rider-val">{rider.val[lang]}</span>
          </div>
        ))}
      </div>
    </details>
  </div>
</section>

<style>
  .about-section {
    position: relative;
    z-index: 10;
    width: 100%;
    padding-inline: 1.25rem;
    padding-block: 4rem;
    box-sizing: border-box;
  }

  .section-container {
    max-width: 1080px;
    width: 100%;
    margin-inline: auto;
    box-sizing: border-box;
  }

  .section-header {
    text-align: center;
    margin-block-end: 2.5rem;
  }

  .section-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-block-end: 0.85rem;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.8vw, 2.5rem);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-main);
    line-height: 1.2;
    margin: 0;
  }

  .section-subtitle {
    font-family: var(--font-body);
    font-size: clamp(0.9375rem, 2vw, 1.125rem);
    color: var(--color-text-muted);
    max-width: 640px;
    margin-inline: auto;
    margin-block-start: 0.75rem;
    line-height: 1.5;
  }

  .specs-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .specs-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .spec-card {
    background: var(--color-surface-glass);
    border: 1px solid var(--color-glass-border);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-radius: var(--radius-lg);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .spec-card-icon {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background: rgba(var(--color-primary-rgb, 226, 160, 63), 0.12);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .spec-card-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text-main);
    margin: 0;
  }

  .spec-card-desc {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin: 0;
  }

  .spec-card-list {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .spec-card-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--color-text-main);
    line-height: 1.4;
  }

  .check-icon {
    color: var(--color-primary);
    font-size: 1.125rem;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .specs-rider-details {
    margin-block-start: 1.75rem;
    background: var(--color-surface-glass);
    border: 1px dashed var(--color-glass-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .rider-summary {
    padding: 1rem 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-primary);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    list-style: none;
    user-select: none;
  }

  .rider-summary::-webkit-details-marker {
    display: none;
  }

  .rider-arrow {
    transition: transform 0.2s ease;
  }

  .specs-rider-details[open] .rider-arrow {
    transform: rotate(180deg);
  }

  .rider-content {
    padding: 1.25rem;
    border-top: 1px solid var(--color-glass-border);
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .rider-content {
      grid-template-columns: 1fr 1fr;
    }
  }

  .rider-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .rider-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .rider-val {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--color-text-main);
  }

  /* Russian Support: Unbounded */
  :global([lang="ru"]) .section-title {
    font-family: 'Unbounded', 'Syne', sans-serif;
    font-weight: 400;
    font-size: clamp(1.25rem, 2.8vw, 1.85rem);
    letter-spacing: 0.02em;
  }

  :global([lang="ru"]) .spec-card-title {
    font-family: 'Unbounded', 'Syne', sans-serif;
    font-weight: 400;
    font-size: 1.125rem;
    letter-spacing: 0.01em;
  }

  :global([lang="ru"]) .section-badge {
    font-family: 'Unbounded', 'Syne', sans-serif;
    font-weight: 500;
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
  }

  /* RTL Support */
  :global([dir="rtl"]) .section-title,
  :global([dir="rtl"]) .spec-card-title {
    font-family: 'Rubik', 'Heebo', sans-serif;
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  :global([dir="rtl"]) .section-subtitle,
  :global([dir="rtl"]) .spec-card-desc {
    font-family: 'Heebo', sans-serif;
  }

  :global([dir="rtl"]) .section-badge {
    font-family: 'Heebo', sans-serif;
    font-weight: 500;
    font-size: 0.875rem;
    letter-spacing: 0.08em;
  }

  :global([dir="rtl"]) .rider-summary,
  :global([dir="rtl"]) .rider-label {
    font-family: 'Heebo', sans-serif;
    font-weight: 500;
    letter-spacing: 0.06em;
  }
</style>
