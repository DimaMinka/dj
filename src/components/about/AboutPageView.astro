---
import Layout from "../../layouts/Layout.astro";
import IntroHeader from "../../components/intro/IntroHeader.astro";
import AtmosphereBackground from "../../components/intro/AtmosphereBackground.astro";
import AudioPreview from "./AudioPreview.astro";
import VideoReel from "./VideoReel.astro";
import BookingBriefForm from "./BookingBriefForm.astro";
import StickyActionBar from "./StickyActionBar.astro";
import type { SupportedLang } from "../../i18n/ui";
import { useTranslations, getWhatsAppLink, SITE_CONTACTS } from "../../i18n/ui";

interface Props {
  lang: SupportedLang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const waLink = getWhatsAppLink(lang);

// SEO Canonical & Hreflang Path calculation
const canonicalPath = lang === "en" ? "/about" : `/${lang}/about`;
const siteUrl =
  Astro.site?.toString().replace(/\/$/, "") || "https://dj.dimaminka.com";
const fullCanonicalUrl = `${siteUrl}${canonicalPath}`;

// Structured Data (Schema.org JSON-LD Graph: EntertainmentBusiness + Service + FAQPage)
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "EntertainmentBusiness",
      "@id": "https://dj.dimaminka.com/#business",
      name: "DJ Dima Minka — Bespoke Sound & Autonomous Light",
      url: "https://dj.dimaminka.com",
      sameAs: [
        SITE_CONTACTS.telegramUrl,
        SITE_CONTACTS.instagramUrl,
      ],
      email: SITE_CONTACTS.email,
      telephone: SITE_CONTACTS.phone,
      areaServed: [
        { "@type": "AdministrativeArea", name: "Galilee" },
        { "@type": "AdministrativeArea", name: "Upper Galilee" },
        { "@type": "AdministrativeArea", name: "Golan Heights" },
        { "@type": "AdministrativeArea", name: "Northern District, Israel" },
      ],
      knowsAbout: [
        "Organic House",
        "Melodic Techno",
        "432 Hz Harmonic Master Sound",
        "IP65 Architectural Lighting Rig",
        "Boutique Winery Events",
        "Private Villa Parties",
        "Sunset Soundscapes",
      ],
    },
    {
      "@type": "Service",
      "@id": "https://dj.dimaminka.com/#service-sound-light",
      name: "Bespoke Event Sound & Site-Specific Lighting Installation",
      provider: { "@id": "https://dj.dimaminka.com/#business" },
      serviceType: "Site-Specific Event Production & DJ Performance",
      description:
        "Turnkey 432 Hz acoustic curation and 12+ architectural IP65 ambient lighting with discreet cable routing for private gatherings, boutique retreats, and winery sessions in Northern Israel.",
    },
    {
      "@type": "FAQPage",
      "@id": `${fullCanonicalUrl}#faq`,
      mainEntity: [
        {
          "@type": "Question",
          name: t("faq1Q"),
          acceptedAnswer: {
            "@type": "Answer",
            text: t("faq1A"),
          },
        },
        {
          "@type": "Question",
          name: t("faq2Q"),
          acceptedAnswer: {
            "@type": "Answer",
            text: t("faq2A"),
          },
        },
        {
          "@type": "Question",
          name: t("faq3Q"),
          acceptedAnswer: {
            "@type": "Answer",
            text: t("faq3A"),
          },
        },
        {
          "@type": "Question",
          name: t("faq4Q"),
          acceptedAnswer: {
            "@type": "Answer",
            text: t("faq4A"),
          },
        },
      ],
    },
  ],
};

const pageTitle = `${t("aboutPageTitle") || "The Architecture of Frequency"} — DJ Dima Minka`;
const pageDescription =
  t("aboutHeroSubtitle") ||
  "Bespoke Sound & Site-Specific Light Installations for Private Events, Boutique Wineries & Retreats in Galilee & Golan Heights.";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  lang={lang}
  canonicalPath={canonicalPath}
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(structuredData)}
    slot="head"
  />

  <main class="about-viewport pt-safe pb-safe">
    <AtmosphereBackground />
    <IntroHeader lang={lang} currentSection="about" />

    <!-- 1. Hero Section -->
    <section class="about-hero" id="overview">
      <div class="hero-content">
        <div class="hero-badge-row">
          <span class="geo-badge">
            <span class="pulse-dot" aria-hidden="true"></span>
            <span>{t("aboutHeroBadgeGeo") || "GALILEE & GOLAN HEIGHTS"}</span>
          </span>
          <span class="freq-badge"
            >{t("aboutHeroBadgeFreq") || "432 Hz RESONANCE"}</span
          >
        </div>

        <h1 class="about-title">
          {t("aboutPageTitle") || "The Architecture of Frequency"}
        </h1>
        <p class="about-subtitle">{pageDescription}</p>

        <div class="hero-cta-group">
          <a
            href={waLink}
            target="_blank"
            rel="noopener noreferrer"
            class="cta-btn primary-cta"
            data-analytics="conversion_whatsapp_click"
            data-placement="hero_cta"
          >
            <span class="material-symbols-outlined cta-icon" aria-hidden="true"
              >chat</span
            >
            <span>{t("aboutCtaWhatsApp") || "WhatsApp Inquiry"}</span>
          </a>

          <a href="#specifications" class="cta-btn secondary-cta">
            <span class="material-symbols-outlined cta-icon" aria-hidden="true"
              >tune</span
            >
            <span>{t("aboutCtaSpecs") || "Sound & Light Rig"}</span>
          </a>

          <a href="#booking-brief" class="cta-btn text-cta">
            <span class="material-symbols-outlined cta-icon" aria-hidden="true"
              >calendar_today</span
            >
            <span>{t("aboutCtaBrief") || "Send Event Brief"}</span>
          </a>
        </div>
      </div>
    </section>

    <!-- 2. Manifesto / Acoustic Philosophy Section -->
    <section class="about-section manifesto-section" id="philosophy">
      <div class="section-container">
        <div class="section-header">
          <span class="section-badge"
            >{t("manifestoBadge") || "PHILOSOPHY & ACOUSTIC VISION"}</span
          >
          <h2 class="section-title">
            {t("manifestoTitle") || "Sound as Invisible Architecture"}
          </h2>
        </div>

        <div class="manifesto-card">
          <p class="manifesto-lead">{t("manifestoP1")}</p>
          <div class="manifesto-divider" aria-hidden="true"></div>
          <p class="manifesto-secondary">{t("manifestoP2")}</p>
        </div>
      </div>
    </section>

    <!-- 3. Media & Acoustic Proof (Audio Preview & Visual Reel) -->
    <section class="about-section media-proof-section" id="media-proof">
      <div class="section-container">
        <div class="media-proof-grid">
          <div class="proof-col">
            <div class="col-header">
              <span class="col-tag">{t("audioPreviewTag") || "CURATED SOUNDSCAPE"}</span>
              <h2 class="col-title">{t("audioPreviewTitle") || "Sunset Sessions & Melodic Drift"}</h2>
            </div>
            <AudioPreview lang={lang} />
          </div>

          <div class="proof-col">
            <div class="col-header">
              <span class="col-tag">{t("visualArchitectureTag") || "VISUAL ARCHITECTURE"}</span>
              <h2 class="col-title">{t("visualArchitectureTitle") || "Site-Specific Lighting"}</h2>
            </div>
            <VideoReel lang={lang} />
          </div>
        </div>
      </div>
    </section>

    <!-- 4. Specifications & Wired Hardware Rider Section -->
    <section class="about-section specs-section" id="specifications">
      <div class="section-container">
        <div class="section-header">
          <span class="section-badge"
            >{t("specsBadge") || "TECHNICAL SPECIFICATIONS"}</span
          >
          <h2 class="section-title">
            {t("specsTitle") || "Engineered Precision & Seamless Aesthetics"}
          </h2>
          <p class="section-subtitle">{t("specsSubtitle")}</p>
        </div>

        <div class="specs-grid">
          <!-- Sound Rig Card -->
          <div class="spec-card">
            <div class="spec-card-icon" aria-hidden="true">
              <span class="material-symbols-outlined">graphic_eq</span>
            </div>
            <h3 class="spec-card-title">{t("specSoundTitle")}</h3>
            <p class="spec-card-desc">{t("specSoundDesc")}</p>
            <ul class="spec-card-list">
              <li>
                <span
                  class="material-symbols-outlined check-icon"
                  aria-hidden="true">check</span
                >
                <span>{t("specSoundItem1")}</span>
              </li>
              <li>
                <span
                  class="material-symbols-outlined check-icon"
                  aria-hidden="true">check</span
                >
                <span>{t("specSoundItem2")}</span>
              </li>
              <li>
                <span
                  class="material-symbols-outlined check-icon"
                  aria-hidden="true">check</span
                >
                <span>{t("specSoundItem3")}</span>
              </li>
            </ul>
          </div>

          <!-- Light Rig Card -->
          <div class="spec-card">
            <div class="spec-card-icon" aria-hidden="true">
              <span class="material-symbols-outlined">wb_incandescent</span>
            </div>
            <h3 class="spec-card-title">{t("specLightTitle")}</h3>
            <p class="spec-card-desc">{t("specLightDesc")}</p>
            <ul class="spec-card-list">
              <li>
                <span
                  class="material-symbols-outlined check-icon"
                  aria-hidden="true">check</span
                >
                <span>{t("specLightItem1")}</span>
              </li>
              <li>
                <span
                  class="material-symbols-outlined check-icon"
                  aria-hidden="true">check</span
                >
                <span>{t("specLightItem2")}</span>
              </li>
              <li>
                <span
                  class="material-symbols-outlined check-icon"
                  aria-hidden="true">check</span
                >
                <span>{t("specLightItem3")}</span>
              </li>
            </ul>
          </div>
        </div>

        <!-- Collapsible Detailed Rider for Producers & Sound Techs -->
        <details class="specs-rider-details">
          <summary class="rider-summary">
            <span class="rider-summary-text"
              >{
                t("specsRiderToggle") || "View Complete Hardware & DJ Rider"
              }</span
            >
            <span
              class="material-symbols-outlined rider-arrow"
              aria-hidden="true">expand_more</span
            >
          </summary>
          <div class="rider-content">
            <div class="rider-item">
              <span class="rider-label">{t("specsRiderConsole")}</span>
              <span class="rider-val">{t("specsRiderConsoleVal")}</span>
            </div>
            <div class="rider-item">
              <span class="rider-label">{t("specsRiderDmx")}</span>
              <span class="rider-val">{t("specsRiderDmxVal")}</span>
            </div>
            <div class="rider-item">
              <span class="rider-label">{t("specsRiderMoving")}</span>
              <span class="rider-val">{t("specsRiderMovingVal")}</span>
            </div>
            <div class="rider-item">
              <span class="rider-label">{t("specsRiderWash")}</span>
              <span class="rider-val">{t("specsRiderWashVal")}</span>
            </div>
          </div>
        </details>
      </div>
    </section>

    <!-- 5. Formats & Scope Packages Section -->
    <section class="about-section packages-section" id="packages">
      <div class="section-container">
        <div class="section-header">
          <span class="section-badge"
            >{t("packagesBadge") || "CURATED FORMATS"}</span
          >
          <h2 class="section-title">
            {t("packagesTitle") || "Tailored Event Scopes"}
          </h2>
          <p class="section-subtitle">{t("packagesSubtitle")}</p>
        </div>

        <div class="packages-grid">
          <!-- Package 1: Sunset & Wine -->
          <div class="package-card">
            <div class="pkg-top">
              <span class="pkg-scale">{t("pkg1Scale")}</span>
              <h3 class="pkg-title">{t("pkg1Title")}</h3>
              <p class="pkg-desc">{t("pkg1Desc")}</p>
            </div>
            <ul class="pkg-features">
              <li>
                <span
                  class="material-symbols-outlined check-icon"
                  aria-hidden="true">done</span
                >
                <span>{t("pkg1Feat1")}</span>
              </li>
              <li>
                <span
                  class="material-symbols-outlined check-icon"
                  aria-hidden="true">done</span
                >
                <span>{t("pkg1Feat2")}</span>
              </li>
              <li>
                <span
                  class="material-symbols-outlined check-icon"
                  aria-hidden="true">done</span
                >
                <span>{t("pkg1Feat3")}</span>
              </li>
            </ul>
            <div class="pkg-action">
              <a
                href={waLink}
                class="pkg-btn"
                target="_blank"
                rel="noopener noreferrer"
              >
                <span>{t("pkgBtnSelect") || "Inquire Format"}</span>
                <span class="material-symbols-outlined" aria-hidden="true"
                  >arrow_forward</span
                >
              </a>
            </div>
          </div>

          <!-- Package 2: Private Villa & Retreat (Featured) -->
          <div class="package-card featured-pkg">
            <div class="pkg-badge-featured">{t("pkgBadgeRecommended") || "RECOMMENDED"}</div>
            <div class="pkg-top">
              <span class="pkg-scale">{t("pkg2Scale")}</span>
              <h3 class="pkg-title">{t("pkg2Title")}</h3>
              <p class="pkg-desc">{t("pkg2Desc")}</p>
            </div>
            <ul class="pkg-features">
              <li>
                <span
                  class="material-symbols-outlined check-icon"
                  aria-hidden="true">done</span
                >
                <span>{t("pkg2Feat1")}</span>
              </li>
              <li>
                <span
                  class="material-symbols-outlined check-icon"
                  aria-hidden="true">done</span
                >
                <span>{t("pkg2Feat2")}</span>
              </li>
              <li>
                <span
                  class="material-symbols-outlined check-icon"
                  aria-hidden="true">done</span
                >
                <span>{t("pkg2Feat3")}</span>
              </li>
            </ul>
            <div class="pkg-action">
              <a
                href={waLink}
                class="pkg-btn featured-btn"
                target="_blank"
                rel="noopener noreferrer"
              >
                <span>{t("pkgBtnSelect") || "Inquire Format"}</span>
                <span class="material-symbols-outlined" aria-hidden="true"
                  >arrow_forward</span
                >
              </a>
            </div>
          </div>

          <!-- Package 3: Custom Production -->
          <div class="package-card">
            <div class="pkg-top">
              <span class="pkg-scale">{t("pkg3Scale")}</span>
              <h3 class="pkg-title">{t("pkg3Title")}</h3>
              <p class="pkg-desc">{t("pkg3Desc")}</p>
            </div>
            <ul class="pkg-features">
              <li>
                <span
                  class="material-symbols-outlined check-icon"
                  aria-hidden="true">done</span
                >
                <span>{t("pkg3Feat1")}</span>
              </li>
              <li>
                <span
                  class="material-symbols-outlined check-icon"
                  aria-hidden="true">done</span
                >
                <span>{t("pkg3Feat2")}</span>
              </li>
              <li>
                <span
                  class="material-symbols-outlined check-icon"
                  aria-hidden="true">done</span
                >
                <span>{t("pkg3Feat3")}</span>
              </li>
            </ul>
            <div class="pkg-action">
              <a
                href={waLink}
                class="pkg-btn"
                target="_blank"
                rel="noopener noreferrer"
              >
                <span>{t("pkgBtnInquire") || "Inquire Format"}</span>
                <span class="material-symbols-outlined" aria-hidden="true"
                  >arrow_forward</span
                >
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 6. Visible FAQ Block (Clients & Search Engine / AI Crawlers) -->
    <section class="about-section faq-section" id="faq">
      <div class="section-container">
        <div class="section-header">
          <span class="section-badge"
            >{t("faqBadge") || "PRACTICAL CLARITY"}</span
          >
          <h2 class="section-title">
            {t("faqTitle") || "Frequently Asked Questions"}
          </h2>
          <p class="section-subtitle">{t("faqSubtitle")}</p>
        </div>

        <div class="faq-list">
          <details class="faq-item" open>
            <summary class="faq-question">
              <span class="faq-q-text">{t("faq1Q")}</span>
              <span
                class="material-symbols-outlined faq-arrow"
                aria-hidden="true">expand_more</span
              >
            </summary>
            <div class="faq-answer">
              <p>{t("faq1A")}</p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">
              <span class="faq-q-text">{t("faq2Q")}</span>
              <span
                class="material-symbols-outlined faq-arrow"
                aria-hidden="true">expand_more</span
              >
            </summary>
            <div class="faq-answer">
              <p>{t("faq2A")}</p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">
              <span class="faq-q-text">{t("faq3Q")}</span>
              <span
                class="material-symbols-outlined faq-arrow"
                aria-hidden="true">expand_more</span
              >
            </summary>
            <div class="faq-answer">
              <p>{t("faq3A")}</p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">
              <span class="faq-q-text">{t("faq4Q")}</span>
              <span
                class="material-symbols-outlined faq-arrow"
                aria-hidden="true">expand_more</span
              >
            </summary>
            <div class="faq-answer">
              <p>{t("faq4A")}</p>
            </div>
          </details>
        </div>
      </div>
    </section>

    <!-- 7. Direct Booking Engine & Express Event Brief Section -->
    <section class="about-section booking-section" id="booking-brief">
      <div class="section-container">
        <div class="section-header">
          <span class="section-badge"
            >{t("bookingBadge") || "CONNECT & INQUIRE"}</span
          >
          <h2 class="section-title">
            {t("bookingTitle") || "Reserve a Date or Inquire"}
          </h2>
          <p class="section-subtitle">{t("bookingSubtitle")}</p>
        </div>

        <div class="booking-grid">
          <!-- Direct Channels & Social Column -->
          <div class="direct-channels-card">
            <h3 class="channels-title">
              {t("contactDirectHeading") || "Direct Artist Channels"}
            </h3>

            <div class="channels-list">
              <a
                href={waLink}
                target="_blank"
                rel="noopener noreferrer"
                class="channel-link whatsapp-channel"
              >
                <span
                  class="material-symbols-outlined channel-icon"
                  aria-hidden="true">chat</span
                >
                <div class="channel-info">
                  <span class="channel-label">{t("contactDirectWhatsApp")}</span
                  >
                  <span class="channel-val">{SITE_CONTACTS.phone}</span>
                </div>
              </a>

              <a
                href={`mailto:${SITE_CONTACTS.email}`}
                class="channel-link email-channel"
              >
                <span
                  class="material-symbols-outlined channel-icon"
                  aria-hidden="true">mail</span
                >
                <div class="channel-info">
                  <span class="channel-label">{t("contactDirectEmail")}</span>
                  <span class="channel-val">{SITE_CONTACTS.email}</span>
                </div>
              </a>

              <a
                href={SITE_CONTACTS.telegramUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="channel-link telegram-channel"
              >
                <span
                  class="material-symbols-outlined channel-icon"
                  aria-hidden="true">send</span
                >
                <div class="channel-info">
                  <span class="channel-label">{t("contactDirectTelegram")}</span
                  >
                  <span class="channel-val">@{SITE_CONTACTS.telegramUser}</span>
                </div>
              </a>

              <a
                href={SITE_CONTACTS.instagramUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="channel-link instagram-channel"
              >
                <span
                  class="material-symbols-outlined channel-icon"
                  aria-hidden="true">photo_camera</span
                >
                <div class="channel-info">
                  <span class="channel-label"
                    >{t("contactDirectInstagram")}</span
                  >
                  <span class="channel-val">@{SITE_CONTACTS.instagramUser}</span
                  >
                </div>
              </a>
            </div>
          </div>

          <!-- Express Brief Form Column -->
          <div class="brief-form-column">
            <BookingBriefForm lang={lang} />
          </div>
        </div>
      </div>
    </section>

    <!-- Sticky Action Dock (Appears when scrolling past hero) -->
    <StickyActionBar lang={lang} />
  </main>
</Layout>

<style>
  .about-viewport {
    position: relative;
    width: 100%;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    overflow-x: hidden;
  }

  /* 1. Hero Section */
  .about-hero {
    position: relative;
    z-index: 10;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-inline: 1.25rem;
    padding-block: 3rem 4rem;
    box-sizing: border-box;
    width: 100%;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    max-width: 900px;
    width: 100%;
    margin-inline: auto;
    box-sizing: border-box;
  }

  .hero-badge-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-block-end: 1.25rem;
    max-width: 100%;
  }

  .geo-badge,
  .freq-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--font-mono);
    font-size: clamp(0.5625rem, 2.5vw, 0.6875rem);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding-inline: 0.625rem;
    padding-block: 0.3rem;
    border-radius: var(--radius-full);
    background: var(--color-surface-glass);
    border: 1px solid var(--color-glass-border);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    color: var(--color-primary);
    white-space: nowrap;
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: var(--color-primary);
    box-shadow: 0 0 8px var(--color-primary-glow);
    animation: pulse 1.8s infinite;
    flex-shrink: 0;
  }

  .about-title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 5.5vw, 3.8rem);
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-main);
    line-height: 1.15;
    max-width: 100%;
    margin: 0;
    box-sizing: border-box;
  }

  .about-subtitle {
    font-family: var(--font-body);
    font-size: clamp(1rem, 2.2vw, 1.25rem);
    line-height: 1.55;
    color: var(--color-text-muted);
    max-width: 720px;
    margin-block-start: 1.25rem;
    margin-block-end: 2rem;
    font-weight: 400;
  }

  .hero-cta-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.875rem;
  }

  .cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-family: var(--font-display);
