---
import Layout from "../../layouts/Layout.astro";
import IntroHeader from "../../components/intro/IntroHeader.astro";
import AtmosphereBackground from "../../components/intro/AtmosphereBackground.astro";
import AboutHero from "./AboutHero.astro";
import AboutManifesto from "./AboutManifesto.astro";
import AboutMediaProof from "./AboutMediaProof.astro";
import AboutSpecs from "./AboutSpecs.astro";
import AboutPackages from "./AboutPackages.astro";
import AboutFAQ from "./AboutFAQ.astro";
import AboutBookingSection from "./AboutBookingSection.astro";
import AboutFooter from "./AboutFooter.astro";
import StickyActionBar from "./StickyActionBar.astro";
import type { SupportedLang } from "../../i18n/ui";
import { useTranslations, SITE_CONTACTS } from "../../i18n/ui";

interface Props {
  lang: SupportedLang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// SEO Canonical & Hreflang Path calculation
const canonicalPath = lang === "en" ? "/about" : `/${lang}/about`;
const siteUrl =
  Astro.site?.toString().replace(/\/$/, "") || "https://dj.dimaminka.com";
const fullCanonicalUrl = `${siteUrl}${canonicalPath}`;

// Structured Data (Schema.org JSON-LD Graph: EntertainmentBusiness + Service + FAQPage)
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "EntertainmentBusiness",
      "@id": "https://dj.dimaminka.com/#business",
      name: "DJ Dima Minka — Bespoke Sound & Autonomous Light",
      url: "https://dj.dimaminka.com",
      sameAs: [
        SITE_CONTACTS.telegramUrl,
        SITE_CONTACTS.instagramUrl,
      ],
      email: SITE_CONTACTS.email,
      telephone: SITE_CONTACTS.phone,
      areaServed: [
        { "@type": "AdministrativeArea", name: "Galilee" },
        { "@type": "AdministrativeArea", name: "Upper Galilee" },
        { "@type": "AdministrativeArea", name: "Golan Heights" },
        { "@type": "AdministrativeArea", name: "Northern District, Israel" },
      ],
      knowsAbout: [
        "Organic House",
        "Melodic Techno",
        "432 Hz Harmonic Master Sound",
        "IP65 Architectural Lighting Rig",
        "Boutique Winery Events",
        "Private Villa Parties",
        "Sunset Soundscapes",
      ],
    },
    {
      "@type": "Service",
      "@id": "https://dj.dimaminka.com/#service-sound-light",
      name: "Bespoke Event Sound & Site-Specific Lighting Installation",
      provider: { "@id": "https://dj.dimaminka.com/#business" },
      serviceType: "Site-Specific Event Production & DJ Performance",
      description:
        "Turnkey 432 Hz acoustic curation and 12+ architectural IP65 ambient lighting with discreet cable routing for private gatherings, boutique retreats, and winery sessions in Northern Israel.",
    },
    {
      "@type": "FAQPage",
      "@id": `${fullCanonicalUrl}#faq`,
      mainEntity: [
        {
          "@type": "Question",
          name: t("faq1Q"),
          acceptedAnswer: {
            "@type": "Answer",
            text: t("faq1A"),
          },
        },
        {
          "@type": "Question",
          name: t("faq2Q"),
          acceptedAnswer: {
            "@type": "Answer",
            text: t("faq2A"),
          },
        },
        {
          "@type": "Question",
          name: t("faq3Q"),
          acceptedAnswer: {
            "@type": "Answer",
            text: t("faq3A"),
          },
        },
        {
          "@type": "Question",
          name: t("faq4Q"),
          acceptedAnswer: {
            "@type": "Answer",
            text: t("faq4A"),
          },
        },
      ],
    },
  ],
};

const pageTitle = `${t("aboutPageTitle") || "The Architecture of Frequency"} — DJ Dima Minka`;
const pageDescription =
  t("aboutHeroSubtitle") ||
  "Bespoke Sound & Site-Specific Light Installations for Private Events, Boutique Wineries & Retreats in Galilee & Golan Heights.";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  lang={lang}
  canonicalPath={canonicalPath}
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(structuredData)}
    slot="head"
  />

  <!-- Dedicated Typography for RU (Unbounded) & HE (Rubik) on About Page -->
  {lang === "ru" && (
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Unbounded:wght@400;500;600;700;800&display=swap"
      slot="head"
    />
  )}
  {lang === "he" && (
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Rubik:wght@500;600;700;800&display=swap"
      slot="head"
    />
  )}

  <main class="about-viewport pt-safe pb-safe">
    <AtmosphereBackground />
    <IntroHeader lang={lang} currentSection="about" />

    <!-- 1. Hero Section -->
    <AboutHero lang={lang} />

    <!-- 2. Manifesto / Acoustic Philosophy Section -->
    <AboutManifesto lang={lang} />

    <!-- 3. Media & Acoustic Proof (Audio Preview & Visual Reel) -->
    <AboutMediaProof lang={lang} />

    <!-- 4. Specifications & Wired Hardware Rider Section -->
    <AboutSpecs lang={lang} />

    <!-- 5. Formats & Scope Packages Section -->
    <AboutPackages lang={lang} />

    <!-- 6. Visible FAQ Block (Clients & Search Engine / AI Crawlers) -->
    <AboutFAQ lang={lang} />

    <!-- 7. Direct Booking Engine & Express Event Brief Section -->
    <AboutBookingSection lang={lang} />

    <!-- 8. About Dedicated Footer Menu -->
    <AboutFooter lang={lang} />

    <!-- Sticky Action Dock (Appears when scrolling past hero) -->
    <StickyActionBar lang={lang} />
  </main>
</Layout>

<style>
  .about-viewport {
    position: relative;
    width: 100%;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    overflow-x: hidden;
  }
</style>
