---
import type { SupportedLang } from '../../i18n/ui';
import { useTranslations, getWhatsAppLink } from '../../i18n/ui';

interface Props {
  lang?: SupportedLang;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const waLink = getWhatsAppLink(lang);
---

<div class="sticky-action-dock" id="aboutStickyDock" aria-label="Quick actions dock">
  <div class="dock-inner">
    <button
      type="button"
      class="dock-audio-btn"
      id="stickyAudioBtn"
      aria-label="Toggle 432 Hz sample"
    >
      <span class="material-symbols-outlined dock-icon" id="stickyPlayIcon" aria-hidden="true">play_arrow</span>
      <span class="dock-label" id="stickyAudioLabel">{t('stickyPlayPreview') || 'Sample 432 Hz'}</span>
    </button>

    <div class="dock-divider" aria-hidden="true"></div>

    <a
      href={waLink}
      target="_blank"
      rel="noopener noreferrer"
      class="dock-whatsapp-btn"
      data-analytics="conversion_whatsapp_click"
      data-placement="sticky_dock"
    >
      <span class="material-symbols-outlined dock-icon" aria-hidden="true">chat</span>
      <span class="dock-label">{t('stickyWhatsApp') || 'WhatsApp Booking'}</span>
    </a>
  </div>
</div>

<script>
  (function initStickyDock() {
    const stickyBtn = document.getElementById('stickyAudioBtn');
    const stickyIcon = document.getElementById('stickyPlayIcon');
    const stickyLabel = document.getElementById('stickyAudioLabel');
    const dock = document.getElementById('aboutStickyDock');

    let isPlaying = false;

    // Toggle audio via global custom event that AudioPreview listens to
    stickyBtn?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('dj:toggle-about-audio'));
    });

    // Listen for state changes dispatched by AudioPreview
    window.addEventListener('dj:about-audio-change', ((e: CustomEvent<{ isPlaying: boolean }>) => {
      isPlaying = !!e.detail?.isPlaying;
      if (stickyIcon) {
        stickyIcon.textContent = isPlaying ? 'pause' : 'play_arrow';
      }
      if (stickyBtn) {
        stickyBtn.classList.toggle('is-playing', isPlaying);
      }
    }) as EventListener);

    // Scroll reveal observer: show dock only after user leaves hero
    const heroSection = document.getElementById('overview');
    if (heroSection && dock) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              dock.classList.remove('is-visible');
            } else {
              dock.classList.add('is-visible');
            }
          });
        },
        { threshold: 0.15 }
      );
      observer.observe(heroSection);
    } else if (dock) {
      // Fallback: make visible by default
      dock.classList.add('is-visible');
    }
  })();
</script>

<style>
  .sticky-action-dock {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 90;
    display: flex;
    justify-content: center;
    padding-inline: 1rem;
    padding-block-end: calc(env(safe-area-inset-bottom, 0px) + 0.75rem);
    padding-block-start: 0.5rem;
    pointer-events: none;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .sticky-action-dock.is-visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .dock-inner {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--color-surface-glass);
    border: 1px solid var(--color-glass-border);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-radius: var(--radius-full);
    padding: 0.375rem 0.5rem;
    box-shadow: 0 10px 32px rgba(0, 0, 0, 0.4);
    max-width: 95vw;
  }

  .dock-audio-btn,
  .dock-whatsapp-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding-inline: 1.125rem;
    padding-block: 0.625rem;
    border-radius: var(--radius-full);
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    border: none;
    cursor: pointer;
    white-space: nowrap;
    transition: transform 0.2s ease, background 0.2s ease, color 0.2s ease;
  }

  .dock-audio-btn {
    background: transparent;
    color: var(--color-text-main);
  }

  .dock-audio-btn:hover {
    background: rgba(255, 255, 255, 0.08);
  }

  .dock-audio-btn.is-playing {
    color: var(--color-primary);
  }

  .dock-whatsapp-btn {
    background: var(--color-primary);
    color: var(--color-on-primary);
    box-shadow: 0 4px 16px var(--color-primary-glow);
  }

  .dock-whatsapp-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 20px var(--color-primary-glow);
  }

  .dock-divider {
    width: 1px;
    height: 20px;
    background: var(--color-glass-border);
    flex-shrink: 0;
  }

  .dock-icon {
    font-size: 1.125rem;
  }

  @media (max-width: 480px) {
    .dock-audio-btn,
    .dock-whatsapp-btn {
      padding-inline: 0.875rem;
      padding-block: 0.5rem;
      font-size: 0.75rem;
      gap: 0.375rem;
    }
  }

  :global([dir="rtl"]) .dock-audio-btn,
  :global([dir="rtl"]) .dock-whatsapp-btn {
    font-family: 'Heebo', sans-serif;
    letter-spacing: 0.02em;
  }
</style>
