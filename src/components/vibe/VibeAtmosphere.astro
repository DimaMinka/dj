---
import { spaces } from '../../data/spaces';
---

<div class="vibe-atmosphere-canvas" id="vibeAtmosphere" aria-hidden="true">
  <!-- Multi-layered Space Watercolor Backgrounds with smooth crossfade -->
  {spaces.map((space, idx) => (
    <div
      class={`space-bg-layer space-layer-${space.slug} ${idx === 0 ? 'is-active' : ''}`}
      data-space-index={idx}
      data-glow-rgb={space.glowRgb}
      data-glow-color={space.glowColor}
      style={`--layer-glow: ${space.glowColor};`}
    >
      <div
        class="space-bg-img"
        style={`background-image: url('${space.bgWatercolor}');`}
      ></div>
      <div class="space-vignette-night"></div>
      <div class="space-vignette-day"></div>
    </div>
  ))}

  <!-- Dynamic Chromatic Aura (Glow flood that changes with active space) -->
  <div class="dynamic-aura" id="dynamicAura"></div>

  <!-- Floating Luminous Dust Particles -->
  <div class="dust-particle dust-1 animate-float-dust"></div>
  <div class="dust-particle dust-2 animate-float-dust"></div>
  <div class="dust-particle dust-3 animate-float-dust"></div>
  <div class="dust-particle dust-4 animate-float-dust"></div>
</div>

<script>
  function initAtmosphereTransitions() {
    const canvas = document.getElementById('vibeAtmosphere');
    const dynamicAura = document.getElementById('dynamicAura');
    const layers = document.querySelectorAll('.space-bg-layer');
    if (!canvas || !dynamicAura) return;

    // When space changes, activate target layer and update aura
    window.addEventListener('dj:space-change', ((e: CustomEvent) => {
      const { index, glowRgb } = e.detail || {};
      if (typeof index !== 'number') return;

      layers.forEach((layer, idx) => {
        if (idx === index) {
          layer.classList.add('is-active');
        } else {
          layer.classList.remove('is-active');
        }
      });

      if (glowRgb) {
        dynamicAura.style.background = `radial-gradient(circle at 50% 38%, rgba(${glowRgb}, 0.35) 0%, rgba(${glowRgb}, 0.12) 48%, transparent 72%)`;
      }
    }) as EventListener);

    // Cinematic reveal during swipe: lighten vignettes to let full watercolor shine
    window.addEventListener('dj:space-transitioning', ((e: CustomEvent) => {
      const isTransitioning = Boolean(e.detail?.active);
      canvas.classList.toggle('is-revealing-background', isTransitioning);
    }) as EventListener);
  }

  initAtmosphereTransitions();
</script>

<style>
  .vibe-atmosphere-canvas {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .space-bg-layer {
    position: absolute;
    inset: 0;
    opacity: 0;
    z-index: 1;
    transform: scale(1.02);
    transition: opacity 1.2s cubic-bezier(0.25, 1, 0.5, 1), transform 1.8s cubic-bezier(0.2, 0.8, 0.4, 1);
  }

  .space-bg-layer.is-active {
    opacity: 1;
    z-index: 2;
    transform: scale(1);
  }

  .space-bg-img {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center 30%;
    filter: brightness(0.72) contrast(1.1) saturate(0.9);
    transition: filter 1s ease, opacity 1s ease;
  }

  :global(html[data-theme="day"]:not(.dark)) .space-bg-img {
    filter: brightness(0.96) contrast(1.05) saturate(0.95);
    opacity: 0.35;
  }

  /* Night Vignette */
  .space-vignette-night {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(11, 11, 13, 0.85) 0%,
      rgba(11, 11, 13, 0.4) 40%,
      rgba(11, 11, 13, 0.88) 85%,
      rgba(11, 11, 13, 0.98) 100%
    );
    opacity: 1;
    transition: opacity 1.1s cubic-bezier(0.25, 1, 0.5, 1);
  }

  /* Day Vignette */
  .space-vignette-day {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(252, 248, 251, 0.9) 0%,
      rgba(252, 248, 251, 0.55) 45%,
      rgba(252, 248, 251, 0.92) 88%,
      rgba(252, 248, 251, 0.98) 100%
    );
    opacity: 0;
    transition: opacity 1.1s cubic-bezier(0.25, 1, 0.5, 1);
  }

  :global(html[data-theme="day"]:not(.dark)) .space-vignette-night {
    opacity: 0;
  }

  :global(html[data-theme="day"]:not(.dark)) .space-vignette-day {
    opacity: 1;
  }

  /* Cinematic Reveal: during space transitions, fade out vignettes gently to reveal the breathtaking landscape */
  .vibe-atmosphere-canvas.is-revealing-background .space-vignette-night {
    opacity: 0.25;
  }

  :global(html[data-theme="day"]:not(.dark)) .vibe-atmosphere-canvas.is-revealing-background .space-vignette-day {
    opacity: 0.2;
  }

  .vibe-atmosphere-canvas.is-revealing-background .space-bg-img {
    filter: brightness(0.9) contrast(1.12) saturate(1.08);
  }

  :global(html[data-theme="day"]:not(.dark)) .vibe-atmosphere-canvas.is-revealing-background .space-bg-img {
    opacity: 0.8;
    filter: brightness(1.02) contrast(1.1) saturate(1.05);
  }

  /* Dynamic Aura */
  .dynamic-aura {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 38%, rgba(245, 166, 35, 0.26) 0%, rgba(245, 166, 35, 0.08) 45%, transparent 70%);
    transition: background 1.4s cubic-bezier(0.25, 1, 0.5, 1);
    mix-blend-mode: screen;
  }

  :global(html[data-theme="day"]:not(.dark)) .dynamic-aura {
    mix-blend-mode: multiply;
    opacity: 0.6;
  }

  /* Floating Dust Particles */
  .dust-particle {
    position: absolute;
    border-radius: var(--radius-full);
    pointer-events: none;
    transition: background-color 0.6s ease;
  }

  .dust-1 {
    top: 20%;
    left: 15%;
    width: 5px;
    height: 5px;
    background: var(--color-primary);
    opacity: 0.45;
    filter: blur(1px);
    animation-delay: 0s;
  }

  .dust-2 {
    top: 45%;
    right: 20%;
    width: 7px;
    height: 7px;
    background: var(--color-resonance);
    opacity: 0.35;
    filter: blur(1.5px);
    animation-delay: 2.2s;
  }

  .dust-3 {
    bottom: 25%;
    left: 28%;
    width: 6px;
    height: 6px;
    background: var(--color-primary);
    opacity: 0.3;
    filter: blur(1px);
    animation-delay: 4s;
  }

  .dust-4 {
    top: 65%;
    right: 12%;
    width: 5px;
    height: 5px;
    background: var(--color-secondary);
    opacity: 0.4;
    filter: blur(1.2px);
    animation-delay: 1.5s;
  }
</style>
