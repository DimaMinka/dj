---
import { spaces } from '../../data/spaces';

interface Props {
  initialIndex?: number;
}

const { initialIndex = 0 } = Astro.props;
const initialSpace = spaces[initialIndex] || spaces[0];
---

<div
  class="vibe-atmosphere-canvas"
  id="vibeAtmosphere"
  data-initial-index={initialIndex}
  style={`--active-dust-color: ${initialSpace.glowColorDark}; --active-dust-rgb: ${initialSpace.glowRgbDark}; --active-dust-color-light: ${initialSpace.glowColor}; --active-dust-rgb-light: ${initialSpace.glowRgb}; --active-dust-color-dark: ${initialSpace.glowColorDark}; --active-dust-rgb-dark: ${initialSpace.glowRgbDark};`}
  aria-hidden="true"
>
  <!-- Multi-layered Space Watercolor Backgrounds with smooth sequential fade -->
  {spaces.map((space, idx) => (
    <div
      class={`space-bg-layer space-layer-${space.slug} ${idx === initialIndex ? 'is-active' : ''}`}
      data-space-index={idx}
      data-glow-rgb={space.glowRgb}
      data-glow-color={space.glowColor}
      style={`--layer-glow: ${space.glowColor}; --bg-mobile: url('${space.bgWatercolor}'); --bg-desktop: url('${space.bgWatercolorDesktop || space.bgWatercolor}');`}
    >
      <div class="space-bg-img"></div>
      <div class="space-vignette-night"></div>
      <div class="space-vignette-day"></div>
    </div>
  ))}

  <!-- Dynamic Chromatic Aura (Glow flood that matches active space) -->
  <div
    class="dynamic-aura"
    id="dynamicAura"
    style={`background: radial-gradient(circle at 50% 38%, rgba(${initialSpace.glowRgb}, 0.28) 0%, rgba(${initialSpace.glowRgb}, 0.08) 45%, transparent 70%);`}
  ></div>

  <!-- Floating Luminous Dust Particles -->
  <div class="dust-particle dust-1 animate-float-dust"></div>
  <div class="dust-particle dust-2 animate-float-dust"></div>
  <div class="dust-particle dust-3 animate-float-dust"></div>
  <div class="dust-particle dust-4 animate-float-dust"></div>
</div>

<script>
  import { spaces } from '../../data/spaces';

  function initAtmosphereTransitions() {
    const canvas = document.getElementById('vibeAtmosphere');
    const dynamicAura = document.getElementById('dynamicAura');
    const layers = document.querySelectorAll('.space-bg-layer');
    if (!canvas || !dynamicAura) return;

    let currentActiveIndex = Number(canvas.dataset.initialIndex || 0);

    // Helper to update dynamic aura & dust properties based on theme and active space
    function updateAuraTheme(spaceIndex: number) {
      const space = spaces[spaceIndex];
      if (!space) return;

      const isNight = document.documentElement.getAttribute('data-theme') !== 'day' || document.documentElement.classList.contains('dark');
      const activeRgb = isNight ? space.glowRgbDark : space.glowRgb;
      const activeColor = isNight ? space.glowColorDark : space.glowColor;

      dynamicAura.style.background = `radial-gradient(circle at 50% 38%, rgba(${activeRgb}, 0.35) 0%, rgba(${activeRgb}, 0.12) 48%, transparent 72%)`;

      // 1. Set CSS custom properties on canvas container
      canvas.style.setProperty('--active-dust-color', activeColor);
      canvas.style.setProperty('--active-dust-rgb', activeRgb);

      // 2. Directly update each dust particle element to ensure smooth, immediate color transition
      const dustParticles = canvas.querySelectorAll('.dust-particle');
      dustParticles.forEach((particle) => {
        const p = particle as HTMLElement;
        p.style.backgroundColor = activeColor;
        p.style.boxShadow = isNight
          ? `0 0 14px rgba(${activeRgb}, 0.9), 0 0 5px ${activeColor}`
          : `0 0 12px rgba(${activeRgb}, 0.55), 0 0 4px ${activeColor}`;
      });
    }

    // 1. Sequential Step: Old background fades out to dark canvas; begin aura & dust transition to new space
    window.addEventListener('dj:space-bg-fadeout', ((e: CustomEvent) => {
      const { oldIndex, newIndex } = e.detail || {};
      const activeIdx = typeof oldIndex === 'number' ? oldIndex : currentActiveIndex;
      const oldLayer = layers[activeIdx];
      if (oldLayer) {
        oldLayer.classList.remove('is-active');
        oldLayer.classList.add('is-fading-out');
      }
      if (typeof newIndex === 'number' && spaces[newIndex]) {
        currentActiveIndex = newIndex;
        updateAuraTheme(newIndex);
      }
    }) as EventListener);

    // 2. Sequential Step: New background blooms and aura floods in
    window.addEventListener('dj:space-change', ((e: CustomEvent) => {
      const { index, slug } = e.detail || {};
      const targetIndex = typeof index === 'number' ? index : spaces.findIndex(s => s.slug === slug);
      if (targetIndex === -1) return;

      layers.forEach((layer, idx) => {
        layer.classList.remove('is-fading-out');
        if (idx === targetIndex) {
          layer.classList.add('is-active');
        } else {
          layer.classList.remove('is-active');
        }
      });

      currentActiveIndex = targetIndex;
      updateAuraTheme(targetIndex);
    }) as EventListener);

    // Update aura when theme is toggled between Day and Night
    window.addEventListener('dj:theme-change', (() => {
      updateAuraTheme(currentActiveIndex);
    }) as EventListener);

    // Cinematic reveal during transition: lighten vignettes to let pure watercolor landscape shine
    window.addEventListener('dj:space-transitioning', ((e: CustomEvent) => {
      const isTransitioning = Boolean(e.detail?.active);
      canvas.classList.toggle('is-revealing-background', isTransitioning);
    }) as EventListener);

    // Initial sync of aura & dust colors with the current theme & space
    updateAuraTheme(currentActiveIndex);
  }

  initAtmosphereTransitions();
</script>

<style>
  .vibe-atmosphere-canvas {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .space-bg-layer {
    position: absolute;
    inset: 0;
    opacity: 0;
    z-index: 1;
    transform: scale(1.02);
    transition: opacity 1.0s cubic-bezier(0.16, 1, 0.3, 1), transform 1.8s cubic-bezier(0.2, 0.8, 0.4, 1);
    will-change: opacity, transform;
  }

  .space-bg-layer.is-fading-out {
    opacity: 0;
    z-index: 2;
    transform: scale(1.01);
    transition: opacity 0.28s ease-out;
  }

  .space-bg-layer.is-active {
    opacity: 1;
    z-index: 3;
    transform: scale(1);
    transition: opacity 1.1s cubic-bezier(0.16, 1, 0.3, 1), transform 1.8s cubic-bezier(0.2, 0.8, 0.4, 1);
  }

  .space-bg-img {
    position: absolute;
    inset: 0;
    background-image: var(--bg-mobile);
    background-size: cover;
    background-position: center 30%;
    filter: brightness(0.72) contrast(1.1) saturate(0.9);
    transition: filter 1s ease, opacity 1s ease;
  }

  @media (min-width: 1024px) {
    .space-bg-img {
      background-image: var(--bg-desktop);
      background-position: center 40%;
    }
  }

  :global(html[data-theme="day"]:not(.dark)) .space-bg-img {
    filter: brightness(0.96) contrast(1.05) saturate(0.95);
    opacity: 0.35;
  }

  /* Night Vignette */
  .space-vignette-night {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(11, 11, 13, 0.85) 0%,
      rgba(11, 11, 13, 0.4) 40%,
      rgba(11, 11, 13, 0.88) 85%,
      rgba(11, 11, 13, 0.98) 100%
    );
    opacity: 1;
    transition: opacity 1.0s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Day Vignette */
  .space-vignette-day {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(252, 248, 251, 0.9) 0%,
      rgba(252, 248, 251, 0.55) 45%,
      rgba(252, 248, 251, 0.92) 88%,
      rgba(252, 248, 251, 0.98) 100%
    );
    opacity: 0;
    transition: opacity 1.0s cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global(html[data-theme="day"]:not(.dark)) .space-vignette-night {
    opacity: 0;
  }

  :global(html[data-theme="day"]:not(.dark)) .space-vignette-day {
    opacity: 1;
  }

  /* Cinematic Reveal: during pure artwork pause, vignettes dissolve to reveal 100% unobstructed landscape */
  .vibe-atmosphere-canvas.is-revealing-background .space-vignette-night {
    opacity: 0;
  }

  :global(html[data-theme="day"]:not(.dark)) .vibe-atmosphere-canvas.is-revealing-background .space-vignette-day {
    opacity: 0;
  }

  .vibe-atmosphere-canvas.is-revealing-background .space-bg-img {
    filter: brightness(0.9) contrast(1.12) saturate(1.08);
  }

  :global(html[data-theme="day"]:not(.dark)) .vibe-atmosphere-canvas.is-revealing-background .space-bg-img {
    opacity: 0.8;
    filter: brightness(1.02) contrast(1.1) saturate(1.05);
  }

  /* Dynamic Aura */
  .dynamic-aura {
    position: absolute;
    inset: 0;
    z-index: 3;
    opacity: 1;
    background: radial-gradient(circle at 50% 38%, rgba(245, 166, 35, 0.26) 0%, rgba(245, 166, 35, 0.08) 45%, transparent 70%);
    transition: opacity 1.0s cubic-bezier(0.16, 1, 0.3, 1), background 1.4s cubic-bezier(0.25, 1, 0.5, 1);
    mix-blend-mode: screen;
  }

  /* When pure artwork landscape is revealed: hide aura completely */
  .vibe-atmosphere-canvas.is-revealing-background .dynamic-aura {
    opacity: 0;
  }

  :global(html[data-theme="day"]:not(.dark)) .dynamic-aura {
    mix-blend-mode: multiply;
    opacity: 0.6;
  }

  :global(html[data-theme="day"]:not(.dark)) .vibe-atmosphere-canvas.is-revealing-background .dynamic-aura {
    opacity: 0;
  }

  /* Floating Dust Particles */
  /* Floating Luminous Dust Particles (tinted with active space glow) */
  .dust-particle {
    position: absolute;
    z-index: 4;
    border-radius: var(--radius-full);
    pointer-events: none;
    background-color: var(--active-dust-color, var(--color-primary));
    box-shadow: 0 0 12px rgba(var(--active-dust-rgb), 0.75), 0 0 4px var(--active-dust-color, var(--color-primary));
    transition: background-color 0.8s cubic-bezier(0.2, 0.8, 0.4, 1), 
                box-shadow 0.8s cubic-bezier(0.2, 0.8, 0.4, 1),
                opacity 0.8s ease;
  }

  .dust-1 {
    top: 20%;
    left: 15%;
    width: 5px;
    height: 5px;
    opacity: 0.65;
    filter: blur(0.8px);
    animation-delay: 0s;
  }

  .dust-2 {
    top: 45%;
    right: 20%;
    width: 7px;
    height: 7px;
    opacity: 0.55;
    filter: blur(1.2px);
    animation-delay: 2.2s;
  }

  .dust-3 {
    bottom: 25%;
    left: 28%;
    width: 4px;
    height: 4px;
    opacity: 0.75;
    filter: blur(0.5px);
    animation-delay: 4s;
  }

  .dust-4 {
    top: 65%;
    right: 12%;
    width: 6px;
    height: 6px;
    opacity: 0.6;
    filter: blur(1px);
    animation-delay: 1.5s;
  }
</style>
