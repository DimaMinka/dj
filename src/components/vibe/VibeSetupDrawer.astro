---
import { defaultLang, type SupportedLang, useTranslations } from '../../i18n/ui';
import { spaces } from '../../data/spaces';

interface Props {
  lang?: SupportedLang;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
---

<div id="vibeSetupModal" class="setup-sheet-overlay" inert aria-hidden="true">
  <!-- Backdrop Click-to-close -->
  <div class="sheet-backdrop" id="sheetBackdrop"></div>

  <!-- Bottom Sheet Container -->
  <div class="sheet-panel" id="sheetPanel" role="dialog" aria-modal="true" aria-labelledby="sheetTitle">
    <!-- Pull Down Handle -->
    <div class="sheet-handle-bar" id="sheetHandle">
      <span class="sheet-pill"></span>
    </div>

    <!-- Header with Close Button -->
    <div class="sheet-header">
      <div class="sheet-title-group">
        <h3 id="sheetTitle" class="sheet-title">{t('setupDrawerTitle')}</h3>
        <p class="sheet-subtitle">{t('setupDrawerSubtitle')}</p>
      </div>

      <button id="closeSheetBtn" type="button" class="sheet-close-btn" aria-label="Close setup drawer">
        <span class="material-symbols-outlined" aria-hidden="true">close</span>
      </button>
    </div>

    <!-- Dynamic Content Loaded for Active Space Setup -->
    <div class="sheet-body" id="sheetBody">
      {spaces.map((space) => (
        <div class="space-setup-view" data-setup-slug={space.slug} id={`setup-${space.slug}`}>
          <!-- Hardware Rig Visual Photograph -->
          <div class="setup-image-wrap">
            <img
              src={space.bgWatercolorDesktop || space.bgWatercolor}
              alt={space.setup.name[lang] || space.setup.name.en}
              class="setup-img"
              loading="lazy"
            />
            <div class="setup-img-overlay"></div>
            <div class="setup-badge">
              <span class="material-symbols-outlined badge-icon" aria-hidden="true">verified</span>
              <span class="badge-text">{space.setup.name[lang] || space.setup.name.en}</span>
            </div>
          </div>

          <!-- Technical Specs Grid -->
          <div class="specs-grid">
            <div class="spec-card">
              <div class="spec-icon-box">
                <span class="material-symbols-outlined spec-icon" aria-hidden="true">lightbulb</span>
              </div>
              <div class="spec-text-col">
                <span class="spec-label">{t('setupLights')}</span>
                <span class="spec-val">{typeof space.setup.lightsCount === 'object' ? (space.setup.lightsCount[lang] || space.setup.lightsCount.en) : space.setup.lightsCount}</span>
              </div>
            </div>

            <div class="spec-card">
              <div class="spec-icon-box">
                <span class="material-symbols-outlined spec-icon" aria-hidden="true">speaker</span>
              </div>
              <div class="spec-text-col">
                <span class="spec-label">{t('setupSound')}</span>
                <span class="spec-val">{space.setup.soundType[lang] || space.setup.soundType.en}</span>
              </div>
            </div>

            <div class="spec-card">
              <div class="spec-icon-box">
                <span class="material-symbols-outlined spec-icon" aria-hidden="true">groups</span>
              </div>
              <div class="spec-text-col">
                <span class="spec-label">{t('setupAudience')}</span>
                <span class="spec-val">{space.setup.idealFor[lang] || space.setup.idealFor.en}</span>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom Actions -->
    <div class="sheet-footer">
      <button id="closeSheetBottomBtn" type="button" class="sheet-confirm-btn">
        <span>{t('setupCloseBtn')}</span>
      </button>
    </div>
  </div>
</div>

<script>
  function initSetupDrawer() {
    const modal = document.getElementById('vibeSetupModal');
    const panel = document.getElementById('sheetPanel');
    const backdrop = document.getElementById('sheetBackdrop');
    const closeBtn = document.getElementById('closeSheetBtn');
    const closeBottomBtn = document.getElementById('closeSheetBottomBtn');
    const handle = document.getElementById('sheetHandle');
    const setupViews = document.querySelectorAll('.space-setup-view');

    if (!modal || !panel) return;

    let isOpen = false;

    function openDrawer(slug: string) {
      isOpen = true;
      modal.removeAttribute('inert');
      modal.setAttribute('aria-hidden', 'false');
      modal.classList.add('is-open');
      document.body.style.overflow = 'hidden';

      // Show matching space setup
      setupViews.forEach((view) => {
        const viewSlug = (view as HTMLElement).dataset.setupSlug;
        if (viewSlug === slug) {
          view.classList.add('is-visible');
        } else {
          view.classList.remove('is-visible');
        }
      });
    }

    function closeDrawer() {
      if (!isOpen) return;
      isOpen = false;
      modal.setAttribute('inert', '');
      modal.setAttribute('aria-hidden', 'true');
      modal.classList.remove('is-open');
      document.body.style.overflow = '';
    }

    // Open event listener
    window.addEventListener('dj:open-setup', ((e: CustomEvent) => {
      const slug = e.detail?.slug || 'sunset';
      openDrawer(slug);
    }) as EventListener);

    // Close triggers
    closeBtn?.addEventListener('click', closeDrawer);
    closeBottomBtn?.addEventListener('click', closeDrawer);
    backdrop?.addEventListener('click', closeDrawer);

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) {
        closeDrawer();
      }
    });

    // Touch pull-down gesture to dismiss
    let touchStartY = 0;
    let touchCurrentY = 0;

    handle?.addEventListener('touchstart', (e: TouchEvent) => {
      touchStartY = e.touches[0].clientY;
      touchCurrentY = touchStartY;
    }, { passive: true });

    handle?.addEventListener('touchmove', (e: TouchEvent) => {
      touchCurrentY = e.touches[0].clientY;
      const deltaY = touchCurrentY - touchStartY;
      if (deltaY > 0) {
        panel.style.transform = `translateY(${deltaY}px)`;
      }
    }, { passive: true });

    handle?.addEventListener('touchend', () => {
      const deltaY = touchCurrentY - touchStartY;
      panel.style.transform = '';
      if (deltaY > 90) {
        closeDrawer();
      }
    });
  }

  initSetupDrawer();
</script>

<style>
  .setup-sheet-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .setup-sheet-overlay.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .sheet-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    cursor: pointer;
  }

  .sheet-panel {
    position: relative;
    z-index: 101;
    width: 100%;
    max-width: 34rem;
    margin-inline: auto;
    max-height: 85vh;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-xl) var(--radius-xl) 0 0;
    background: var(--color-surface);
    border: 1px solid var(--color-glass-border);
    box-shadow: 0 -10px 40px rgba(0, 0, 0, 0.5);
    transform: translateY(100%);
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.4, 1);
    box-sizing: border-box;
    overflow: hidden;
  }

  .setup-sheet-overlay.is-open .sheet-panel {
    transform: translateY(0);
  }

  .sheet-handle-bar {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-block: 0.75rem 0.25rem;
    cursor: grab;
    touch-action: none;
  }

  .sheet-pill {
    width: 2.75rem;
    height: 4px;
    border-radius: var(--radius-full);
    background: var(--color-text-subtle);
    opacity: 0.4;
  }

  .sheet-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding-inline: 1.25rem;
    padding-block-end: 0.75rem;
    border-block-end: 1px solid var(--color-glass-border);
  }

  .sheet-title-group {
    display: flex;
    flex-direction: column;
  }

  .sheet-title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-main);
    margin: 0;
  }

  .sheet-subtitle {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    color: var(--color-text-subtle);
    margin: 0.2rem 0 0;
  }

  .sheet-close-btn {
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-full);
    background: var(--color-surface-container);
    border: 1px solid var(--color-glass-border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-main);
    cursor: pointer;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .sheet-close-btn:hover {
    border-color: var(--color-primary);
    transform: scale(1.05);
  }

  .sheet-body {
    flex: 1;
    overflow-y: auto;
    padding: 1.25rem;
    box-sizing: border-box;
  }

  .space-setup-view {
    display: none;
    flex-direction: column;
    gap: 1rem;
  }

  .space-setup-view.is-visible {
    display: flex;
  }

  .setup-image-wrap {
    position: relative;
    width: 100%;
    height: 12rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-glass-border);
  }

  .setup-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .setup-img-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.8) 0%, transparent 60%);
  }

  .setup-badge {
    position: absolute;
    bottom: 0.75rem;
    inset-inline-start: 0.75rem;
    max-width: calc(100% - 1.5rem);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding-inline: 0.65rem;
    padding-block: 0.3rem;
    border-radius: var(--radius-full);
    background: rgba(0, 0, 0, 0.7);
    border: 1px solid var(--color-primary);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-sizing: border-box;
  }

  .badge-icon {
    font-size: 0.875rem;
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .badge-text {
    font-family: var(--font-body);
    font-size: clamp(0.6rem, 2.2vw, 0.6875rem);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #ffffff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .specs-grid {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .spec-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem;
    border-radius: var(--radius-md);
    background: var(--color-surface-container);
    border: 1px solid var(--color-glass-border);
  }

  .spec-icon-box {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-full);
    background: var(--color-surface-glass);
    border: 1px solid var(--color-glass-border);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .spec-icon {
    font-size: 1.125rem;
    color: var(--color-primary);
  }

  .spec-text-col {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .spec-label {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .spec-val {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-main);
    margin-block-start: 0.15rem;
  }

  .sheet-footer {
    padding-inline: 1.25rem;
    padding-block: 0.85rem;
    border-block-start: 1px solid var(--color-glass-border);
  }

  .sheet-confirm-btn {
    width: 100%;
    padding-block: 0.75rem;
    border-radius: var(--radius-full);
    background: var(--color-surface-container-high);
    border: 1px solid var(--color-glass-border);
    color: var(--color-text-main);
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    cursor: pointer;
    transition: var(--transition-theme), border-color 0.2s ease, background-color 0.2s ease;
  }

  .sheet-confirm-btn:hover {
    border-color: var(--color-primary);
    background: var(--color-primary-glow);
  }
</style>
