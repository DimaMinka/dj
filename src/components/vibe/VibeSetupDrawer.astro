---
import { defaultLang, type SupportedLang, useTranslations, getWhatsAppContextualLink } from '../../i18n/ui';
import { spaces, getSpaceGallery } from '../../data/spaces';
import LocalSocialProof from './LocalSocialProof.astro';

interface Props {
  lang?: SupportedLang;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
---

<div id="vibeSetupModal" class="setup-sheet-overlay" inert aria-hidden="true">
  <!-- Backdrop Click-to-close -->
  <div class="sheet-backdrop" id="sheetBackdrop"></div>

  <!-- Bottom Sheet Container -->
  <div class="sheet-panel" id="sheetPanel" role="dialog" aria-modal="true" aria-labelledby="sheetTitle">
    <!-- Pull Down Handle -->
    <div class="sheet-handle-bar" id="sheetHandle">
      <span class="sheet-pill"></span>
    </div>

    <!-- Header with Close Button -->
    <div class="sheet-header">
      <div class="sheet-title-group">
        <h3 id="sheetTitle" class="sheet-title">{t('setupDrawerTitle')}</h3>
        <p class="sheet-subtitle">{t('setupDrawerSubtitle')}</p>
      </div>

      <button id="closeSheetBtn" type="button" class="sheet-close-btn" aria-label="Close setup drawer">
        <span class="material-symbols-outlined" aria-hidden="true">close</span>
      </button>
    </div>

    <!-- Dynamic Content Loaded for Active Space Setup -->
    <div class="sheet-body" id="sheetBody">
      {spaces.map((space) => {
        const gallery = getSpaceGallery(space);
        return (
          <div
            class="space-setup-view"
            data-setup-slug={space.slug}
            id={`setup-${space.slug}`}
            style={`--card-glow-color: ${space.glowColor}; --card-glow-rgb: ${space.glowRgb};`}
          >
            <!-- Hardware Rig Visual Photograph -->
            <div class="setup-image-wrap">
              <div class="setup-loader-shimmer" aria-hidden="true"></div>
              <img
                src={space.bgWatercolorDesktop || space.bgWatercolor}
                alt={space.setup.name[lang] || space.setup.name.en}
                class="setup-img"
                loading="lazy"
              />
              <div class="setup-img-overlay"></div>
              <div class="setup-badge">
                <span class="material-symbols-outlined badge-icon" aria-hidden="true">verified</span>
                <span class="badge-text">{space.setup.name[lang] || space.setup.name.en}</span>
              </div>
            </div>

            <!-- Technical Specs Grid as Interactive Tabs -->
            <div class="specs-grid" role="tablist" aria-label="Specification categories">
              <button
                type="button"
                class="spec-card"
                role="tab"
                aria-selected="false"
                data-spec-tab="lights"
                data-tab-img={gallery.lights}
                data-tab-title={gallery.lightsTitle[lang] || gallery.lightsTitle.en}
              >
                <div class="spec-icon-box">
                  <span class="material-symbols-outlined spec-icon" aria-hidden="true">lightbulb</span>
                </div>
                <div class="spec-text-col">
                  <span class="spec-label">{t('setupLights')}</span>
                  <span class="spec-val">{typeof space.setup.lightsCount === 'object' ? (space.setup.lightsCount[lang] || space.setup.lightsCount.en) : space.setup.lightsCount}</span>
                </div>
              </button>

              <button
                type="button"
                class="spec-card"
                role="tab"
                aria-selected="false"
                data-spec-tab="sound"
                data-tab-img={gallery.sound}
                data-tab-title={gallery.soundTitle[lang] || gallery.soundTitle.en}
              >
                <div class="spec-icon-box">
                  <span class="material-symbols-outlined spec-icon" aria-hidden="true">speaker</span>
                </div>
                <div class="spec-text-col">
                  <span class="spec-label">{t('setupSound')}</span>
                  <span class="spec-val">{space.setup.soundType[lang] || space.setup.soundType.en}</span>
                </div>
              </button>

              <button
                type="button"
                class="spec-card is-selected"
                role="tab"
                aria-selected="true"
                data-spec-tab="location"
                data-tab-img={gallery.location}
                data-tab-title={gallery.locationTitle[lang] || gallery.locationTitle.en}
              >
                <div class="spec-icon-box">
                  <span class="material-symbols-outlined spec-icon" aria-hidden="true">groups</span>
                </div>
                <div class="spec-text-col">
                  <span class="spec-label">{t('setupAudience')}</span>
                  <span class="spec-val">{space.setup.idealFor[lang] || space.setup.idealFor.en}</span>
                </div>
              </button>
            </div>
          </div>
        );
      })}

      <!-- Local Northern Social Proof Ticker -->
      <LocalSocialProof lang={lang} />
    </div>

    <!-- Bottom Actions: Primary Direct Booking WhatsApp CTA -->
    <div class="sheet-footer">
      <a
        id="drawerWhatsAppCta"
        href={getWhatsAppContextualLink(spaces[0].title[lang] || spaces[0].title.en, lang)}
        target="_blank"
        rel="noopener noreferrer"
        class="sheet-whatsapp-cta"
      >
        <span class="material-symbols-outlined cta-wa-icon" aria-hidden="true">chat</span>
        <span class="cta-wa-text">{t('whatsappDiscuss')}</span>
        <span class="material-symbols-outlined cta-arrow-icon" aria-hidden="true">arrow_forward</span>
      </a>
    </div>
  </div>
</div>

<script>
  function initSetupDrawer() {
    const modal = document.getElementById('vibeSetupModal');
    const panel = document.getElementById('sheetPanel');
    const backdrop = document.getElementById('sheetBackdrop');
    const closeBtn = document.getElementById('closeSheetBtn');
    const waCta = document.getElementById('drawerWhatsAppCta') as HTMLAnchorElement | null;
    const handle = document.getElementById('sheetHandle');
    const setupViews = document.querySelectorAll('.space-setup-view');

    if (!modal || !panel) return;

    let isOpen = false;

    // Map space titles for WhatsApp contextual links
    const spaceDataMap: Record<string, string> = {};
    setupViews.forEach((view) => {
      const slug = (view as HTMLElement).dataset.setupSlug;
      const title = view.querySelector('.badge-text')?.textContent || slug || 'Event';
      if (slug) spaceDataMap[slug] = title;
    });

    function openDrawer(slug: string) {
      isOpen = true;
      modal.removeAttribute('inert');
      modal.setAttribute('aria-hidden', 'false');
      modal.classList.add('is-open');
      document.body.style.overflow = 'hidden';

      // Show matching space setup
      setupViews.forEach((view) => {
        const viewSlug = (view as HTMLElement).dataset.setupSlug;
        if (viewSlug === slug) {
          view.classList.add('is-visible');
        } else {
          view.classList.remove('is-visible');
        }
      });

      // Update contextual WhatsApp CTA href
      if (waCta) {
        const spaceName = spaceDataMap[slug] || slug;
        const currentLang = document.documentElement.lang || 'en';
        let waText = '';
        if (currentLang === 'ru') {
          waText = `Привет, Dima! Понравился сетап пространства "${spaceName}". Хочу обсудить детали и свободные даты для нашего вечера.`;
        } else if (currentLang === 'he') {
          waText = `היי דימה, אהבתי מאוד את המערך של "${spaceName}". אשמח לבדוק תאריכים פנויים ופרטים לאירוע שלנו.`;
        } else {
          waText = `Hi Dima! I really loved the "${spaceName}" setup. I'd like to check available dates and discuss details for our event.`;
        }
        waCta.href = `https://wa.me/972546885244?text=${encodeURIComponent(waText)}`;
      }
    }

    function closeDrawer() {
      if (!isOpen) return;
      isOpen = false;
      modal.setAttribute('inert', '');
      modal.setAttribute('aria-hidden', 'true');
      modal.classList.remove('is-open');
      document.body.style.overflow = '';
    }

    // Open event listener
    window.addEventListener('dj:open-setup', ((e: CustomEvent) => {
      const slug = e.detail?.slug || 'sunset';
      openDrawer(slug);
    }) as EventListener);

    // Close triggers
    closeBtn?.addEventListener('click', closeDrawer);
    backdrop?.addEventListener('click', closeDrawer);

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) {
        closeDrawer();
      }
    });

    // Touch pull-down gesture to dismiss
    let touchStartY = 0;
    let touchCurrentY = 0;

    handle?.addEventListener('touchstart', (e: TouchEvent) => {
      touchStartY = e.touches[0].clientY;
      touchCurrentY = touchStartY;
    }, { passive: true });

    handle?.addEventListener('touchmove', (e: TouchEvent) => {
      touchCurrentY = e.touches[0].clientY;
      const deltaY = touchCurrentY - touchStartY;
      if (deltaY > 0) {
        panel.style.transform = `translateY(${deltaY}px)`;
      }
    }, { passive: true });

    handle?.addEventListener('touchend', () => {
      const deltaY = touchCurrentY - touchStartY;
      panel.style.transform = '';
      if (deltaY > 90) {
        closeDrawer();
      }
    });

    // Interactive specs tabs in drawer (switch photo, badge & selected state)
    const drawerSpecTabs = document.querySelectorAll('.space-setup-view .spec-card');
    drawerSpecTabs.forEach((tab) => {
      tab.addEventListener('click', (e) => {
        e.stopPropagation();
        const view = tab.closest('.space-setup-view');
        if (!view) return;

        const allTabs = view.querySelectorAll('.spec-card');
        allTabs.forEach((t) => {
          t.classList.remove('is-selected');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('is-selected');
        tab.setAttribute('aria-selected', 'true');

        const newImgSrc = (tab as HTMLElement).dataset.tabImg;
        const newTitle = (tab as HTMLElement).dataset.tabTitle;
        const img = view.querySelector('.setup-img') as HTMLImageElement | null;
        const shimmer = view.querySelector('.setup-loader-shimmer');
        const badgeText = view.querySelector('.badge-text');

        if (!img || !newImgSrc) return;
        if (img.src.includes(newImgSrc)) return;

        if (shimmer) shimmer.classList.add('is-active');
        img.classList.add('is-switching');

        const tempImg = new Image();
        tempImg.onload = () => {
          img.src = newImgSrc;
          if (badgeText && newTitle) badgeText.textContent = newTitle;
          img.classList.remove('is-switching');
          if (shimmer) shimmer.classList.remove('is-active');
        };
        tempImg.onerror = () => {
          img.classList.remove('is-switching');
          if (shimmer) shimmer.classList.remove('is-active');
        };
        tempImg.src = newImgSrc;
      });
    });
  }

  initSetupDrawer();
</script>

<style>
  .setup-sheet-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .setup-sheet-overlay.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .sheet-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    cursor: pointer;
  }

  .sheet-panel {
    position: relative;
    z-index: 101;
    width: 100%;
    max-width: 34rem;
    margin-inline: auto;
    max-height: 85vh;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-xl) var(--radius-xl) 0 0;
    background: var(--color-surface);
    border: 1px solid var(--color-glass-border);
    box-shadow: 0 -10px 40px rgba(0, 0, 0, 0.5);
    transform: translateY(100%);
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.4, 1);
    box-sizing: border-box;
    overflow: hidden;
  }

  .setup-sheet-overlay.is-open .sheet-panel {
    transform: translateY(0);
  }

  .sheet-handle-bar {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-block: 0.75rem 0.25rem;
    cursor: grab;
    touch-action: none;
  }

  .sheet-pill {
    width: 2.75rem;
    height: 4px;
    border-radius: var(--radius-full);
    background: var(--color-text-subtle);
    opacity: 0.4;
  }

  .sheet-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding-inline: 1.25rem;
    padding-block-end: 0.75rem;
    border-block-end: 1px solid var(--color-glass-border);
  }

  .sheet-title-group {
    display: flex;
    flex-direction: column;
  }

  .sheet-title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-main);
    margin: 0;
  }

  .sheet-subtitle {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    color: var(--color-text-subtle);
    margin: 0.2rem 0 0;
  }

  .sheet-close-btn {
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-full);
    background: var(--color-surface-container);
    border: 1px solid var(--color-glass-border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-main);
    cursor: pointer;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .sheet-close-btn:hover {
    border-color: var(--color-primary);
    transform: scale(1.05);
  }

  .sheet-body {
    flex: 1;
    overflow-y: auto;
    padding: 1.25rem;
    box-sizing: border-box;
  }

  .space-setup-view {
    display: none;
    flex-direction: column;
    gap: 1rem;
  }

  .space-setup-view.is-visible {
    display: flex;
  }

  .setup-image-wrap {
    position: relative;
    width: 100%;
    height: 12rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-glass-border);
  }

  .setup-loader-shimmer {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.25) 50%, transparent 100%);
    transform: translateX(-100%);
    pointer-events: none;
    z-index: 2;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .setup-loader-shimmer.is-active {
    opacity: 1;
    animation: setupShimmerSweep 0.65s ease-in-out infinite;
  }

  @keyframes setupShimmerSweep {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(100%);
    }
  }

  .setup-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease, opacity 0.3s ease;
  }

  .setup-img.is-switching {
    opacity: 0.35;
    transform: scale(0.98);
  }

  .setup-img-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.8) 0%, transparent 60%);
  }

  .setup-badge {
    position: absolute;
    bottom: 0.75rem;
    inset-inline-start: 0.75rem;
    max-width: calc(100% - 1.5rem);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding-inline: 0.65rem;
    padding-block: 0.3rem;
    border-radius: var(--radius-full);
    background: rgba(0, 0, 0, 0.7);
    border: 1px solid var(--card-glow-color, var(--color-primary));
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-sizing: border-box;
    z-index: 3;
  }

  .badge-icon {
    font-size: 0.875rem;
    color: var(--card-glow-color, var(--color-primary));
    flex-shrink: 0;
  }

  .badge-text {
    font-family: var(--font-body);
    font-size: clamp(0.6rem, 2.2vw, 0.6875rem);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #ffffff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .specs-grid {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .spec-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem;
    border-radius: var(--radius-md);
    background: var(--color-surface-container);
    border: 1px solid var(--color-glass-border);
    cursor: pointer;
    text-align: start;
    width: 100%;
    font: inherit;
    color: inherit;
    outline: none;
    transition: background-color 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease, transform 0.2s ease;
  }

  .spec-card:hover {
    border-color: var(--card-glow-color, var(--color-primary));
    background: var(--color-surface-container-high);
  }

  .spec-card.is-selected {
    border-color: var(--card-glow-color, var(--color-primary));
    background: rgba(var(--card-glow-rgb, 120, 120, 120), 0.12);
    box-shadow: 0 0 16px rgba(var(--card-glow-rgb, 120, 120, 120), 0.25), inset 0 0 0 1px var(--card-glow-color, var(--color-primary));
  }

  .spec-card.is-selected .spec-label {
    color: var(--card-glow-color, var(--color-primary));
    font-weight: 700;
  }

  .spec-icon-box {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-full);
    background: var(--color-surface-glass);
    border: 1px solid var(--color-glass-border);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .spec-icon {
    font-size: 1.125rem;
    color: var(--color-primary);
  }

  .spec-text-col {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .spec-label {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .spec-val {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-main);
    margin-block-start: 0.15rem;
  }

  .sheet-footer {
    padding-inline: 1.25rem;
    padding-block: 0.85rem;
    border-block-start: 1px solid var(--color-glass-border);
  }

  .sheet-whatsapp-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    width: 100%;
    padding-block: 0.85rem;
    padding-inline: 1.25rem;
    border-radius: var(--radius-full);
    background: #25D366;
    color: #ffffff;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    box-shadow: 0 4px 18px rgba(37, 211, 102, 0.35);
    box-sizing: border-box;
    transition: transform 0.2s ease, filter 0.2s ease, box-shadow 0.2s ease;
  }

  .sheet-whatsapp-cta:hover {
    transform: translateY(-1px);
    filter: brightness(1.08);
    box-shadow: 0 6px 24px rgba(37, 211, 102, 0.45);
  }

  .sheet-whatsapp-cta:active {
    transform: translateY(0);
  }

  .cta-wa-icon {
    font-size: 1.15rem;
    flex-shrink: 0;
    font-variation-settings: 'FILL' 1;
  }

  .cta-wa-text {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cta-arrow-icon {
    font-size: 1rem;
    flex-shrink: 0;
    opacity: 0.85;
    transition: transform 0.2s ease;
  }

  :global([dir="rtl"]) .cta-arrow-icon {
    transform: rotate(180deg);
  }

  .sheet-whatsapp-cta:hover .cta-arrow-icon {
    transform: translateX(3px);
  }

  :global([dir="rtl"]) .sheet-whatsapp-cta:hover .cta-arrow-icon {
    transform: rotate(180deg) translateX(3px);
  }
</style>
