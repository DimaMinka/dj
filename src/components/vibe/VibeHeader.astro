---
import { defaultLang, type SupportedLang, useTranslations } from '../../i18n/ui';
import { spaces } from '../../data/spaces';

interface Props {
  lang?: SupportedLang;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
---

<header class="vibe-header">
  <div class="nav-left">
    <!-- Back to Intro Gateway -->
    <a href="/" class="back-btn" aria-label="Return to Portal Gateway">
      <span class="material-symbols-outlined back-arrow" aria-hidden="true">arrow_back</span>
      <span class="back-label">{t('vibeBackToIntro')}</span>
    </a>

    <!-- DM Monogram Logo -->
    <div class="logo-box">
      <svg class="logo-svg" viewBox="0 0 576.59 678.28" fill="currentColor">
        <path d="m199.66 44.95v518.06l-199.65 115.27c0-222.21 0-444.42-.01-666.63 35.16 20.39 70.32 40.78 105.48 61.18-.11 28.59-.22 57.18-.33 85.77-9.46-5.46-18.92-10.92-28.37-16.38.09 135.02.19 270.04.28 405.06 14.98-8.59 29.95-17.18 44.93-25.78v-521.5c25.89 14.98 51.78 29.97 77.67 44.95z"></path>
        <path d="m576.59 345.02c-7.56 4.49-15.13 8.98-22.69 13.47l-153 88.34v-85.85c4.26-2.34 8.57-4.77 12.92-7.29 4.93-2.85 9.74-5.7 14.43-8.55-13.8-8.06-27.6-16.12-41.41-24.18.02 44.65.04 89.29.06 133.95l-78 45.03c-.02-74.58-.03-149.16-.05-223.73-4.65-2.77-9.3-5.54-13.95-8.31.02 80.03.03 160.06.05 240.09.01 22.36.01 44.72.02 67.08v10.49c-25.52 14.72-51.03 29.45-76.54 44.17l-3.56 2.05v-10.47c-.01-22.36-.02-44.71-.02-67.07-.04-139.38-.08-278.76-.12-418.14 120.62 69.64 241.24 139.28 361.86 208.92z"></path>
      </svg>
    </div>
  </div>

  <!-- Center Active Index Counter -->
  <div class="nav-center">
    <div class="counter-badge">
      <span id="activeSpaceNum" class="counter-num">01</span>
      <span class="counter-sep">/</span>
      <span class="counter-total">{String(spaces.length).padStart(2, '0')}</span>
    </div>
  </div>

  <!-- Right Actions: Theme Toggle -->
  <div class="nav-right">
    <button id="vibeThemeToggleBtn" class="theme-toggle" type="button" aria-label="Toggle theme resonance">
      <div class="equalizer-bars" aria-hidden="true">
        <span class="bar bar-1"></span>
        <span class="bar bar-2"></span>
        <span class="bar bar-3"></span>
      </div>
      <span id="vibeThemeToggleLabel" class="theme-label">{t('nightResonance')}</span>
    </button>
  </div>
</header>

<script>
  function initVibeHeader() {
    const numDisplay = document.getElementById('activeSpaceNum');
    const themeBtn = document.getElementById('vibeThemeToggleBtn');
    const themeLabel = document.getElementById('vibeThemeToggleLabel');

    // Update active space counter from slider event
    window.addEventListener('dj:space-change', ((e: CustomEvent) => {
      const idx = e.detail?.index;
      if (typeof idx === 'number' && numDisplay) {
        numDisplay.textContent = String(idx + 1).padStart(2, '0');
      }
    }) as EventListener);

    // Theme resonance management
    function updateLabel(theme: string) {
      if (!themeLabel) return;
      themeLabel.textContent = theme === 'night' ? 'Night Resonance' : 'Day Resonance';
    }

    const currentTheme = document.documentElement.getAttribute('data-theme') || 'night';
    updateLabel(currentTheme);

    themeBtn?.addEventListener('click', () => {
      const active = document.documentElement.getAttribute('data-theme') || 'night';
      const next = active === 'night' ? 'day' : 'night';

      document.documentElement.setAttribute('data-theme', next);
      document.documentElement.classList.toggle('dark', next === 'night');
      localStorage.setItem('dj-theme-resonance', next);
      updateLabel(next);

      window.dispatchEvent(new CustomEvent('dj:theme-change', { detail: { theme: next } }));
    });

    window.addEventListener('dj:theme-change', ((e: CustomEvent) => {
      if (e.detail?.theme) updateLabel(e.detail.theme);
    }) as EventListener);
  }

  initVibeHeader();
</script>

<style>
  .vibe-header {
    position: relative;
    z-index: 25;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: 1.25rem;
    padding-block-start: 0.5rem;
    width: 100%;
    box-sizing: border-box;
    flex-shrink: 0;
  }

  .nav-left {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .back-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding-inline: 0.625rem;
    padding-block: 0.375rem;
    border-radius: var(--radius-full);
    background: var(--color-surface-glass);
    border: 1px solid var(--color-glass-border);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    color: var(--color-text-main);
    text-decoration: none;
    transition: var(--transition-theme), transform 0.2s ease, border-color 0.2s ease;
  }

  .back-btn:hover {
    border-color: var(--color-primary);
    transform: translateX(-2px);
  }

  :global([dir="rtl"]) .back-btn:hover {
    transform: translateX(2px);
  }

  .back-arrow {
    font-size: 1rem;
    color: var(--color-primary);
    transition: transform 0.2s ease;
  }

  :global([dir="rtl"]) .back-arrow {
    transform: rotate(180deg);
  }

  .back-label {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .logo-box {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-md);
    background: var(--color-surface-glass);
    border: 1px solid var(--color-glass-border);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.3rem;
    box-shadow: 0 0 12px var(--color-primary-glow);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition: var(--transition-theme);
  }

  .logo-svg {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--color-primary);
    filter: drop-shadow(0 0 6px var(--color-primary-glow));
  }

  .nav-center {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .counter-badge {
    display: inline-flex;
    align-items: baseline;
    gap: 0.25rem;
    padding-inline: 0.75rem;
    padding-block: 0.25rem;
    border-radius: var(--radius-full);
    background: var(--color-surface-glass);
    border: 1px solid var(--color-glass-border);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .counter-num {
    color: var(--color-primary);
  }

  .counter-sep {
    color: var(--color-text-subtle);
    opacity: 0.5;
  }

  .counter-total {
    color: var(--color-text-subtle);
  }

  .nav-right {
    display: flex;
    align-items: center;
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding-inline: 0.65rem;
    padding-block: 0.35rem;
    border-radius: var(--radius-full);
    background: var(--color-surface-glass);
    border: 1px solid var(--color-glass-border);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    color: var(--color-text-main);
    cursor: pointer;
    transition: var(--transition-theme), transform 0.2s ease;
  }

  .theme-toggle:hover {
    border-color: var(--color-primary);
    transform: translateY(-1px);
  }

  .equalizer-bars {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 0.75rem;
  }

  .bar {
    width: 2px;
    border-radius: 999px;
  }

  .bar-1 {
    height: 0.35rem;
    background: var(--color-primary);
    animation: pulse 1.2s ease-in-out infinite;
  }

  .bar-2 {
    height: 0.75rem;
    background: var(--color-resonance);
    box-shadow: 0 0 6px var(--color-resonance-glow);
    animation: pulse 0.9s ease-in-out infinite 0.2s;
  }

  .bar-3 {
    height: 0.45rem;
    background: var(--color-primary);
    animation: pulse 1.4s ease-in-out infinite 0.4s;
  }

  .theme-label {
    display: none;
    font-family: var(--font-body);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-main);
  }

  @media (min-width: 640px) {
    .theme-label {
      display: inline;
    }
  }

  @keyframes pulse {
    0%, 100% { opacity: 0.4; height: 3px; }
    50% { opacity: 1; height: 11px; }
  }
</style>
