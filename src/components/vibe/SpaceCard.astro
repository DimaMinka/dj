---
import { type SupportedLang, defaultLang, useTranslations } from '../../i18n/ui';
import { type Space, getSpaceGallery } from '../../data/spaces';
import LocalSocialProof from './LocalSocialProof.astro';

interface Props {
  space: Space;
  lang?: SupportedLang;
}

const { space, lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const gallery = getSpaceGallery(space);
---

<article
  class="space-card-container"
  data-space-slug={space.slug}
  data-space-id={space.id}
  style={`--vibe-color-light: ${space.glowColor}; --vibe-rgb-light: ${space.glowRgb}; --vibe-color-dark: ${space.glowColorDark}; --vibe-rgb-dark: ${space.glowRgbDark};`}
>
  <div class="art-book-card">
    <!-- Dedicated Glass Backdrop Plate with real-time blur -->
    <div class="card-glass-layer" aria-hidden="true"></div>

    <!-- 4 Ornamental Gold-accent Corner Brackets -->
    <div class="card-corner corner-tl" aria-hidden="true"></div>
    <div class="card-corner corner-tr" aria-hidden="true"></div>
    <div class="card-corner corner-bl" aria-hidden="true"></div>
    <div class="card-corner corner-br" aria-hidden="true"></div>

    <!-- Staged Content: emerges after blur establishes -->
    <div class="card-inner-content">
      <!-- Left Column: Curated Sound & Poetry (Default mobile card + desktop sound side) -->
      <div class="card-sound-col">
        <!-- Category Supertitle (e.g. — PRIVATE VILLA ATELIER —) -->
        <div class="supertitle-row">
          <span class="supertitle-text">
            {space.supertitle[lang] || space.supertitle.en}
          </span>
        </div>

        <!-- Main Headline with Elegant Serif + Italic Accent -->
        <h2 class="card-headline">
          <span class="headline-prefix">{space.headlinePrefix[lang] || space.headlinePrefix.en}</span>
          <span class="headline-accent">{space.headlineAccent[lang] || space.headlineAccent.en}</span>
        </h2>

        <!-- Poetic Editorial Subtext: Harmony of landscape & acoustics -->
        <p class="card-poetry">
          {space.poetry[lang] || space.poetry.en}
        </p>

        <!-- Desktop Telemetry Badges (BPM, Frequency, Key Signature, or custom tags) -->
        <div class="desktop-telemetry-row" aria-label="Acoustic specs">
          {space.tags && (space.tags[lang] || space.tags.en) ? (
            (space.tags[lang] || space.tags.en).map((tag) => (
              <div class="telemetry-pill">
                <span class="telemetry-val">{tag}</span>
              </div>
            ))
          ) : (
            <>
              <div class="telemetry-pill">
                <span class="material-symbols-outlined telemetry-icon" aria-hidden="true">graphic_eq</span>
                <span class="telemetry-val">{space.frequency} Hz</span>
              </div>
              <div class="telemetry-pill">
                <span class="material-symbols-outlined telemetry-icon" aria-hidden="true">speed</span>
                <span class="telemetry-val">{space.bpm} BPM</span>
              </div>
              <div class="telemetry-pill">
                <span class="material-symbols-outlined telemetry-icon" aria-hidden="true">music_note</span>
                <span class="telemetry-val">{space.keySignature}</span>
              </div>
            </>
          )}
        </div>

        <!-- Embedded Desktop Audio Player (Visible ONLY on >= 1024px) -->
        <div class="desktop-card-player" aria-label="Acoustic live preview">
          <div class="card-player-main">
            <button
              type="button"
              class="card-play-btn"
              data-card-play={space.slug}
              aria-label={`Play atmospheric live preview for ${space.title[lang] || space.title.en}`}
            >
              <span class="material-symbols-outlined card-play-icon" aria-hidden="true">play_arrow</span>
            </button>
            <div class="card-track-info">
              <span class="card-track-title">{typeof space.trackTitle === 'object' ? (space.trackTitle[lang] || space.trackTitle.en) : space.trackTitle}</span>
              <span class="card-track-sub">{typeof space.trackSubtitle === 'object' ? (space.trackSubtitle[lang] || space.trackSubtitle.en) : space.trackSubtitle}</span>
            </div>
          </div>
          <div class="card-player-equalizer" aria-hidden="true">
            <span class="card-wave-bar cbar-1"></span>
            <span class="card-wave-bar cbar-2"></span>
            <span class="card-wave-bar cbar-3"></span>
            <span class="card-wave-bar cbar-4"></span>
            <span class="card-wave-bar cbar-5"></span>
          </div>
        </div>

        <!-- Mobile Center Setup Pill Button (Hidden on Desktop >= 1024px) -->
        <div class="btn-wrap">
          <button
            type="button"
            class="setup-pill-btn group"
            data-trigger-setup={space.slug}
            aria-label={`Open technical and lighting setup for ${space.headerBadge}`}
          >
            <span class="pill-dot" aria-hidden="true"></span>
            <span class="pill-text">{t('experienceSetupBtn')}</span>
            <span class="material-symbols-outlined pill-arrow" aria-hidden="true">arrow_forward</span>
          </button>
        </div>

        <!-- Local Northern Social Proof Ticker (Desktop Sound Column - Absolute Bottom) -->
        <LocalSocialProof lang={lang} class="desktop-only-social-proof" />
      </div>

      <!-- Desktop Right Column: Direct Hardware Rig & Lighting Specs (Visible ONLY on >= 1024px) -->
      <div class="card-setup-col" aria-label="Integrated stage and lighting setup">
        <!-- Hardware Setup Visual Photograph -->
        <div class="desktop-setup-image-wrap">
          <div class="setup-loader-shimmer" aria-hidden="true"></div>
          <img
            src={space.bgWatercolorDesktop || space.bgWatercolor}
            alt={space.setup.name[lang] || space.setup.name.en}
            class="desktop-setup-img"
            loading="lazy"
          />
          <div class="desktop-setup-overlay"></div>
          <div class="desktop-setup-badge">
            <span class="material-symbols-outlined badge-icon" aria-hidden="true">verified</span>
            <span class="badge-text">{space.setup.name[lang] || space.setup.name.en}</span>
          </div>
        </div>

        <!-- 3 Structured Specification Interactive Tabs -->
        <div class="desktop-specs-list" role="tablist" aria-label="Specification categories">
          <button
            type="button"
            class="desktop-spec-item"
            role="tab"
            aria-selected="false"
            data-spec-tab="lights"
            data-tab-img={gallery.lights}
            data-tab-title={gallery.lightsTitle[lang] || gallery.lightsTitle.en}
          >
            <div class="desktop-spec-icon-box">
              <span class="material-symbols-outlined" aria-hidden="true">lightbulb</span>
            </div>
            <div class="desktop-spec-text">
              <span class="desktop-spec-label">{t('setupLights')}</span>
              <span class="desktop-spec-val">{typeof space.setup.lightsCount === 'object' ? (space.setup.lightsCount[lang] || space.setup.lightsCount.en) : space.setup.lightsCount}</span>
            </div>
          </button>

          <button
            type="button"
            class="desktop-spec-item"
            role="tab"
            aria-selected="false"
            data-spec-tab="sound"
            data-tab-img={gallery.sound}
            data-tab-title={gallery.soundTitle[lang] || gallery.soundTitle.en}
          >
            <div class="desktop-spec-icon-box">
              <span class="material-symbols-outlined" aria-hidden="true">speaker</span>
            </div>
            <div class="desktop-spec-text">
              <span class="desktop-spec-label">{t('setupSound')}</span>
              <span class="desktop-spec-val">{space.setup.soundType[lang] || space.setup.soundType.en}</span>
            </div>
          </button>

          <button
            type="button"
            class="desktop-spec-item is-selected"
            role="tab"
            aria-selected="true"
            data-spec-tab="location"
            data-tab-img={gallery.location}
            data-tab-title={gallery.locationTitle[lang] || gallery.locationTitle.en}
          >
            <div class="desktop-spec-icon-box">
              <span class="material-symbols-outlined" aria-hidden="true">groups</span>
            </div>
            <div class="desktop-spec-text">
              <span class="desktop-spec-label">{t('setupAudience')}</span>
              <span class="desktop-spec-val">{space.setup.idealFor[lang] || space.setup.idealFor.en}</span>
            </div>
          </button>
        </div>
      </div>
    </div>
  </div>
</article>

<script>
  function initCardTriggers() {
    // 1. Mobile Setup Drawer trigger
    const buttons = document.querySelectorAll('[data-trigger-setup]');
    buttons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const slug = (btn as HTMLElement).dataset.triggerSetup;
        window.dispatchEvent(
          new CustomEvent('dj:open-setup', {
            detail: { slug },
          })
        );
      });
    });

    // 2. Desktop Card Player trigger (dispatches global audio toggle so both dock & card stay synced)
    const cardPlayButtons = document.querySelectorAll('[data-card-play]');
    cardPlayButtons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        window.dispatchEvent(new CustomEvent('dj:toggle-audio'));
      });
    });

    // 3. Listen to audio state changes to update card play icon & equalizer
    window.addEventListener('dj:audio-state-change', ((e: CustomEvent) => {
      const isPlaying = Boolean(e.detail?.isPlaying);
      const icons = document.querySelectorAll('.card-play-icon');
      icons.forEach((icon) => {
        icon.textContent = isPlaying ? 'pause' : 'play_arrow';
      });
      const eqContainers = document.querySelectorAll('.card-player-equalizer');
      eqContainers.forEach((eq) => {
        eq.classList.toggle('is-playing', isPlaying);
      });
    }) as EventListener);

    // Dynamic wave animation for card equalizer
    setInterval(() => {
      const bars = document.querySelectorAll('.card-player-equalizer.is-playing .card-wave-bar');
      bars.forEach((bar) => {
        const h = Math.floor(Math.random() * 14) + 4;
        (bar as HTMLElement).style.height = `${h}px`;
      });
    }, 240);
    // 4. Desktop interactive specs tabs (switching setup image and badge)
    const specTabs = document.querySelectorAll('.desktop-spec-item');
    specTabs.forEach((tab) => {
      tab.addEventListener('click', (e) => {
        e.stopPropagation();
        const card = tab.closest('.card-setup-col');
        if (!card) return;

        const allTabs = card.querySelectorAll('.desktop-spec-item');
        allTabs.forEach((t) => {
          t.classList.remove('is-selected');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('is-selected');
        tab.setAttribute('aria-selected', 'true');

        const newImgSrc = (tab as HTMLElement).dataset.tabImg;
        const newTitle = (tab as HTMLElement).dataset.tabTitle;
        const img = card.querySelector('.desktop-setup-img') as HTMLImageElement | null;
        const shimmer = card.querySelector('.setup-loader-shimmer');
        const badgeText = card.querySelector('.badge-text');

        if (!img || !newImgSrc) return;
        if (img.src.includes(newImgSrc)) return;

        if (shimmer) shimmer.classList.add('is-active');
        img.classList.add('is-switching');

        const tempImg = new Image();
        tempImg.onload = () => {
          img.src = newImgSrc;
          if (badgeText && newTitle) badgeText.textContent = newTitle;
          img.classList.remove('is-switching');
          if (shimmer) shimmer.classList.remove('is-active');
        };
        tempImg.onerror = () => {
          img.classList.remove('is-switching');
          if (shimmer) shimmer.classList.remove('is-active');
        };
        tempImg.src = newImgSrc;
      });
    });
  }

  initCardTriggers();
</script>

<style>
  .space-card-container {
    --card-glow-color: var(--vibe-color-light);
    --card-glow-rgb: var(--vibe-rgb-light);
    position: relative;
    width: 100%;
    max-width: 350px;
    margin-inline: auto;
    padding-block: 0.5rem;
    box-sizing: border-box;
    user-select: none;
    -webkit-user-select: none;
    transition: --card-glow-color 0.4s ease;
  }

  :global(html[data-theme="night"]) .space-card-container,
  :global(html.dark) .space-card-container {
    --card-glow-color: var(--vibe-color-dark);
    --card-glow-rgb: var(--vibe-rgb-dark);
  }

  .art-book-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 1.65rem 1.35rem;
    border-radius: 28px;
    box-sizing: border-box;
  }

  /* Dedicated Glass Plate with Real-Time Backdrop Blur */
  .card-glass-layer {
    position: absolute;
    inset: 0;
    border-radius: 28px;
    background: rgba(255, 255, 255, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.65);
    backdrop-filter: blur(28px) saturate(180%);
    -webkit-backdrop-filter: blur(28px) saturate(180%);
    box-shadow: 0 10px 30px -5px rgba(180, 130, 90, 0.16), 
                0 4px 12px -2px rgba(180, 130, 90, 0.08),
                0 0 28px rgba(var(--card-glow-rgb), 0.14),
                inset 0 1px 1px rgba(255, 255, 255, 0.7);
    opacity: 0;
    transform: scale(0.98);
    transition: opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1), 
                transform 0.55s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.8s ease, 
                box-shadow 0.8s ease;
    pointer-events: none;
    z-index: 1;
  }

  :global(.carousel-card-slot.is-active) .card-glass-layer {
    opacity: 1;
    transform: scale(1);
  }

  /* Night Mode glass styling from Stitch */
  :global(html[data-theme="night"]) .card-glass-layer,
  :global(html.dark) .card-glass-layer {
    background: rgba(22, 18, 16, 0.42);
    border-color: rgba(255, 255, 255, 0.12);
    box-shadow: 0 12px 35px -5px rgba(0, 0, 0, 0.6), 
                0 4px 14px -2px rgba(0, 0, 0, 0.4),
                0 0 30px rgba(var(--card-glow-rgb), 0.2),
                inset 0 1px 1px rgba(255, 255, 255, 0.12);
  }

  @media (min-height: 750px) {
    .art-book-card {
      padding: 2rem 1.6rem;
    }
  }

  /* Staged Appearance: content emerges AFTER glass blur is established */
  .card-inner-content {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  :global(.carousel-card-slot.is-active) .card-inner-content {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.75s cubic-bezier(0.16, 1, 0.3, 1) 0.42s, 
                transform 0.75s cubic-bezier(0.16, 1, 0.3, 1) 0.42s;
  }

  /* 4 Ornamental Gold-accent Corner Brackets */
  .card-corner {
    position: absolute;
    width: 0.875rem;
    height: 0.875rem;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.22s, border-color 0.4s ease;
  }

  :global(.carousel-card-slot.is-active) .card-corner {
    opacity: 0.65;
  }

  .corner-tl {
    top: 0.75rem;
    left: 0.75rem;
    border-top: 1.5px solid var(--card-glow-color);
    border-left: 1.5px solid var(--card-glow-color);
  }

  .corner-tr {
    top: 0.75rem;
    right: 0.75rem;
    border-top: 1.5px solid var(--card-glow-color);
    border-right: 1.5px solid var(--card-glow-color);
  }

  .corner-bl {
    bottom: 0.75rem;
    left: 0.75rem;
    border-bottom: 1.5px solid var(--card-glow-color);
    border-left: 1.5px solid var(--card-glow-color);
  }

  .corner-br {
    bottom: 0.75rem;
    right: 0.75rem;
    border-bottom: 1.5px solid var(--card-glow-color);
    border-right: 1.5px solid var(--card-glow-color);
  }

  /* Category Supertitle */
  .supertitle-row {
    margin-block-end: 0.65rem;
  }

  .supertitle-text {
    font-family: var(--font-display);
    font-size: clamp(0.58rem, 2.4vw, 0.65625rem); /* ~9.5px - 10.5px */
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--card-glow-color);
    white-space: nowrap;
  }

  /* Main Headline with Serif + Italic Accent */
  .card-headline {
    font-family: var(--font-serif-art);
    font-size: clamp(1.85rem, 6vw, 2.15rem); /* ~31-35px */
    line-height: 1.18;
    font-weight: 400;
    letter-spacing: -0.01em;
    margin: 0;
    color: #211a16;
    transition: color 0.4s ease;
  }

  :global(html[data-theme="night"]) .card-headline,
  :global(html.dark) .card-headline {
    color: #f9f5f0;
  }

  .headline-prefix {
    display: block;
  }

  .headline-accent {
    display: block;
    font-style: italic;
    font-weight: 400;
    color: var(--card-glow-color);
    filter: drop-shadow(0 0 12px rgba(var(--card-glow-rgb), 0.25));
  }

  /* Poetic Editorial Subtext */
  .card-poetry {
    font-family: var(--font-grotesk);
    font-size: 0.8125rem; /* ~13px */
    line-height: 1.6;
    font-weight: 300;
    color: #68584f;
    max-width: 285px;
    margin: 0.85rem 0 0;
    transition: color 0.4s ease;
  }

  :global(html[data-theme="night"]) .card-poetry,
  :global(html.dark) .card-poetry {
    color: #c7b9b0;
  }

  /* Center Setup & Vintage Lighting Pill Button */
  .btn-wrap {
    margin-block-start: 1.25rem;
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .setup-pill-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding-inline: 1rem;
    padding-block: 0.55rem;
    border-radius: var(--radius-full);
    background: #f6eee5;
    border: 1px solid #e5d3c0;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    cursor: pointer;
    transition: var(--transition-theme), transform 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
  }

  :global(html[data-theme="night"]) .setup-pill-btn,
  :global(html.dark) .setup-pill-btn {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.12);
  }

  .setup-pill-btn:hover {
    background: #faefe2;
    border-color: var(--card-glow-color);
    transform: translateY(-1px);
  }

  :global(html[data-theme="night"]) .setup-pill-btn:hover,
  :global(html.dark) .setup-pill-btn:hover {
    background: rgba(255, 255, 255, 0.14);
    border-color: var(--card-glow-color);
  }

  .setup-pill-btn:active {
    transform: scale(0.96);
  }

  .pill-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: var(--radius-full);
    background: var(--card-glow-color);
    box-shadow: 0 0 6px var(--card-glow-color);
    transition: transform 0.2s ease;
  }

  .setup-pill-btn:hover .pill-dot {
    transform: scale(1.3);
  }

  .pill-text {
    font-family: var(--font-display);
    font-size: 0.6875rem; /* ~11px */
    font-weight: 500;
    letter-spacing: 0.04em;
    color: #4c3b31;
    white-space: nowrap;
    transition: color 0.3s ease;
  }

  :global(html[data-theme="night"]) .pill-text,
  :global(html.dark) .pill-text {
    color: #eedbce;
  }

  .pill-arrow {
    font-size: 0.875rem;
    color: var(--card-glow-color);
    transition: transform 0.2s ease;
  }

  :global([dir="rtl"]) .pill-arrow {
    transform: rotate(180deg);
  }

  .setup-pill-btn:hover .pill-arrow {
    transform: translateX(2px);
  }

  :global([dir="rtl"]) .setup-pill-btn:hover .pill-arrow {
    transform: translateX(-2px) rotate(180deg);
  }

  /* ========================================================
     DESKTOP EXPANDED SPLIT ART-BOOK STYLING (>= 1024px)
     Strictly isolated: mobile styles above remain untouched!
     ======================================================== */

  /* Default mobile state for newly added desktop elements */
  .desktop-telemetry-row {
    display: none;
  }

  .desktop-card-player {
    display: none;
  }

  :global(.desktop-only-social-proof) {
    display: none;
  }

  .card-setup-col {
    display: none;
  }

  .card-sound-col {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .space-card-container {
      max-width: 860px;
      padding-block: 0;
    }

    .art-book-card {
      padding: 2.2rem 2.4rem;
      border-radius: 32px;
      display: flex;
      flex-direction: column;
      height: 100%;
    }

    .card-glass-layer {
      border-radius: 32px;
    }

    /* Split-column Grid */
    .card-inner-content {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 2.5rem;
      align-items: stretch;
      text-align: start;
      flex: 1;
      width: 100%;
    }

    .card-sound-col {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-start;
      min-width: 0;
      height: 100%;
    }

    .supertitle-row {
      margin-block-end: 0.75rem;
    }

    .card-headline {
      font-size: 2.35rem;
      line-height: 1.15;
    }

    .card-poetry {
      max-width: 100%;
      margin: 1rem 0 0;
      font-size: 0.875rem;
      line-height: 1.65;
    }

    /* Hide the mobile setup pill button on desktop */
    .btn-wrap {
      display: none;
    }

    /* Desktop Telemetry Badges */
    .desktop-telemetry-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem;
      margin-block-start: 1.5rem;
    }

    .telemetry-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      padding: 0.35rem 0.75rem;
      border-radius: var(--radius-full);
      background: rgba(255, 255, 255, 0.45);
      border: 1px solid rgba(var(--card-glow-rgb), 0.25);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
    }

    :global(html[data-theme="night"]) .telemetry-pill,
    :global(html.dark) .telemetry-pill {
      background: rgba(255, 255, 255, 0.05);
      border-color: rgba(var(--card-glow-rgb), 0.3);
    }

    .telemetry-icon {
      font-size: 0.875rem;
      color: var(--card-glow-color);
    }

    .telemetry-val {
      font-family: var(--font-mono);
      font-size: 0.625rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      font-weight: 600;
      color: var(--color-text-main);
    }

    /* Embedded Desktop Card Audio Player */
    .desktop-card-player {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.85rem;
      width: 100%;
      margin-block-start: 1.25rem;
      padding: 0.65rem 0.85rem;
