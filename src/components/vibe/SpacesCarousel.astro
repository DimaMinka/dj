---
import { defaultLang, type SupportedLang, useTranslations } from '../../i18n/ui';
import type { Space } from '../../data/spaces';
import SpaceCard from './SpaceCard.astro';

interface Props {
  spaces: Space[];
  lang?: SupportedLang;
}

const { spaces, lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
---

<div class="carousel-wrapper" id="spacesCarouselWrapper">
  <!-- Desktop Left Navigation Arrow -->
  <button
    id="carouselPrevBtn"
    class="nav-arrow nav-arrow-prev"
    type="button"
    aria-label="Previous sound space"
  >
    <span class="material-symbols-outlined" aria-hidden="true">chevron_left</span>
  </button>

  <!-- Slider Viewport & Moving Track -->
  <div class="carousel-viewport" id="carouselViewport">
    <div class="carousel-track" id="carouselTrack">
      {spaces.map((space, index) => (
        <div class="carousel-slide" data-index={index}>
          <SpaceCard space={space} lang={lang} />
        </div>
      ))}
    </div>
  </div>

  <!-- Desktop Right Navigation Arrow -->
  <button
    id="carouselNextBtn"
    class="nav-arrow nav-arrow-next"
    type="button"
    aria-label="Next sound space"
  >
    <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
  </button>

  <!-- Pagination Dots & Mobile Swipe Indicator -->
  <div class="carousel-pagination" id="carouselPagination">
    <div class="dots-row" role="tablist" aria-label="Spaces pagination">
      {spaces.map((space, idx) => (
        <button
          type="button"
          role="tab"
          class={`pagination-dot ${idx === 0 ? 'is-active' : ''}`}
          data-dot-index={idx}
          aria-label={`Go to ${space.title[lang] || space.title.en}`}
          aria-selected={idx === 0 ? 'true' : 'false'}
          style={`--dot-color: ${space.glowColor};`}
        >
          <span class="dot-core"></span>
        </button>
      ))}
    </div>
    <div class="swipe-hint-pill">
      <span class="material-symbols-outlined swipe-icon" aria-hidden="true">swipe</span>
      <span class="swipe-hint-text">{t('swipeHint')}</span>
    </div>
  </div>
</div>

<script>
  import { spaces } from '../../data/spaces';

  function initSpacesCarousel() {
    const wrapper = document.getElementById('spacesCarouselWrapper');
    const viewport = document.getElementById('carouselViewport');
    const track = document.getElementById('carouselTrack');
    const prevBtn = document.getElementById('carouselPrevBtn');
    const nextBtn = document.getElementById('carouselNextBtn');
    const dots = document.querySelectorAll('.pagination-dot');
    if (!track || !viewport) return;

    let currentIndex = 0;
    const totalSlides = spaces.length;
    const isRtl = document.documentElement.getAttribute('dir') === 'rtl';

    // Touch / Pointer Gestures state
    let isDragging = false;
    let startX = 0;
    let currentX = 0;
    let dragOffset = 0;

    function emitSpaceChange(index: number) {
      const activeSpace = spaces[index];
      if (!activeSpace) return;

      window.dispatchEvent(
        new CustomEvent('dj:space-change', {
          detail: {
            index,
            slug: activeSpace.slug,
            glowColor: activeSpace.glowColor,
            glowRgb: activeSpace.glowRgb,
            title: activeSpace.title,
            bpm: activeSpace.bpm,
            frequency: activeSpace.frequency,
            setup: activeSpace.setup,
          },
        })
      );
    }

    function updateTrackPosition(animate = true) {
      if (animate) {
        track.style.transition = 'transform 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
      } else {
        track.style.transition = 'none';
      }

      const directionMultiplier = isRtl ? 1 : -1;
      const targetPercent = currentIndex * 100 * directionMultiplier;
      track.style.transform = `translate3d(calc(${targetPercent}% + ${dragOffset}px), 0, 0)`;

      // Update dots
      dots.forEach((dot, idx) => {
        const isActive = idx === currentIndex;
        dot.classList.toggle('is-active', isActive);
        dot.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });
    }

    let isTransitioningSlide = false;

    function goToIndex(index: number) {
      if (isTransitioningSlide) return;
      if (index < 0) index = 0;
      if (index >= totalSlides) index = totalSlides - 1;
      if (index === currentIndex) {
        dragOffset = 0;
        updateTrackPosition(true);
        return;
      }

      isTransitioningSlide = true;
      const targetIndex = index;

      // 1. PHASE 1: Gentle fade out of current card & unveil pure landscape
      viewport.classList.add('card-is-departing');
      window.dispatchEvent(
        new CustomEvent('dj:space-transitioning', { detail: { active: true } })
      );

      // 2. PHASE 2 (after 420ms): Swap background layer and glide to new slide
      setTimeout(() => {
        currentIndex = targetIndex;
        dragOffset = 0;
        emitSpaceChange(currentIndex);
        updateTrackPosition(false); // Move track while invisible

        // 3. PHASE 3 (after 360ms pause on pure background): Gently manifest the new card
        setTimeout(() => {
          viewport.classList.remove('card-is-departing');
          window.dispatchEvent(
            new CustomEvent('dj:space-transitioning', { detail: { active: false } })
          );
          setTimeout(() => {
            isTransitioningSlide = false;
          }, 550);
        }, 360);
      }, 420);
    }

    function nextSlide() {
      if (currentIndex < totalSlides - 1) {
        goToIndex(currentIndex + 1);
      } else {
        goToIndex(0); // loop
      }
    }

    function prevSlide() {
      if (currentIndex > 0) {
        goToIndex(currentIndex - 1);
      } else {
        goToIndex(totalSlides - 1); // loop
      }
    }

    // Dot navigation clicks
    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const idx = Number((dot as HTMLElement).dataset.dotIndex);
        if (!isNaN(idx)) goToIndex(idx);
      });
    });

    // Arrow navigation clicks
    prevBtn?.addEventListener('click', isRtl ? nextSlide : prevSlide);
    nextBtn?.addEventListener('click', isRtl ? prevSlide : nextSlide);

    // Keyboard navigation
    window.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') {
        isRtl ? prevSlide() : nextSlide();
      } else if (e.key === 'ArrowLeft') {
        isRtl ? nextSlide() : prevSlide();
      }
    });

    // Touch and Pointer gesture listeners (robust mobile swipe support)
    function startDrag(clientX: number) {
      isDragging = true;
      startX = clientX;
      currentX = clientX;
      dragOffset = 0;
      track.style.transition = 'none';
    }

    function moveDrag(clientX: number) {
      if (!isDragging) return;
      currentX = clientX;
      dragOffset = currentX - startX;

      // Elastic resistance at boundaries
      if (
        (currentIndex === 0 && (isRtl ? dragOffset < 0 : dragOffset > 0)) ||
        (currentIndex === totalSlides - 1 && (isRtl ? dragOffset > 0 : dragOffset < 0))
      ) {
        dragOffset *= 0.35;
      }

      updateTrackPosition(false);
    }

    function endDrag() {
      if (!isDragging) return;
      isDragging = false;

      const swipeThreshold = 35;
      const effectiveDrag = isRtl ? -dragOffset : dragOffset;

      if (effectiveDrag < -swipeThreshold) {
        nextSlide();
      } else if (effectiveDrag > swipeThreshold) {
        prevSlide();
      } else {
        dragOffset = 0;
        updateTrackPosition(true);
      }
    }

    // Pointer events (Desktop & Modern mobile)
    viewport.addEventListener('pointerdown', (e: PointerEvent) => {
      if ((e.target as HTMLElement).closest('button, a')) return;
      startDrag(e.clientX);
      try {
        viewport.setPointerCapture(e.pointerId);
      } catch (err) {}
    });

    viewport.addEventListener('pointermove', (e: PointerEvent) => {
      moveDrag(e.clientX);
    });

    const onPointerUp = (e: PointerEvent) => {
      try {
        viewport.releasePointerCapture(e.pointerId);
      } catch (err) {}
      endDrag();
    };

    viewport.addEventListener('pointerup', onPointerUp);
    viewport.addEventListener('pointercancel', onPointerUp);

    // Native Touch fallback for iOS Safari / Mobile webviews
    viewport.addEventListener('touchstart', (e: TouchEvent) => {
      if ((e.target as HTMLElement).closest('button, a')) return;
      if (e.touches.length === 1) {
        startDrag(e.touches[0].clientX);
      }
    }, { passive: true });

    viewport.addEventListener('touchmove', (e: TouchEvent) => {
      if (e.touches.length === 1) {
        moveDrag(e.touches[0].clientX);
      }
    }, { passive: true });

    viewport.addEventListener('touchend', () => {
      endDrag();
    }, { passive: true });

    viewport.addEventListener('touchcancel', () => {
      endDrag();
    }, { passive: true });

    // Initial event emission
    emitSpaceChange(0);
  }

  initSpacesCarousel();
</script>

<style>
  .carousel-wrapper {
    position: relative;
    z-index: 10;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin-block: auto;
    box-sizing: border-box;
  }

  .carousel-viewport {
    position: relative;
    width: 100%;
    overflow: hidden;
    touch-action: pan-y;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
    padding-block: 1.5rem;
    margin-block: -1.5rem;
  }

  .carousel-viewport:active {
    cursor: grabbing;
  }

  .carousel-track {
    display: flex;
    width: 100%;
    will-change: transform;
    align-items: center;
  }

  .carousel-slide {
    position: relative;
    flex: 0 0 100%;
    width: 100%;
    padding-inline: 1.25rem;
    padding-block: 0.5rem;
    box-sizing: border-box;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  /* Desktop Navigation Arrows */
  .nav-arrow {
    position: absolute;
    top: 45%;
    transform: translateY(-50%);
    z-index: 20;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-full);
    background: var(--color-surface-glass);
    border: 1px solid var(--color-glass-border);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    display: none;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
    cursor: pointer;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
    transition: var(--transition-theme), transform 0.2s ease, border-color 0.2s ease;
  }

  @media (min-width: 768px) {
    .nav-arrow {
      display: flex;
    }
  }

  .nav-arrow-prev {
    inset-inline-start: 1rem;
  }

  .nav-arrow-next {
    inset-inline-end: 1rem;
  }

  .nav-arrow:hover {
    border-color: var(--color-primary);
    transform: translateY(-50%) scale(1.08);
  }

  .nav-arrow:active {
    transform: translateY(-50%) scale(0.95);
  }

  /* Pagination & Hints */
  .carousel-pagination {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    margin-block-start: 0.75rem;
  }

  .dots-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .pagination-dot {
    position: relative;
    width: 1.5rem;
    height: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
  }

  .dot-core {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background: var(--color-text-subtle);
    opacity: 0.35;
    transition: all 0.35s cubic-bezier(0.2, 0.8, 0.4, 1);
  }

  .pagination-dot.is-active .dot-core {
    width: 1.5rem;
    background: var(--dot-color);
    opacity: 1;
    box-shadow: 0 0 10px var(--dot-color);
  }

  .swipe-hint-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
    opacity: 0.6;
  }

  @media (min-width: 768px) {
    .swipe-hint-pill {
      display: none;
    }
  }

  .swipe-icon {
    font-size: 0.8125rem;
    color: var(--color-primary);
  }
</style>
