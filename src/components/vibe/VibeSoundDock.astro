---
import { defaultLang, type SupportedLang, useTranslations } from '../../i18n/ui';
import { spaces } from '../../data/spaces';

interface Props {
  initialIndex?: number;
  lang?: SupportedLang;
}

const { initialIndex = 0, lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const initialSpace = spaces[initialIndex] || spaces[0];
---

<div
  class="sound-dock-wrapper"
  id="soundDockContainer"
  data-initial-slug={initialSpace.slug}
  style={`--player-color-light: ${initialSpace.glowColor}; --player-rgb-light: ${initialSpace.glowRgb}; --player-color-dark: ${initialSpace.glowColorDark}; --player-rgb-dark: ${initialSpace.glowRgbDark};`}
>
  <!-- Minimalist Live Audio Stream Bar from Stitch -->
  <div class="audio-stream-card">
    <div class="stream-telemetry">
      <button
        id="dockAudioToggle"
        class="play-circle-btn"
        type="button"
        aria-label="Play or pause atmospheric stream"
      >
        <span class="material-symbols-outlined play-icon" id="dockPlayIcon" aria-hidden="true">play_arrow</span>
      </button>

      <div class="stream-info">
        <span id="dockTrackTitle" class="stream-title">
          {initialSpace.trackTitle}
        </span>
        <span id="dockTrackSubtitle" class="stream-sub">
          {initialSpace.trackSubtitle}
        </span>
      </div>
    </div>

    <!-- 6-bar Colorful Audio Visualizer -->
    <div class="sound-equalizer" id="dockEqualizer" aria-hidden="true">
      <span class="wave-bar bar-1"></span>
      <span class="wave-bar bar-2"></span>
      <span class="wave-bar bar-3"></span>
      <span class="wave-bar bar-4"></span>
      <span class="wave-bar bar-5"></span>
      <span class="wave-bar bar-6"></span>
    </div>
  </div>

  <!-- Primary Art-Book Action: Stay in the Vibe Inline Form -->
  <div class="vibe-subscribe-dock" id="vibeSubscribeDock">
    <!-- Popover email input row (emerges above or within dock) -->
    <div class="vibe-input-bubble" id="vibeInputBubble" aria-hidden="true">
      <input
        type="email"
        id="vibeEmailInput"
        class="vibe-email-field"
        placeholder={t('vibeEmailPlaceholder')}
        autocomplete="email"
        inputmode="email"
        aria-label="Email for staying in the vibe"
      />
      <button
        type="button"
        id="vibeCloseInputBtn"
        class="vibe-cancel-btn"
        aria-label="Close input"
      >
        <span class="material-symbols-outlined" aria-hidden="true">close</span>
      </button>
    </div>

    <!-- Honeypot trap: hidden via dedicated CSS class, looks like normal form field to bots -->
    <textarea
      name="comments"
      id="vibeFormComments"
      class="form-field-comments"
      tabindex="-1"
      autocomplete="off"
      aria-hidden="true"
    ></textarea>

    <!-- Main action button -->
    <button
      id="dockMainCtaBtn"
      class="cta-location-btn"
      type="button"
      aria-label={t('stayInVibe')}
    >
      <span class="cta-dot" aria-hidden="true"></span>
      <span class="cta-text" id="dockCtaLabel">{t('stayInVibe')}</span>
      <span class="material-symbols-outlined cta-arrow" id="dockCtaIcon" aria-hidden="true">arrow_forward</span>
    </button>
  </div>
</div>

<script>
  import { spaces } from '../../data/spaces';

  function initSoundDock() {
    const titleEl = document.getElementById('dockTrackTitle');
    const subtitleEl = document.getElementById('dockTrackSubtitle');
    const playBtn = document.getElementById('dockAudioToggle');
    const playIcon = document.getElementById('dockPlayIcon');
    const ctaBtn = document.getElementById('dockMainCtaBtn');
    const eqBars = document.querySelectorAll('.wave-bar');

    const container = document.getElementById('soundDockContainer');
    let currentSlug = container?.dataset?.initialSlug || 'aegean';
    let isHarmonicActive = false;
    let audioCtx: AudioContext | null = null;
    let osc: OscillatorNode | null = null;
    let gainNode: GainNode | null = null;

    // Space change updates
    window.addEventListener('dj:space-change', ((e: CustomEvent) => {
      const { index, slug } = e.detail || {};
      if (typeof index === 'number' && spaces[index]) {
        const space = spaces[index];
        currentSlug = space.slug;
        if (titleEl) titleEl.textContent = space.trackTitle;
        if (subtitleEl) subtitleEl.textContent = space.trackSubtitle;

        // Dynamically tint player button, equalizer and CTA to active vibe color
        if (container) {
          container.style.setProperty('--player-color-light', space.glowColor);
          container.style.setProperty('--player-rgb-light', space.glowRgb);
          container.style.setProperty('--player-color-dark', space.glowColorDark);
          container.style.setProperty('--player-rgb-dark', space.glowRgbDark);
        }
      }
    }) as EventListener);

    // Web Audio Harmonic Ambient Synthesizer
    function toggleAmbientSound() {
      try {
        const AudioContextClass = window.AudioContext || (window as any).webkitAudioContext;
        if (!audioCtx) {
          audioCtx = new AudioContextClass();
        }

        if (isHarmonicActive) {
          if (gainNode && audioCtx) {
            gainNode.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + 0.4);
            setTimeout(() => {
              osc?.stop();
              osc?.disconnect();
              osc = null;
            }, 400);
          }
          isHarmonicActive = false;
          if (playIcon) playIcon.textContent = 'play_arrow';
          window.dispatchEvent(new CustomEvent('dj:audio-state-change', { detail: { isPlaying: false } }));
        } else {
          if (audioCtx.state === 'suspended') {
            audioCtx.resume();
          }

          osc = audioCtx.createOscillator();
          gainNode = audioCtx.createGain();

          osc.type = 'sine';
          osc.frequency.setValueAtTime(432, audioCtx.currentTime);

          gainNode.gain.setValueAtTime(0.0001, audioCtx.currentTime);
          gainNode.gain.exponentialRampToValueAtTime(0.06, audioCtx.currentTime + 0.6);

          osc.connect(gainNode);
          gainNode.connect(audioCtx.destination);

          osc.start();
          isHarmonicActive = true;
          if (playIcon) playIcon.textContent = 'pause';
          window.dispatchEvent(new CustomEvent('dj:audio-state-change', { detail: { isPlaying: true } }));
        }
      } catch (e) {
        console.warn('Dock sound error:', e);
      }
    }

    playBtn?.addEventListener('click', toggleAmbientSound);

    // Global audio toggle event from card player
    window.addEventListener('dj:toggle-audio', (() => {
      toggleAmbientSound();
    }) as EventListener);

    // Dynamic wave animation
    setInterval(() => {
      eqBars.forEach((bar) => {
        const h = Math.floor(Math.random() * 16) + 4;
        (bar as HTMLElement).style.height = `${h}px`;
      });
    }, 240);

    // --- Inline Stay in the Vibe Form Logic ---
    const subscribeDock = document.getElementById('vibeSubscribeDock');
    const inputBubble = document.getElementById('vibeInputBubble');
    const emailInput = document.getElementById('vibeEmailInput') as HTMLInputElement | null;
    const commentsInput = document.getElementById('vibeFormComments') as HTMLTextAreaElement | null;
    const closeInputBtn = document.getElementById('vibeCloseInputBtn');
    const ctaLabel = document.getElementById('dockCtaLabel');
    const ctaIcon = document.getElementById('dockCtaIcon');

    let isFormOpen = false;
    let isSubmitting = false;

    const defaultLabelText = ctaLabel?.textContent || 'Stay in the Vibe';

    function openForm() {
      if (isFormOpen || isSubmitting) return;
      isFormOpen = true;
      subscribeDock?.classList.add('is-open');
      inputBubble?.setAttribute('aria-hidden', 'false');
      if (ctaLabel) ctaLabel.textContent = 'Send';
      if (ctaIcon) ctaIcon.textContent = 'send';
      ctaBtn?.setAttribute('aria-label', 'Submit email');
      setTimeout(() => emailInput?.focus(), 120);
    }

    function closeForm() {
      if (isSubmitting) return;
      isFormOpen = false;
      subscribeDock?.classList.remove('is-open');
      inputBubble?.setAttribute('aria-hidden', 'true');
      if (ctaLabel) ctaLabel.textContent = defaultLabelText;
      if (ctaIcon) ctaIcon.textContent = 'arrow_forward';
      ctaBtn?.setAttribute('aria-label', defaultLabelText);
      ctaBtn?.removeAttribute('disabled');
      if (emailInput) {
        emailInput.value = '';
        emailInput.classList.remove('has-error');
      }
    }

    async function handleSubscribe() {
      // Double-click lock guard
      if (isSubmitting) return;

      if (!isFormOpen) {
        openForm();
        return;
      }

      const rawEmail = emailInput?.value?.trim() || '';
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

      if (!rawEmail || !emailRegex.test(rawEmail)) {
        emailInput?.classList.add('has-error');
        emailInput?.focus();
        return;
      }

      emailInput?.classList.remove('has-error');

      // Lock button to prevent double-click
      isSubmitting = true;
      ctaBtn?.setAttribute('disabled', 'true');
      ctaBtn?.classList.add('is-loading');
      if (ctaLabel) ctaLabel.textContent = 'Connecting...';
      if (ctaIcon) ctaIcon.textContent = 'hourglass_top';

      try {
        // Dynamic import of astro:actions
        const { actions } = await import('astro:actions');
        
        // Pass honeypot comments value
        const botTrap = commentsInput?.value || '';

        await actions.subscribe({
          email: rawEmail,
          source: `vibe-${currentSlug}`,
          comments: botTrap,
        });

        // Success state
        if (ctaLabel) ctaLabel.textContent = 'In the vibe ✨';
        if (ctaIcon) ctaIcon.textContent = 'done';
        subscribeDock?.classList.add('is-success');

        // Clean up and close after 2.4s
        setTimeout(() => {
          isSubmitting = false;
          subscribeDock?.classList.remove('is-success', 'is-loading');
          closeForm();
        }, 2400);

      } catch (err) {
        console.error('Subscription error:', err);
        if (ctaLabel) ctaLabel.textContent = 'Try again';
        if (ctaIcon) ctaIcon.textContent = 'refresh';
        isSubmitting = false;
        ctaBtn?.removeAttribute('disabled');
        ctaBtn?.classList.remove('is-loading');
      }
    }

    ctaBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      handleSubscribe();
    });

    closeInputBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      closeForm();
    });

    emailInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        handleSubscribe();
      } else if (e.key === 'Escape') {
        e.preventDefault();
        closeForm();
      }
    });
  }

  initSoundDock();
</script>

<style>
  .sound-dock-wrapper {
    --player-color: var(--player-color-light);
    --player-rgb: var(--player-rgb-light);
    position: relative;
    z-index: 20;
    width: 100%;
    max-width: 420px;
    margin-inline: auto;
    padding-inline: 1.25rem;
    padding-block-end: 0.5rem;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    flex-shrink: 0;
  }

  @media (min-width: 1024px) {
    .sound-dock-wrapper {
      max-width: 480px;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding-block-end: 0.85rem;
    }

    /* On desktop (>=1024px), audio stream is now integrated directly inside the card */
    .audio-stream-card {
      display: none;
    }

    .cta-location-btn {
      width: 100%;
      max-width: 420px;
      padding-block: 0.85rem;
      padding-inline: 1.85rem;
    }
  }

  @media (min-width: 1280px) {
    .sound-dock-wrapper {
      max-width: 520px;
    }

    .cta-location-btn {
      max-width: 440px;
    }
  }

  :global(html[data-theme="night"]) .sound-dock-wrapper,
  :global(html.dark) .sound-dock-wrapper {
    --player-color: var(--player-color-dark);
    --player-rgb: var(--player-rgb-dark);
  }

  .audio-stream-card {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: 100%;
    padding: 0.55rem 0.75rem;
    border-radius: var(--radius-xl);
    background: rgba(255, 255, 255, 0.85);
    border: 1px solid rgba(141, 75, 0, 0.16);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.06);
    box-sizing: border-box;
    transition: var(--transition-theme);
  }

  @media (min-width: 1024px) {
    .audio-stream-card {
      display: none !important;
    }
  }

  :global(html[data-theme="night"]) .audio-stream-card,
  :global(html.dark) .audio-stream-card {
    background: rgba(32, 26, 23, 0.9);
    border-color: rgba(255, 255, 255, 0.1);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.45);
  }

  .stream-telemetry {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    min-width: 0;
    flex: 1;
  }

  .play-circle-btn {
    width: 2.65rem;
    height: 2.65rem;
    flex-shrink: 0;
    border-radius: var(--radius-full);
    background: var(--player-color, var(--color-primary));
    border: none;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(var(--player-rgb, 217, 119, 6), 0.38);
    transition: transform 0.2s ease, background-color 0.4s ease, box-shadow 0.4s ease;
  }

  .play-circle-btn:hover {
    transform: scale(1.05);
    filter: brightness(1.1);
  }

  .play-circle-btn:active {
    transform: scale(0.94);
  }

  .play-icon {
    font-size: 1.4rem;
    margin-inline-start: 2px;
    font-variation-settings: 'FILL' 1;
  }

  .stream-info {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .stream-title {
    font-family: var(--font-display);
    font-size: 0.8125rem; /* ~13px */
    font-weight: 700;
    letter-spacing: -0.01em;
    color: #2a221d;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(html[data-theme="night"]) .stream-title,
  :global(html.dark) .stream-title {
    color: #f8f5f2;
  }

  .stream-sub {
    font-family: var(--font-body);
    font-size: 0.65625rem; /* ~10.5px */
    color: #7d6c62;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-block-start: 0.1rem;
  }

  :global(html[data-theme="night"]) .stream-sub,
  :global(html.dark) .stream-sub {
    color: #b4a499;
  }

  .sound-equalizer {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 1.35rem;
    padding-inline: 0.35rem;
    flex-shrink: 0;
  }

  .wave-bar {
    width: 2.5px;
    height: 6px;
    border-radius: var(--radius-full);
    background: var(--player-color, var(--color-primary));
    opacity: 0.85;
    transition: height 0.24s ease, background-color 0.4s ease;
  }

  .bar-2, .bar-4 {
    opacity: 1;
  }

  .bar-6 {
    opacity: 0.9;
  }

  /* Honeypot field - normal-looking class, clipped out of sight, no inline styles */
  .form-field-comments {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
    opacity: 0;
    pointer-events: none;
    z-index: -10;
  }

  /* Inline Vibe Subscribe Dock */
  .vibe-subscribe-dock {
    position: relative;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Popover Bubble above CTA button */
  .vibe-input-bubble {
    position: absolute;
    bottom: calc(100% + 0.5rem);
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.5rem 0.35rem 0.85rem;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.94);
    border: 1px solid rgba(var(--player-rgb, 217, 119, 6), 0.35);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12), 0 0 20px rgba(var(--player-rgb, 217, 119, 6), 0.15);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    opacity: 0;
    pointer-events: none;
    transform: translateY(8px) scale(0.96);
    transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1), transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 10;
  }

  :global(html[data-theme="night"]) .vibe-input-bubble,
  :global(html.dark) .vibe-input-bubble {
    background: rgba(28, 22, 19, 0.94);
    border-color: rgba(var(--player-rgb, 255, 198, 101), 0.35);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.5), 0 0 25px rgba(var(--player-rgb, 229, 169, 60), 0.2);
  }

  .vibe-subscribe-dock.is-open .vibe-input-bubble {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0) scale(1);
  }

  .vibe-email-field {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: none;
    outline: none;
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--color-text-main);
    padding-block: 0.25rem;
  }

  .vibe-email-field::placeholder {
    color: var(--color-text-muted);
    opacity: 0.7;
  }

  .vibe-email-field.has-error {
    color: #ef4444;
  }

  .vibe-cancel-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: var(--radius-full);
    border: none;
    background: rgba(0, 0, 0, 0.05);
    color: var(--color-text-muted);
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s;
  }

  :global(html[data-theme="night"]) .vibe-cancel-btn,
  :global(html.dark) .vibe-cancel-btn {
    background: rgba(255, 255, 255, 0.08);
  }

  .vibe-cancel-btn:hover {
    color: var(--color-text-main);
    background: rgba(0, 0, 0, 0.1);
  }

  .vibe-cancel-btn span {
    font-size: 1rem;
  }

  /* Elegant Art-Book CTA Button Link */
  .cta-location-btn {
    width: 100%;
    padding-block: 0.75rem;
    padding-inline: 1.25rem;
    border-radius: var(--radius-full);
    background: rgba(245, 237, 227, 0.92);
    border: 1px solid rgba(var(--player-rgb, 217, 119, 6), 0.35);
    color: #3b2c22;
    text-decoration: none;
    box-shadow: 0 4px 16px rgba(180, 130, 90, 0.12), 0 0 20px rgba(var(--player-rgb, 217, 119, 6), 0.12);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
    box-sizing: border-box;
    transition: var(--transition-theme), transform 0.2s ease, border-color 0.4s ease, box-shadow 0.4s ease, background-color 0.25s ease;
  }

  .cta-location-btn:disabled,
  .cta-location-btn.is-loading {
    opacity: 0.75;
    cursor: not-allowed;
    pointer-events: none;
  }

  :global(html[data-theme="night"]) .cta-location-btn,
  :global(html.dark) .cta-location-btn {
    background: rgba(36, 29, 25, 0.88);
    border-color: rgba(var(--player-rgb, 255, 198, 101), 0.35);
    color: #f7eee4;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4), 0 0 25px rgba(var(--player-rgb, 229, 169, 60), 0.18);
  }

  .cta-location-btn:hover {
    background: #faefe1;
    border-color: var(--player-color, var(--color-primary));
    box-shadow: 0 8px 24px rgba(var(--player-rgb, 217, 119, 6), 0.25), 0 0 24px rgba(var(--player-rgb, 217, 119, 6), 0.22);
    transform: translateY(-1px);
  }

  :global(html[data-theme="night"]) .cta-location-btn:hover,
  :global(html.dark) .cta-location-btn:hover {
    background: rgba(48, 38, 33, 0.95);
    border-color: var(--player-color, var(--color-primary));
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.5), 0 0 30px rgba(var(--player-rgb, 229, 169, 60), 0.28);
  }

  .cta-location-btn:active {
    transform: scale(0.98);
  }

  .cta-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: var(--radius-full);
    background: var(--player-color, var(--color-primary));
    box-shadow: 0 0 8px var(--player-color, var(--color-primary));
    flex-shrink: 0;
    transition: transform 0.2s ease, background-color 0.4s ease, box-shadow 0.4s ease;
  }

  .cta-location-btn:hover .cta-dot {
    transform: scale(1.25);
  }

  .cta-text {
    font-family: var(--font-serif-art);
    font-size: 1.0625rem; /* ~17px */
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .cta-arrow {
    font-size: 1rem;
    color: var(--player-color, var(--color-primary));
    transition: transform 0.2s ease, color 0.4s ease;
    flex-shrink: 0;
  }

  :global([dir="rtl"]) .cta-arrow {
    transform: rotate(180deg);
  }

  .cta-location-btn:hover .cta-arrow {
    transform: translateX(3px);
  }

  :global([dir="rtl"]) .cta-location-btn:hover .cta-arrow {
    transform: translateX(-3px) rotate(180deg);
  }
</style>
