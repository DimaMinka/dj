---
// Multi-layered visual background with Day / Night crossfade and floating luminous dust
---

<div class="atmosphere-canvas" aria-hidden="true">
  <!-- Night Background Layer -->
  <div class="bg-layer night-layer">
    <div class="bg-image night-image"></div>
    <div class="overlay-vignette night-vignette"></div>
    <div class="radial-amber"></div>
    <div class="radial-purple"></div>
  </div>

  <!-- Day Background Layer -->
  <div class="bg-layer day-layer">
    <div class="bg-image day-image"></div>
    <div class="overlay-vignette day-vignette"></div>
    <div class="radial-sun"></div>
  </div>

  <!-- Floating Light Dust / Embers -->
  <div class="dust-particle dust-1 animate-float-dust"></div>
  <div class="dust-particle dust-2 animate-float-dust"></div>
  <div class="dust-particle dust-3 animate-float-dust"></div>
  <div class="dust-particle dust-4 animate-float-dust"></div>
</div>

<style>
  .atmosphere-canvas {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .bg-layer {
    position: absolute;
    inset: 0;
    transition: opacity 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Night Layer Styles */
  .night-layer {
    opacity: 1;
  }

  .night-image {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-image: url('https://lh3.googleusercontent.com/aida/AEtjO1Vc5MwGM-ojIZq93mrmmXmxycwGbj6ENPwUkBksjeSLLdUpeJ3V2OuLwt0nNGqyfCg1dNFCahahsP1rQEaud6csAlJoeTzDRHD2Gp0BmDneVNUUAp7-XMolBoy81JXK70ccA4s0HLBYa_pZSGOLuqzE6v9CDzoc5LuJiV6P0uW5iwfWGoR2fWveQfmKeGTesTHwNhlaqsLNQ6lEWoBuUeNaDmWHaqYjPnGkoMmA3m_0P7KvQc7BWkFXmpG9');
    transform: scale(1.05);
    filter: brightness(0.7) contrast(1.1) saturate(0.85);
  }

  .night-vignette {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, #09090b 0%, rgba(9, 9, 11, 0.65) 50%, rgba(9, 9, 11, 0.85) 100%);
  }

  .radial-amber {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 40%, rgba(229, 169, 60, 0.18), transparent 65%);
  }

  .radial-purple {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 35%, rgba(168, 85, 247, 0.14), transparent 60%);
  }

  /* Day Layer Styles */
  .day-layer {
    opacity: 0;
  }

  .day-image {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuCIwms31ea-wosqLjFfCbwstlRD6f23IhD70o84FkSKiOrDWT29mxHKJeZ9OpOb-WKfZ-8F4ckzwHZcQr06SErTwbcf8mL-2ZIbQn4cB8l1BQNhJljpMPhBL0Du7AmO4o3a9YmmWBh3Lhl4oA7FiQR7Kczo5BFNbLxxFhjZF-oFIEKu5NRRIlVrq7ISxcB0iCLYejXDig7EJ60DcOLtqF-Z3q76Nfk_LyBWyGeztpWE4o406zcz5eg2Mg');
    transform: scale(1.05);
    filter: brightness(0.95) contrast(1.05) saturate(0.9);
    opacity: 0.25;
  }

  .day-vignette {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(252, 248, 251, 0.85) 0%, rgba(252, 248, 251, 0.65) 50%, rgba(252, 248, 251, 0.95) 100%);
  }

  .radial-sun {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 35%, rgba(217, 119, 6, 0.12), transparent 65%);
  }

  /* Theme-driven visibility */
  :global(html[data-theme="day"]:not(.dark)) .night-layer {
    opacity: 0;
  }

  :global(html[data-theme="day"]:not(.dark)) .day-layer {
    opacity: 1;
  }

  /* Floating Dust Particles */
  .dust-particle {
    position: absolute;
    border-radius: var(--radius-full);
    pointer-events: none;
    transition: background-color 0.5s ease;
  }

  .dust-1 {
    top: 25%;
    left: 20%;
    width: 6px;
    height: 6px;
    background: var(--color-primary);
    opacity: 0.4;
    filter: blur(1px);
    animation-delay: 0s;
  }

  .dust-2 {
    top: 35%;
    right: 25%;
    width: 8px;
    height: 8px;
    background: var(--color-resonance);
    opacity: 0.35;
    filter: blur(1.5px);
    animation-delay: 2s;
  }

  .dust-3 {
    bottom: 30%;
    left: 35%;
    width: 5px;
    height: 5px;
    background: var(--color-primary);
    opacity: 0.3;
    filter: blur(0.8px);
    animation-delay: 3.5s;
  }

  .dust-4 {
    top: 50%;
    right: 18%;
    width: 7px;
    height: 7px;
    background: var(--color-secondary);
    opacity: 0.35;
    filter: blur(1.2px);
    animation-delay: 1s;
  }
</style>
