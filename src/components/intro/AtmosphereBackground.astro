---
// Multi-layered visual background with Day / Night crossfade and floating luminous dust
---

<div class="atmosphere-canvas" aria-hidden="true">
  <!-- Shared Photographic / Watercolor Artwork -->
  <div class="bg-image"></div>

  <!-- Single Dedicated Blur Layer: Never duplicates, never pops or jumps -->
  <div class="overlay-blur"></div>

  <!-- Night Atmosphere Vignette & Radials -->
  <div class="atmosphere-overlay night-overlay">
    <div class="night-vignette"></div>
    <div class="radial-amber"></div>
    <div class="radial-purple"></div>
  </div>

  <!-- Day Atmosphere Vignette & Radial -->
  <div class="atmosphere-overlay day-overlay">
    <div class="day-vignette"></div>
    <div class="radial-sun"></div>
  </div>

  <!-- Floating Light Dust / Embers -->
  <div class="dust-particle dust-1 animate-float-dust"></div>
  <div class="dust-particle dust-2 animate-float-dust"></div>
  <div class="dust-particle dust-3 animate-float-dust"></div>
  <div class="dust-particle dust-4 animate-float-dust"></div>
</div>

<style>
  .atmosphere-canvas {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  /* 1. Base Shared Image (single element, zero duplication) */
  .bg-image {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-image: url("/assets/spaces/aegean-bg.jpg");
    transform: scale(1.05);
    filter: brightness(0.7) contrast(1.1) saturate(0.85);
    opacity: 1;
    transition: filter 0.5s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  @media (min-width: 1024px) {
    .bg-image {
      background-image: url("/assets/spaces/aegean-bg-desktop.jpg");
      background-position: center 40%;
    }
  }

  :global(html[data-theme="day"]:not(.dark)) .bg-image {
    filter: brightness(0.88) contrast(1.02) saturate(0.85);
    opacity: 0.35;
  }

  /* 2. Single Static Blur Overlay (zero flicker, zero stacking duplication) */
  .overlay-blur {
    position: absolute;
    inset: 0;
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    pointer-events: none;
    z-index: 1;
  }

  /* 3. Theme Overlays: synchronized with 0.5s theme transition */
  .atmosphere-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    transition: opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
  }

  .night-overlay {
    opacity: 1;
  }

  .day-overlay {
    opacity: 0;
  }

  :global(html[data-theme="day"]:not(.dark)) .night-overlay {
    opacity: 0;
  }

  :global(html[data-theme="day"]:not(.dark)) .day-overlay {
    opacity: 1;
  }

  /* Night Vignette & Radials */
  .night-vignette {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      #09090b 0%,
      rgba(9, 9, 11, 0.65) 50%,
      rgba(9, 9, 11, 0.85) 100%
    );
  }

  .radial-amber {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 50% 40%,
      rgba(229, 169, 60, 0.18),
      transparent 65%
    );
  }

  .radial-purple {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 50% 35%,
      rgba(168, 85, 247, 0.14),
      transparent 60%
    );
  }

  /* Day Vignette & Radial */
  .day-vignette {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(244, 238, 241, 0.65) 0%,
      rgba(238, 231, 235, 0.35) 50%,
      rgba(243, 236, 240, 0.75) 100%
    );
  }

  .radial-sun {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 50% 35%,
      rgba(146, 64, 14, 0.11),
      transparent 65%
    );
  }

  /* Floating Dust Particles */
  .dust-particle {
    position: absolute;
    z-index: 3;
    border-radius: var(--radius-full);
    pointer-events: none;
    transition: background-color 0.5s ease;
  }

  .dust-1 {
    top: 25%;
    left: 20%;
    width: 6px;
    height: 6px;
    background: var(--color-primary);
    opacity: 0.4;
    filter: blur(1px);
    animation-delay: 0s;
  }

  .dust-2 {
    top: 35%;
    right: 25%;
    width: 8px;
    height: 8px;
    background: var(--color-resonance);
    opacity: 0.35;
    filter: blur(1.5px);
    animation-delay: 2s;
  }

  .dust-3 {
    bottom: 30%;
    left: 35%;
    width: 5px;
    height: 5px;
    background: var(--color-primary);
    opacity: 0.3;
    filter: blur(0.8px);
    animation-delay: 3.5s;
  }

  .dust-4 {
    top: 50%;
    right: 18%;
    width: 7px;
    height: 7px;
    background: var(--color-secondary);
    opacity: 0.35;
    filter: blur(1.2px);
    animation-delay: 1s;
  }
</style>
