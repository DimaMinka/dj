---
import Layout from '../layouts/Layout.astro';
import AtmosphereBackground from '../components/intro/AtmosphereBackground.astro';
import SiteHeader from '../components/common/SiteHeader.astro';
import SonicPortal from '../components/intro/SonicPortal.astro';
import GatewayTrigger from '../components/intro/GatewayTrigger.astro';
import { defaultLang, useTranslations } from '../i18n/ui';

const t = useTranslations(defaultLang);
const pageDescription = t('heroManifesto');
---

<Layout
  title="DJ Dima Minka — Immersion Into Frequency"
  description={pageDescription}
  lang={defaultLang}
>
  <main class="intro-viewport pt-safe pb-safe">
    <!-- Atmosphere Depth Canvas (Day / Night Crossfade) -->
    <AtmosphereBackground />

    <!-- Top Navigation & Resonance Switcher -->
    <SiteHeader lang={defaultLang} currentSection="intro" />

    <!-- Central Sensory Portal 432 Hz -->
    <SonicPortal lang={defaultLang} />

    <!-- Tactile Gateway Entry -->
    <GatewayTrigger lang={defaultLang} />
  </main>
</Layout>

<style>
  .intro-viewport {
    position: relative;
    width: 100%;
    height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    box-sizing: border-box;
  }
</style>
