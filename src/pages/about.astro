---
import Layout from '../layouts/Layout.astro';
import IntroHeader from '../components/intro/IntroHeader.astro';
import AtmosphereBackground from '../components/intro/AtmosphereBackground.astro';
import { defaultLang } from '../i18n/ui';
---

<Layout title="About — DJ Dima Minka" lang={defaultLang}>
  <main class="about-viewport pt-safe pb-safe">
    <AtmosphereBackground />
    <IntroHeader lang={defaultLang} />

    <section class="about-content">
      <h1 class="hello-title">Hello World</h1>
    </section>
  </main>
</Layout>

<style>
  .about-viewport {
    position: relative;
    width: 100%;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    overflow: hidden;
  }

  .about-content {
    position: relative;
    z-index: 10;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }

  .hello-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 4rem);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-main);
  }
</style>
