---
import '../styles/tokens.css';
import { defaultLang, languages, type SupportedLang } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  lang?: SupportedLang;
}

const {
  title = "DJ Dima Minka — Site-Specific Sound & Light Architecture",
  description = "Melodic House & Techno curations tailored strictly to unique natural and architectural wonders.",
  lang = defaultLang,
} = Astro.props;

const dir = languages[lang]?.dir || 'ltr';
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Google Fonts Preconnect & Load: Cormorant Garamond, Syne, Space Grotesk, Manrope, JetBrains Mono + Heebo -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,400;1,600&family=Heebo:wght@300;400;500;700&family=JetBrains+Mono:wght@400;500;700&family=Manrope:wght@300;400;500;600;700&family=Space+Grotesk:wght@300;400;500;600;700&family=Syne:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <!-- Material Symbols Outlined -->
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"
      rel="stylesheet"
    />

    <!-- ZERO-FOUC & SYSTEM THEME DETECTION (Canonical Astro inline script) -->
    <script is:inline>
      (function () {
        const getPreferredTheme = () => {
          try {
            const saved = localStorage.getItem('dj-theme-resonance');
            if (saved === 'day' || saved === 'night') return saved;
          } catch (e) {}
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'night' : 'day';
        };

        const theme = getPreferredTheme();
        document.documentElement.setAttribute('data-theme', theme);
        document.documentElement.classList.toggle('dark', theme === 'night');

        // Reactive system theme watcher (when user hasn't explicitly set a preference)
        try {
          const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
          mediaQuery.addEventListener('change', (e) => {
            const saved = localStorage.getItem('dj-theme-resonance');
            if (!saved) {
              const newTheme = e.matches ? 'night' : 'day';
              document.documentElement.setAttribute('data-theme', newTheme);
              document.documentElement.classList.toggle('dark', newTheme === 'night');
              window.dispatchEvent(new CustomEvent('dj:theme-change', { detail: { theme: newTheme } }));
            }
          });
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  /* Safe-area insets for mobile */
  .pt-safe {
    padding-top: calc(env(safe-area-inset-top, 0px) + 0.5rem);
  }
  .pb-safe {
    padding-bottom: calc(env(safe-area-inset-bottom, 0px) + 0.75rem);
  }
  ::-webkit-scrollbar {
    display: none;
  }
</style>
