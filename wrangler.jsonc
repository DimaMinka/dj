{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "dj",
	"compatibility_date": "2026-10-06",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"routes": [
		{
			"pattern": "dj.dimaminka.com",
			"custom_domain": true
		}
	],
	"send_email": [
		{
			"name": "SEND_EMAIL"
		}
	],
	"kv_namespaces": [
		{
			"binding": "QUOTES_KV",
			"id": "2f2054a83e8541139744d91fceded901",
			"preview_id": "b04d161925224686965bc831882080a4"
		}
	],
	"observability": {
		"enabled": true
	}
}