{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "dj",
	"compatibility_date": "2026-10-06",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"routes": [
		{
			"pattern": "dj.dimaminka.com",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": true
	}
}